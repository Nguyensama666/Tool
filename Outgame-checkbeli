local WEBHOOK_URL = "https://discord.com/api/webhooks/1262811878539923557/ewj9wKs8KbEk4R58GaCFKbZwow84BuyFrzVpVTd7sCEWobOevB6UW3hHahZUgxhQZUhl"
local TOTAL_TIME = 90
local MIN_BELI = 500000 -- Mốc 500k Beli

local HttpService = game:GetService("HttpService")
local Players = game:GetService("Players")
local CoreGui = game:GetService("CoreGui")
local LocalPlayer = Players.LocalPlayer

-- Gửi Webhook Discord
local function sendDiscordWebhook(title, desc, color)
    task.spawn(function()
        pcall(function()
            local embedData = {
                ["title"] = title, ["description"] = desc, ["color"] = color or 65280,
                ["footer"] = { ["text"] = "Auto Shutdown & Beli Monitor" },
                ["timestamp"] = DateTime.now():ToIsoDate()
            }
            local payload = HttpService:JSONEncode({["username"] = "Bot", ["embeds"] = { embedData }})
            local httpRequest = (syn and syn.request) or (http and http.request) or http_request or request
            if httpRequest then
                httpRequest({Url = WEBHOOK_URL, Method = "POST", Headers = {["Content-Type"] = "application/json"}, Body = payload})
            else
                HttpService:PostAsync(WEBHOOK_URL, payload, Enum.HttpContentType.ApplicationJson)
            end
        end)
    end)
end

-- Hàm định dạng số Beli cho dễ nhìn (Ví dụ: 500000 -> 500,000)
local function formatNumber(number)
    local i, j, minus, int, fraction = tostring(number):find('^(-?)(%d+)(%.?%d*)$')
    return minus .. int:reverse():gsub('(%d%d%d)', '%1,'):reverse():gsub('^,', '') .. fraction
end

-- Hàm lấy số dư Beli của acc
local function getPlayerBeli()
    local success, beli = pcall(function()
        return LocalPlayer.Data.Beli.Value
    end)
    if success and type(beli) == "number" then return beli end

    local success2, beli2 = pcall(function()
        return LocalPlayer.leaderstats.Beli.Value
    end)
    if success2 and type(beli2) == "number" then return beli2 end

    return 0
end

-- Tạo UI đếm ngược / Trạng thái
local screenGui = Instance.new("ScreenGui")
screenGui.Name = "TimerUI"
pcall(function() screenGui.Parent = CoreGui end)
if not screenGui.Parent then screenGui.Parent = LocalPlayer:WaitForChild("PlayerGui") end

local timerLabel = Instance.new("TextLabel")
timerLabel.Size = UDim2.new(0, 260, 0, 40)
timerLabel.Position = UDim2.new(0.5, -130, 0.05, 0)
