            "**Tài khoản:** `" .. LocalPlayer.Name .. "`\n**Số Beli hiện tại:** `" .. formattedBeli .. " Beli` (>= 500k)\n👉 Bắt đầu đếm ngược 90s để tắt game.", 
            65280 -- Màu xanh lá
        )

        for timeLeft = TOTAL_TIME, 1, -1 do
            timerLabel.Text = "⏳ Thoát game sau: " .. timeLeft .. "s (" .. formattedBeli .. " Beli)"
            task.wait(1)
        end

        timerLabel.Text = "🔄 Đang đóng ứng dụng..."
        sendDiscordWebhook(
