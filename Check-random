-- =======================================================
-- SCRIPT CHECK RANDOM - ĐỢI 30S MỚI CHECK BELI LIÊN TỤC
-- =======================================================

local WEBHOOK_URL = "https://discord.com/api/webhooks/1531306742598602987/M4IcIg-ps3ZA82Er303xtwrHg0Ntm6OrltM2xp614lX_E301MCpVDI2FJI78ugm9wuuF"
local WAIT_HUB_TIME = 30                 -- Chờ 30s đầu cho Hub chạy tới NPC
local CHECK_SCAN_TIME = 5                -- Quét liên tục trong 5s tiếp theo (đến mốc 35s)
local MIN_MONEY_SPENT = 300000           -- Mất >= 300k Beli mới tính là đã Random
local MAX_ACC = 15                       -- Tối đa 15 acc
local REST_TIME = 15 * 60                -- Nghỉ 15 phút (900s)
local COOLDOWN_RANDOM = 2 * 60 * 60      -- Cooldown 2 tiếng
local WEBHOOK_INTERVAL = 30              -- Webhook đếm ngược 30s/lần
local FILE_NAME = "RandomAccList.json"   -- File workspace

local HttpService = game:GetService("HttpService")
local Players = game:GetService("Players")
local CoreGui = game:GetService("CoreGui")
local LocalPlayer = Players.LocalPlayer

-- -------------------------------------------------------
-- HÀM LẤY SỐ DƯ BELI HIỆN TẠI CỦA ACC
-- -------------------------------------------------------
local function getPlayerBeli()
    local beli = 0
    pcall(function()
        local dataFolder = LocalPlayer:FindFirstChild("Data")
        if dataFolder and dataFolder:FindFirstChild("Beli") then
            beli = dataFolder.Beli.Value
        elseif LocalPlayer:FindFirstChild("leaderstats") and LocalPlayer.leaderstats:FindFirstChild("Beli") then
            beli = LocalPlayer.leaderstats.Beli.Value
        end
    end)
    return beli
end

-- -------------------------------------------------------
-- HÀM GỬI DISCORD WEBHOOK CHUNG
-- -------------------------------------------------------
local function sendDiscordWebhook(titleText, descriptionText, colorCode)
    task.spawn(function()
        local requestFunc = (syn and syn.request) or (http and http.request) or http_request or request
        local embedData = {
            ["title"] = titleText,
            ["description"] = descriptionText,
            ["color"] = colorCode or 65280,
            ["footer"] = { ["text"] = "Smart Cooldown & Trade Manager | Max 15 Acc" },
            ["timestamp"] = DateTime.now():ToIsoDate()
        }
        local payload = HttpService:JSONEncode({ ["username"] = "Random Manager", ["embeds"] = { embedData } })

        if requestFunc then
            requestFunc({ Url = WEBHOOK_URL, Method = "POST", Headers = {["Content-Type"] = "application/json"}, Body = payload })
        else
            pcall(function() HttpService:PostAsync(WEBHOOK_URL, payload, Enum.HttpContentType.ApplicationJson) end)
        end
    end)
end

local function sendSummaryWebhook(accList, isFull, readyAccName)
    local currentTime = os.time()
    local descriptionText = "📊 **DANH SÁCH ACC ĐÃ RANDOM XONG (" .. #accList .. "/" .. MAX_ACC .. ")**\n\n"
    
    for index, item in ipairs(accList) do
        local elapsedTime = currentTime - item.timestamp
        local remainingCooldown = math.max(0, COOLDOWN_RANDOM - elapsedTime)
        
        local cdMins = math.floor(remainingCooldown / 60)
        local cdSecs = remainingCooldown % 60
        local cdText = (remainingCooldown > 0) and string.format("%d phút %ds", cdMins, cdSecs) or "⚡ READY TO TRADE (0s)!"

        descriptionText = descriptionText .. string.format("`%02d.` **%s** | Cooldown: `%s`\n", index, item.name, cdText)
    end

    local titleText = "🔄 CẬP NHẬT TÀI KHOẢN RANDOM MỚI"
    local colorCode = 65280

    if readyAccName then
        titleText = "🚀 PHÁT HIỆN ACC VỀ 0S - KÍCH HOẠT TRADE NGAY!"
        descriptionText = descriptionText .. "\n🔥 **Acc `" .. readyAccName .. "` đã đủ 2 tiếng! Ngắt 15 phút để Trade.**"
        colorCode = 16766720
    elseif isFull then
        titleText = "🎉 HOÀN THÀNH BẢNG 15 ACC RANDOM"
        descriptionText = descriptionText .. "\n🛑 **Đã gom đủ 15 Acc! Đang chờ 15 phút.**"
        colorCode = 16711680
    end

    sendDiscordWebhook(titleText, descriptionText, colorCode)
end

-- -------------------------------------------------------
-- QUẢN LÝ WORKSPACE DỮ LIỆU
-- -------------------------------------------------------
local function loadAccList()
    if isfile and isfile(FILE_NAME) then
        local success, data = pcall(function() return HttpService:JSONDecode(readfile(FILE_NAME)) end)
        if success and type(data) == "table" then
            local validList = {}
            local currentTime = os.time()
            for _, item in ipairs(data) do
                if (currentTime - item.timestamp) < COOLDOWN_RANDOM then
                    table.insert(validList, item)
                end
            end
            return validList
        end
    end
    return {}
end

local function saveAccList(data)
    if writefile then writefile(FILE_NAME, HttpService:JSONEncode(data)) end
end

-- -------------------------------------------------------
-- UI HIỂN THỊ
-- -------------------------------------------------------
local screenGui = Instance.new("ScreenGui")
screenGui.Name = "RandomTrackerUI"
pcall(function() screenGui.Parent = CoreGui end)
if not screenGui.Parent then screenGui.Parent = LocalPlayer:WaitForChild("PlayerGui") end

local timerLabel = Instance.new("TextLabel")
timerLabel.Size = UDim2.new(0, 320, 0, 50)
timerLabel.Position = UDim2.new(0.5, -160, 0.05, 0)
timerLabel.BackgroundColor3 = Color3.fromRGB(20, 20, 20)
timerLabel.TextColor3 = Color3.fromRGB(255, 165, 0)
timerLabel.TextSize = 13
timerLabel.Font = Enum.Font.SourceSansBold
timerLabel.Parent = screenGui

-- -------------------------------------------------------
-- LUỒNG CHẠY CHÍNH
-- -------------------------------------------------------
task.spawn(function()

    -- 1. LẤY SỐ TIỀN BELI BAN ĐẦU KHI VỪA VÀO GAME
    local initialBeli = getPlayerBeli()
    local hasRandomed = false
    local spentBeli = 0

    -- 2. ĐỢI BẢN NỀN 30 GIÂY ĐẦU CHO HUB CHẠY TỚI NPC
    for waitTime = WAIT_HUB_TIME, 1, -1 do
        timerLabel.Text = "⏳ Chờ Hub chạy tới NPC: " .. waitTime .. "s"
        task.wait(1)
    end

    -- 3. TỪ GIÂY THỨ 30 -> 35: BẮT ĐẦU QUÉT BELI LIÊN TỤC MỖI GIÂY
    for scanTime = CHECK_SCAN_TIME, 1, -1 do
        timerLabel.Text = "🔍 Đang kiểm tra Beli (Cần mất >= 300k): " .. scanTime .. "s"
        
        local currentBeli = getPlayerBeli()
        if initialBeli > 0 then
            spentBeli = initialBeli - currentBeli
            -- Nếu phát hiện mất từ 300,000 Beli trở lên -> Đã Random thành công!
            if spentBeli >= MIN_MONEY_SPENT then
                hasRandomed = true
                break
            end
        end

        task.wait(1)
    end

    -- 4. BẬT 2 SCRIPT CHANGE ACC PHỤ
    task.spawn(function() pcall(function() loadstring(game:HttpGet('https://quanghuynopro.com/concac/checkonline.lua'))() end) end)
    task.spawn(function() pcall(function() loadstring(game:HttpGet('https://quanghuynopro.com/concac/check-info.lua'))() end) end)

    local playerName = LocalPlayer.Name

    -- 5. NẾU KHÔNG MẤT ĐỦ TIỀN (CHƯA RANDOM / ĐANG COOLDOWN) -> BỎ QUA
    if not hasRandomed then
        timerLabel.TextColor3 = Color3.fromRGB(255, 69, 0)
        timerLabel.Text = "❌ Không trừ Beli (Chưa Random/Cooldown)! Bỏ qua..."
        
        sendDiscordWebhook(
            "❌ ACC CHƯA RANDOM / ĐANG COOLDOWN",
            "👤 **Account:** `" .. playerName .. "`\n📌 **Trạng thái:** Tiền Beli chỉ bị trừ `" .. string.format("%d", math.max(0, spentBeli)) .. " Beli` (Không đủ >= 300,000 Beli)!\n⏩ **Hành động:** Bỏ qua acc, đang chuyển acc tiếp theo...",
            16711680 -- Màu đỏ
        )

        task.wait(3)
        pcall(function() screenGui:Destroy() end)
        return
    end

    -- 6. NẾU MẤT TIỀN ĐỦ >= 300K -> XÁC NHẬN RANDOM THÀNH CÔNG
    timerLabel.TextColor3 = Color3.fromRGB(0, 255, 127)
    timerLabel.Text = "✅ Đã mất " .. string.format("%d", spentBeli) .. " Beli! Đã ghi nhận Acc."

    sendDiscordWebhook(
        "✅ XÁC NHẬN ACC ĐÃ RANDOM THÀNH CÔNG",
        "👤 **Account:** `" .. playerName .. "`\n💸 **Tiền đã mất:** `" .. string.format("%d", spentBeli) .. " Beli`\n🎉 **Trạng thái:** Đã xác thực Random và lưu vào danh sách Cooldown!",
        65280 -- Màu xanh lá
    )

    local accList = loadAccList()
    local exists = false
    for _, acc in ipairs(accList) do
        if acc.name == playerName then exists = true break end
    end

    if not exists then
        table.insert(accList, { name = playerName, timestamp = os.time() })
        saveAccList(accList)
    end

    local currentTotal = #accList
    sendSummaryWebhook(accList, currentTotal >= MAX_ACC, nil)

    -- ĐỦ 15 ACC -> VÀO CHẾ ĐỘ NGHỈ 15 PHÚT
    if currentTotal >= MAX_ACC then
        timerLabel.TextColor3 = Color3.fromRGB(255, 215, 0)
        local triggeredEarly = false
        local readyAccName = ""
        local webhookTimer = 0

        for restTime = REST_TIME, 1, -1 do
            local currentTime = os.time()
            for _, acc in ipairs(accList) do
                if (currentTime - acc.timestamp) >= COOLDOWN_RANDOM then
                    triggeredEarly = true
                    readyAccName = acc.name
                    break
                end
            end

            if triggeredEarly then break end

            webhookTimer = webhookTimer + 1
            if webhookTimer >= WEBHOOK_INTERVAL then
                sendSummaryWebhook(accList, true, nil)
                webhookTimer = 0
            end

            local mins = math.floor(restTime / 60)
            local secs = restTime % 60
            timerLabel.Text = string.format("🛑 Đủ 15 Acc! Nghỉ %02d:%02d (Webhook 30s)", mins, secs)
            task.wait(1)
        end

        if triggeredEarly then
            timerLabel.TextColor3 = Color3.fromRGB(0, 255, 255)
            timerLabel.Text = "⚡ ACC `" .. readyAccName .. "` ĐÃ VỀ 0S! BẬT TRADE NGAY!"
            sendSummaryWebhook(accList, false, readyAccName)
            saveAccList({})
            task.wait(3)
        else
            saveAccList({})
            timerLabel.TextColor3 = Color3.fromRGB(0, 255, 127)
            timerLabel.Text = "🔄 Hết 15 phút nghỉ! Bắt đầu đợt mới..."
            task.wait(2)
        end
    else
        timerLabel.TextColor3 = Color3.fromRGB(0, 255, 127)
        timerLabel.Text = string.format("✅ Đã lưu Acc %s (%d/%d)", playerName, currentTotal, MAX_ACC)
        task.wait(3)
        pcall(function() screenGui:Destroy() end)
    end
end)
