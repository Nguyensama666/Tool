-- -------------------------------------------------------
-- HÀM LẤY SỐ DƯ BELI HIỆN TẠI CỦA ACC
-- -------------------------------------------------------
local function getPlayerBeli()
    local beli = 0
    pcall(function()
        local dataFolder = LocalPlayer:FindFirstChild("Data")
        if dataFolder and dataFolder:FindFirstChild("Beli") then
            beli = dataFolder.Beli.Value
        elseif LocalPlayer:FindFirstChild("leaderstats") and LocalPlayer.leaderstats:FindFirstChild("Beli") then
            beli = LocalPlayer.leaderstats.Beli.Value
        end
    end)
    return beli
end

-- -------------------------------------------------------
-- HÀM LẤY TÊN TRÁI QUỶ
-- -------------------------------------------------------
local function getFruitName()
    local fruitNameFound = "Trái Quỷ Mới"
    pcall(function()
        local backpack = LocalPlayer:FindFirstChild("Backpack")
        if backpack then
            for _, item in ipairs(backpack:GetChildren()) do
                if string.find(string.lower(item.Name), "fruit") or string.find(string.lower(item.Name), "trái") then
                    fruitNameFound = item.Name
                    return
                end
            end
        end

        local character = LocalPlayer.Character
        if character then
            for _, item in ipairs(character:GetChildren()) do
                if item:IsA("Tool") and (string.find(string.lower(item.Name), "fruit") or string.find(string.lower(item.Name), "trái")) then
                    fruitNameFound = item.Name
                    return
                end
            end
        end

        local getInventory = game:GetService("ReplicatedStorage").Remotes.CommF_:InvokeServer("getInventory")
        if type(getInventory) == "table" then
            for _, item in ipairs(getInventory) do
                if item.Type == "Blox Fruit" or string.find(string.lower(tostring(item.Name or "")), "fruit") then
                    fruitNameFound = tostring(item.Name or "Đã cất vào kho")
                    return
                end
            end
        end
    end)
    return fruitNameFound
end

-- -------------------------------------------------------
-- HÀM GỬI DISCORD WEBHOOK CHUNG
-- -------------------------------------------------------
local function sendDiscordWebhook(titleText, descriptionText, colorCode)
    task.spawn(function()
        local requestFunc = (syn and syn.request) or (http and http.request) or http_request or request
        local embedData = {
            ["title"] = titleText,
            ["description"] = descriptionText,
            ["color"] = colorCode or 65280,
            ["footer"] = { ["text"] = "Smart Cooldown & Trade Manager | Max 15 Acc" },
            ["timestamp"] = DateTime.now():ToIsoDate()
        }
        local payload = HttpService:JSONEncode({ ["username"] = "Random Manager", ["embeds"] = { embedData } })

        if requestFunc then
            requestFunc({ Url = WEBHOOK_URL, Method = "POST", Headers = {["Content-Type"] = "application/json"}, Body = payload })
        else
            pcall(function() HttpService:PostAsync(WEBHOOK_URL, payload, Enum.HttpContentType.ApplicationJson) end)
        end
    end)
end

local function sendSummaryWebhook(accList, isWaiting, readyAccName)
    local currentTime = os.time()
    local descriptionText = "📊 **DANH SÁCH ACC ĐÃ RANDOM XONG (" .. #accList .. "/" .. MAX_ACC .. ")**\n\n"
    
    for index, item in ipairs(accList) do
        local elapsedTime = currentTime - item.timestamp
        local remainingCooldown = math.max(0, COOLDOWN_RANDOM - elapsedTime)
        
        local cdMins = math.floor(remainingCooldown / 60)
        local cdSecs = remainingCooldown % 60
        local cdText = (remainingCooldown > 0) and string.format("%d phút %ds", cdMins, cdSecs) or "⚡ READY TO TRADE (0s)!"

        descriptionText = descriptionText .. string.format("`%02d.` **%s** | Cooldown: `%s`\n", index, item.name, cdText)
    end

    local titleText = "🔄 CẬP NHẬT TÀI KHOẢN RANDOM MỚI"
    local colorCode = 65280

    if readyAccName then
        titleText = "🚀 PHÁT HIỆN ACC VỀ 0S - ĐÃ KÍCH HOẠT ĐẨY DÒNG 1!"
        descriptionText = descriptionText .. "\n🔥 **Acc `" .. readyAccName .. "` đã đủ 2 tiếng! Đang delay 1 phút để Tool Termux chuyển acc...**"
        colorCode = 16766720
    elseif isWaiting then
        titleText = "⏳ ĐÃ ĐỦ 15 ACC - ĐANG TREO CHỜ ACC VỀ 0S"
        descriptionText = descriptionText .. "\n🛑 **Đã gom đủ 15 Acc! Script đang nghỉ liên tục để đợi acc chín...**"
        colorCode = 16711680
    end

    sendDiscordWebhook(titleText, descriptionText, colorCode)
end

-- -------------------------------------------------------
-- QUẢN LÝ WORKSPACE DỮ LIỆU
-- -------------------------------------------------------
local function loadAccList()
    if isfile and isfile(FILE_NAME) then
        local success, data = pcall(function() return HttpService:JSONDecode(readfile(FILE_NAME)) end)
        if success and type(data) == "table" then
            local validList = {}
            local currentTime = os.time()
            for _, item in ipairs(data) do
                if (currentTime - item.timestamp) < COOLDOWN_RANDOM then
                    table.insert(validList, item)
                end
            end
            return validList
        end
    end
    return {}
end

local function saveAccList(data)
    if writefile then writefile(FILE_NAME, HttpService:JSONEncode(data)) end
end

