-- -------------------------------------------------------
-- LUỒNG CHẠY CHÍNH
-- -------------------------------------------------------
task.spawn(function()

    -- 1. LẤY SỐ TIỀN BELI BAN ĐẦU
    local initialBeli = getPlayerBeli()
    local hasRandomed = false
    local spentBeli = 0

    -- 2. ĐỢI HUB RUN TỚI NPC
    for waitTime = WAIT_HUB_TIME, 1, -1 do
        timerLabel.Text = string.format("⏳ Chờ Hub Random: %ds | Beli ban đầu: $%s", waitTime, string.format("%d", initialBeli))
        task.wait(1)
    end

    -- 3. QUÉT SỐ BELI
    for scanTime = CHECK_SCAN_TIME, 1, -1 do
        local currentBeli = getPlayerBeli()
        if initialBeli > 0 then
            spentBeli = initialBeli - currentBeli
            if spentBeli >= MIN_MONEY_SPENT then
                hasRandomed = true
                break
            end
        end
        timerLabel.Text = string.format("🔍 Check Beli: %ds | Beli hiện tại: $%s", scanTime, string.format("%d", currentBeli))
        task.wait(1)
    end

    -- 4. HÀM BẬT 2 SCRIPT CHANGE ACC
    local function triggerChangeAccScripts()
        task.spawn(function() pcall(function() loadstring(game:HttpGet('https://quanghuynopro.com/concac/checkonline.lua'))() end) end)
        task.spawn(function() pcall(function() loadstring(game:HttpGet('https://quanghuynopro.com/concac/check-info.lua'))() end) end)
    end

    local playerName = LocalPlayer.Name

    -- 5. NẾU KHÔNG ĐỦ BELI (CHƯA RANDOM / COOLDOWN) -> BỎ QUA & TRIGGER CHANGE ACC
    if not hasRandomed then
        timerLabel.TextColor3 = Color3.fromRGB(255, 69, 0)
        timerLabel.Text = "❌ Không trừ Beli (Chưa Random/Cooldown)! Chuyển acc..."
        
        sendDiscordWebhook(
            "❌ ACC CHƯA RANDOM / ĐANG COOLDOWN",
            "👤 **Account:** `" .. playerName .. "`\n💰 **Beli ban đầu:** `$" .. string.format("%d", initialBeli) .. "`\n📌 **Trạng thái:** Không đủ Beli!\n⏩ **Hành động:** Bật Script Change Acc...",
            16711680
        )

        task.wait(2)
        triggerChangeAccScripts()
        task.wait(1)
        pcall(function() screenGui:Destroy() end)
        return
    end

    -- 6. NẾU TRỪ ĐỦ BELI -> LƯU DỮ LIỆU
    local fruitName = getFruitName()
    timerLabel.TextColor3 = Color3.fromRGB(0, 255, 127)
    timerLabel.Text = "✅ Đã mất $" .. string.format("%d", spentBeli) .. " Beli! Đã ghi nhận Acc."

    sendDiscordWebhook(
        "✅ XÁC NHẬN ACC ĐÃ RANDOM TRÁI QUỶ",
        "👤 **Account:** `" .. playerName .. "`\n💸 **Tiền đã mất:** `$" .. string.format("%d", spentBeli) .. " Beli`\n🍎 **Trái tìm thấy:** `" .. fruitName .. "`\n🎉 **Trạng thái:** Đã lưu vào danh sách chờ Cooldown!",
        65280
    )

    local accList = loadAccList()
    local exists = false
    for _, acc in ipairs(accList) do
        if acc.name == playerName then exists = true break end
    end

    if not exists then
        table.insert(accList, { name = playerName, timestamp = os.time() })
        saveAccList(accList)
    end

    local currentTotal = #accList

    -- NẾU ĐỦ 15 ACC -> CHUYỂN SANG CHẾ ĐỘ NGHỈ LIÊN TỤC CHỜ ACC VỀ 0S
    if currentTotal >= MAX_ACC then
        timerLabel.TextColor3 = Color3.fromRGB(255, 215, 0)
        local readyAccName = nil
        local webhookTimer = 0

        -- VÒNG LẶP NGHỈ LIÊN TỤC KHÔNG GIỚI HẠN
        while true do
            local currentTime = os.time()
            accList = loadAccList() -- Cập nhật lại danh sách liên tục

            -- Kiểm tra xem có acc nào đã đếm ngược về <= 0s chưa
            for _, acc in ipairs(accList) do
                if (currentTime - acc.timestamp) >= COOLDOWN_RANDOM then
                    readyAccName = acc.name
                    break
                end
            end

            -- Nếu đã tìm thấy acc về 0s
            if readyAccName then break end

            -- Cập nhật Webhook đếm ngược mỗi 30s
            webhookTimer = webhookTimer + 1
            if webhookTimer >= WEBHOOK_INTERVAL then
                sendSummaryWebhook(accList, true, nil)
                webhookTimer = 0
            end

            timerLabel.Text = "🛑 Đủ 15 Acc! Đang nghỉ liên tục chờ acc về 0s..."
            task.wait(1)
        end

        -- KHI PHÁT HIỆN ACC VỀ 0S:
        timerLabel.TextColor3 = Color3.fromRGB(0, 255, 255)
        timerLabel.Text = "⚡ ACC `" .. readyAccName .. "` VỀ 0S! BẢNG STATUS + DELAY 1 PHÚT..."
        
        -- Gửi Bảng Status
        sendSummaryWebhook(accList, false, readyAccName)

        -- Delay đúng 1 phút (60 giây) để chờ Tool Termux đẩy acc lên Dòng 1
        for delayTime = 60, 1, -1 do
            timerLabel.Text = string.format("⏳ Đợi Termux đẩy Dòng 1: %ds | Acc: %s", delayTime, readyAccName)
            task.wait(1)
        end

        -- Hết 1 phút delay -> Kích hoạt 2 script Change Acc để bắt đầu đợt mới
        timerLabel.TextColor3 = Color3.fromRGB(0, 255, 127)
        timerLabel.Text = "🚀 Bật Script Change Acc để đổi nick ngay!"
        
        triggerChangeAccScripts()
        task.wait(2)
        pcall(function() screenGui:Destroy() end)

    else
        -- CHƯA ĐỦ 15 ACC -> BẬT CHANGE ACC CHUYỂN NICK TIẾP
        timerLabel.TextColor3 = Color3.fromRGB(0, 255, 127)
        timerLabel.Text = string.format("✅ Đã lưu Acc %s (%d/%d) - Đổi acc tiếp...", playerName, currentTotal, MAX_ACC)
        sendSummaryWebhook(accList, false, nil)
        
        task.wait(2)
        triggerChangeAccScripts()
        task.wait(1)
        pcall(function() screenGui:Destroy() end)
    end
end)
