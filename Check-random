-- -------------------------------------------------------
local function loadAccList()
    if isfile and isfile(FILE_NAME) then
        local success, data = pcall(function() return HttpService:JSONDecode(readfile(FILE_NAME)) end)
        if success and type(data) == "table" then
            local validList = {}
            local currentTime = os.time()
            for _, item in ipairs(data) do
                if (currentTime - item.timestamp) < COOLDOWN_RANDOM then
                    table.insert(validList, item)
                end
            end
            return validList
        end
    end
    return {}
end

local function saveAccList(data)
    if writefile then writefile(FILE_NAME, HttpService:JSONEncode(data)) end
end

