-- HÀM CHECK TRÁI QUỶ (Ở Ô BÊN DƯỚI HOẶC TRONG KHO STORED)
-- -------------------------------------------------------
local function checkFruitInInventory()
    local foundFruit = false

    -- 1. Check ở các Ô phím tắt bên dưới (Backpack & Character)
    pcall(function()
        local backpack = LocalPlayer:FindFirstChild("Backpack")
        if backpack then
            for _, item in ipairs(backpack:GetChildren()) do
                local itemName = string.lower(item.Name)
                if string.find(itemName, "fruit") or string.find(itemName, "trái") then
                    foundFruit = true
                    return
                end
            end
        end

        local character = LocalPlayer.Character
        if character then
            for _, item in ipairs(character:GetChildren()) do
                if item:IsA("Tool") then
                    local itemName = string.lower(item.Name)
                    if string.find(itemName, "fruit") or string.find(itemName, "trái") then
                        foundFruit = true
                        return
                    end
                end
            end
        end
    end)

    if foundFruit then return true end

    -- 2. Check trong Kho Trái Cất (Stored Fruits Inventory của Blox Fruits)
    pcall(function()
        local getInventory = game:GetService("ReplicatedStorage").Remotes.CommF_:InvokeServer("getInventory")
        if type(getInventory) == "table" then
            for _, item in ipairs(getInventory) do
                if item.Type == "Blox Fruit" or string.find(string.lower(tostring(item.Name or "")), "fruit") then
                    foundFruit = true
                    return
                end
            end
        end
    end)

    return foundFruit
end

