-- 20. AUTO HOP SERVER
-- ====================================================================
local lastHopTime = 0

local function HopServer()
    if not _G.Config.AutoHop then return end
    if tick() - lastHopTime < _G.Config.HopDelay then return end
    
    pcall(function()
        local servers = HttpService:JSONDecode(game:HttpGet("https://games.roblox.com/v1/games/" .. placeId .. "/servers/Public?sortOrder=Asc&limit=100"))
        for _, server in pairs(servers.data) do
            if server.playing < server.maxPlayers and server.id ~= game.JobId then
                TeleportService:TeleportToPlaceInstance(placeId, server.id, Player)
                lastHopTime = tick()
                Log("Đã hop server")
                return
            end
        end
    end)
end

-- ====================================================================
-- 21. AUTO STATS (THEO THỨ TỰ ƯU TIÊN)
-- ====================================================================
local function AutoStats()
    if not _G.Config.AutoStats then return end
    if Player.Data.Points.Value <= 0 then return end
    
    pcall(function()
        local points = Player.Data.Points.Value
        local stats = _G.Config.StatsPriority
        
        for _, statName in ipairs(stats) do
            if points <= 0 then break end
            local remoteName = statName
            if statName == "Fruit" then
                remoteName = "Demon Fruit"
            end
            ReplicatedStorage.Remotes.CommF_:InvokeServer("AddPoint", remoteName, _G.Config.StatsPerPoint)
            points = points - _G.Config.StatsPerPoint
            Log("Đã cộng " .. _G.Config.StatsPerPoint .. " điểm vào " .. statName)
        end
    end)
end

