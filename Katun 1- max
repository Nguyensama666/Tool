-- 8. FAST ATTACK (BYPASS COOLDOWN)
-- ====================================================================
local function FastAttack()
    if not _G.Config.FastAttack then return end
    pcall(function()
        local enemies = {}
        local basePart = nil
        
        local folders = {Workspace.Enemies, Workspace.Characters}
        for _, folder in pairs(folders) do
            if folder then
                for _, enemy in pairs(folder:GetChildren()) do
                    local head = enemy:FindFirstChild("Head")
                    if head and enemy:FindFirstChild("Humanoid") and enemy.Humanoid.Health > 0 and enemy ~= Character then
                        local dist = (HumanoidRootPart.Position - head.Position).Magnitude
                        if dist < 100 then
                            table.insert(enemies, {enemy, head})
                            basePart = head
                        end
                    end
                end
            end
        end
        
        if #enemies > 0 and basePart then
            local registerAttack = ReplicatedStorage.Modules.Net["RE/RegisterAttack"]
            local registerHit = ReplicatedStorage.Modules.Net["RE/RegisterHit"]
            if registerAttack and registerHit then
                registerAttack:FireServer(0)
                registerHit:FireServer(basePart, enemies)
            end
        end
    end)
end

task.spawn(function()
    while task.wait(0.15) do
        if _G.Config.FastAttack then
            FastAttack()
        end
    end
end)

