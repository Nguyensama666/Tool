-- 22. AUTO TRAVEL SEA
-- ====================================================================
local function AutoTravelSea()
    if not _G.Config.AutoTravelSea then return end
    local lv = Player.Data.Level.Value
    
    -- ===== TRAVEL TO SEA 2 =====
    if World1 and lv >= 700 then
        pcall(function()
            local iceDoor = Workspace.Map.Ice.Door
            if iceDoor and iceDoor.CanCollide == true then
                ReplicatedStorage.Remotes.CommF_:InvokeServer("DressrosaQuestProgress", "Detective")
                _tp(CFrame.new(1347.7124, 37.37516, -1325.6488))
                Notify("Travel", "Đang làm quest Sea 2...", 3)
            else
                if Workspace.Enemies:FindFirstChild("Ice Admiral") then
                    for _, mob in pairs(Workspace.Enemies:GetChildren()) do
                        if mob.Name == "Ice Admiral" and mob.Humanoid.Health > 0 then
                            _tp(mob.HumanoidRootPart.CFrame * CFrame.new(0, 20, 0))
                            ReplicatedStorage.Remotes.CommF_:InvokeServer("TravelDressrosa")
                            Notify("Travel", "Đã đến Sea 2!", 3)
                        end
                    end
                end
            end
        end)
    end
    
    -- ===== TRAVEL TO SEA 3 =====
    if World2 and lv >= 1500 then
        pcall(function()
            if ReplicatedStorage.Remotes.CommF_:InvokeServer("ZQuestProgress", "General") == 0 then
                _tp(CFrame.new(-1926.3221435547, 12.819851875305, 1738.3092041016))
                if (HumanoidRootPart.Position - CFrame.new(-1926.3221435547, 12.819851875305, 1738.3092041016).Position).Magnitude <= 10 then
                    task.wait(1)
                    ReplicatedStorage.Remotes.CommF_:InvokeServer("ZQuestProgress", "Begin")
                end
            end
            
            if Workspace.Enemies:FindFirstChild("rip_indra") then
                for _, mob in pairs(Workspace.Enemies:GetChildren()) do
                    if mob.Name == "rip_indra" and mob.Humanoid.Health > 0 then
                        _tp(mob.HumanoidRootPart.CFrame * CFrame.new(0, 20, 0))
                        ReplicatedStorage.Remotes.CommF_:InvokeServer("TravelZou")
                        Notify("Travel", "Đã đến Sea 3!", 3)
                    end
                end
            end
        end)
    end
end

