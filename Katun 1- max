                        if weapon then EquipWeapon(weapon.Name) end
                        return
                    end
                end
            else
                _tp(raidPos)
            end
        end
        
        -- ===== COLLECT FRUIT =====
        for _, obj in pairs(Workspace:GetChildren()) do
            if string.find(obj.Name, "Fruit") and obj:IsA("Tool") and obj:FindFirstChild("Handle") then
                if HumanoidRootPart then
                    local dist = (obj.Handle.Position - HumanoidRootPart.Position).Magnitude
