-- 15. AUTO FARM LEVEL
-- ====================================================================
local function FarmLevel()
    if not _G.Config.AutoFarm then return end
    
    local success, err = pcall(function()
        local data = GetQuestByLevel()
        if not data then
            Notify("Lỗi", "Không tìm thấy quest phù hợp", 2)
            return
        end
        
        local QuestUI = Player.PlayerGui.Main.Quest
        local qText = QuestUI.Container.QuestTitle.Title.Text
        
        -- Kiểm tra quest hiện tại
        if not string.find(qText, data.Mon) then
            ReplicatedStorage.Remotes.CommF_:InvokeServer("AbandonQuest")
        end
        
        -- Nhận quest nếu chưa có
        if not QuestUI.Visible then
            local dist = (HumanoidRootPart.Position - data.Qpos.Position).Magnitude
            if dist > 5 then
                _tp(data.Qpos)
            end
            if dist <= 5 then
                task.wait(0.5)
                ReplicatedStorage.Remotes.CommF_:InvokeServer("StartQuest", data.Qname, data.Qdata)
                Log("Đã nhận quest: " .. data.Qname .. " - " .. data.Mon)
            end
            return
        end
        
        -- Tìm quái gần nhất
        local targetMob = nil
        local minDist = math.huge
        
        for _, mob in pairs(Workspace.Enemies:GetChildren()) do
            if mob.Name == data.Mon and mob:FindFirstChild("Humanoid") and mob.Humanoid.Health > 0 and mob:FindFirstChild("HumanoidRootPart") then
                local d = (HumanoidRootPart.Position - mob.HumanoidRootPart.Position).Magnitude
                if d < minDist then
                    minDist = d
                    targetMob = mob
                end
            end
        end
        
        if targetMob then
            _tp(targetMob.HumanoidRootPart.CFrame * CFrame.new(0, 20, 0))
            BringEnemy(data.Mon, HumanoidRootPart.CFrame)
            local weapon = GetToolByType(_G.Config.SelectWeapon)
            if weapon then
                EquipWeapon(weapon.Name)
            end
        else
            _tp(data.Mpos)
        end
    end)
    
    if not success then
        Log("Lỗi FarmLevel: " .. tostring(err))
        task.wait(1)
    end
end

