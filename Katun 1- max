local TeleportPart = Instance.new("Part", Workspace)
TeleportPart.Name = "TP_Part"
TeleportPart.Anchored = true
TeleportPart.CanCollide = false
TeleportPart.Transparency = 1
TeleportPart.Size = Vector3.new(1, 1, 1)

local shouldTween = false

local function _tp(targetCF)
    if not _G.Config.BypassTP then
        HumanoidRootPart.CFrame = targetCF
        return
    end
    if not HumanoidRootPart then return end
    if HumanoidRootPart.Anchored then HumanoidRootPart.Anchored = false end
    
    local dist = (targetCF.Position - HumanoidRootPart.Position).Magnitude
    local speed = dist <= 90 and 900 or _G.Config.TeleportDistance
    local tween = TweenService:Create(TeleportPart, TweenInfo.new(dist / speed, Enum.EasingStyle.Linear), {
        CFrame = targetCF
    })
    
    shouldTween = true
    tween:Play()
    
    task.spawn(function()
        while tween.PlaybackState == Enum.PlaybackState.Playing do
            if not shouldTween then
                tween:Cancel()
                break
            end
            task.wait(0.1)
        end
        getgenv().OnFarm = true
    end)
end

