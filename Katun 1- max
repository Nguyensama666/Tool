                if weapon then EquipWeapon(weapon.Name) end
                FastAttack()
                BringEnemy("Core", HumanoidRootPart.CFrame)
                return
            end
        end
        
        -- ===== PIRATE RAID (SEA 3) =====
        if World3 then
            local raidPos = CFrame.new(-5496.17, 313.77, -2841.53)
            if (HumanoidRootPart.Position - raidPos.Position).Magnitude < 2000 then
                for _, mob in pairs(Workspace.Enemies:GetChildren()) do
                    if mob:FindFirstChild("Humanoid") and mob.Humanoid.Health > 0 then
                        Log("Đang đánh Pirate Raid...")
                        _tp(mob.HumanoidRootPart.CFrame * CFrame.new(0, 20, 0))
