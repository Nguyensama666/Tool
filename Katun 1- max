local function BringEnemy(mobName, targetPos)
    if not _G.Config.BringMobs then return end
    if not HumanoidRootPart then return end
    
    for _, mob in pairs(Workspace.Enemies:GetChildren()) do
        if mob.Name == mobName and mob:FindFirstChild("Humanoid") and mob.Humanoid.Health > 0 and mob:FindFirstChild("HumanoidRootPart") then
            local dist = (mob.HumanoidRootPart.Position - HumanoidRootPart.Position).Magnitude
            if dist <= _G.Config.BringRange then
                mob.HumanoidRootPart.CFrame = targetPos or CFrame.new(HumanoidRootPart.Position)
                mob.HumanoidRootPart.Size = Vector3.new(50, 50, 50)
                mob.HumanoidRootPart.CanCollide = false
                mob.Head.CanCollide = false
                if mob.Humanoid:FindFirstChild("Animator") then
                    mob.Humanoid.Animator:Destroy()
                end
                mob.Humanoid:ChangeState(14)
                pcall(function()
                    sethiddenproperty(Player, "SimulationRadius", math.huge)
                end)
            end
        end
    end
end

