local ReplicatedStorage = game:GetService("ReplicatedStorage")
local HttpService = game:GetService("HttpService")
local http_request = (syn and syn.request) or (http and http.request) or http_request or request

-- Load Config để lấy link Webhook Status
local Config = loadstring(game:HttpGet("https://raw.githubusercontent.com/Nguyensama666/Tool/refs/heads/main/Config-kaitunMM"))()

local function GetInventory()
    local success, result = pcall(function()
        return ReplicatedStorage.Remotes.CommF_:InvokeServer("getInventory")
    end)
    return success and result or {}
end

local function GetBerryCount(berryName)
    for _, item in pairs(GetInventory()) do
        if item.Type == "Material" and item.Name == berryName then
            return item.Count or 1
        end
    end
    return 0
end

local red    = GetBerryCount("Red Cherry Berry")
local white  = GetBerryCount("White Cloud Berry")
local pink   = GetBerryCount("Pink Pig Berry")

-- Bắn chi tiết số lượng Berry về Status Webhook nếu có cấu hình
if Config.StatusWebhook and Config.StatusWebhook ~= "" then
    local vnTime = os.date("*t", os.time() + 25200)
    local timeString = string.format("%02d/%02d/%04d %02d:%02d:%02d (VN)", vnTime.day, vnTime.month, vnTime.year, vnTime.hour, vnTime.min, vnTime.sec)

    local payload = {
        username = "Berry Tracker",
        avatar_url = "https://i.imgur.com/8N4X0ZT.png",
        embeds = {{
            title = "🫐 TRẠNG THÁI NGUYÊN LIỆU CRAFT HAKI LEGEND",
            color = (red >= 15 and white >= 10 and pink >= 15) and 0x00FF00 or 0xFF8C00,
            fields = {
                { name = "🍒 Red Cherry Berry", value = "`" .. red .. "/15` " .. (red >= 15 and "✅" or "❌"), inline = true },
                { name = "☁️ White Cloud Berry", value = "`" .. white .. "/10` " .. (white >= 10 and "✅" or "❌"), inline = true },
                { name = "🐷 Pink Pig Berry", value = "`" .. pink .. "/15` " .. (pink >= 15 and "✅" or "❌"), inline = true },
            },
            footer = {
                text = "🤖 Check Berry Module • " .. timeString,
                icon_url = "https://i.imgur.com/8N4X0ZT.png"
            }
        }}
    }

    pcall(function()
        http_request({
            Url = Config.StatusWebhook,
            Method = "POST",
            Headers = {["Content-Type"] = "application/json"},
            Body = HttpService:JSONEncode(payload)
        })
    end)
end
