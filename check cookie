cat > ~/check_cookie_new.py << 'EOF'
#!/data/data/com.termux/files/usr/bin/python3
import requests
import sys
import json

# Đọc cookie
try:
    with open("/sdcard/Download/cookie.txt", 'r') as f:
        cookie = f.read().strip()
except:
    print("❌ Không tìm thấy cookie.txt!")
    sys.exit(1)

if not cookie or len(cookie) < 50:
    print("❌ Cookie không hợp lệ!")
    sys.exit(1)

print(f"🔍 Đang kiểm tra cookie...")

headers = {
    'User-Agent': 'Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/120.0.0.0 Safari/537.36',
    'Cookie': f'.ROBLOSECURITY={cookie}'
}

# API mới của Roblox
apis = [
    'https://users.roblox.com/v1/users/authenticated',
    'https://www.roblox.com/mobileapi/userinfo',
    'https://economy.roblox.com/v1/user/currency',
    'https://notifications.roblox.com/v2/notifications/unread-count'
]

for api in apis:
    try:
        print(f"  Đang thử: {api.split('/')[-1]}...")
        response = requests.get(api, headers=headers, timeout=10)
        
        if response.status_code == 200:
            print("\n✅ COOKIE HỢP LỆ!")
            try:
                data = response.json()
                if 'id' in data:
                    print(f"   User ID: {data.get('id')}")
                if 'name' in data:
                    print(f"   Username: {data.get('name')}")
                if 'displayName' in data:
                    print(f"   Display Name: {data.get('displayName')}")
                if 'robux' in data:
                    print(f"   Robux: {data.get('robux')}")
                print("\n🎮 Cookie có thể dùng để login!")
                sys.exit(0)
            except:
                print(f"   Response: {response.text[:100]}")
                sys.exit(0)
        elif response.status_code == 401:
            print("❌ Cookie hết hạn!")
            sys.exit(1)
        elif response.status_code == 403:
            print("❌ Cookie bị khóa!")
            sys.exit(1)
    except Exception as e:
        pass

print("\n❌ Không thể xác minh cookie (có thể API đã thay đổi)")
print("💡 Cookie vẫn có thể dùng để login")
EOF

python3 ~/check_cookie_new.py
