local WebhookURL = "https://discord.com/api/webhooks/1531306742598602987/M4IcIg-ps3ZA82Er303xtwrHg0Ntm6OrltM2xp614lX_E301MCpVDI2FJI78ugm9wuuF"

-- Biến để tránh spam
local lastFound = {}
local lastSendTime = 0
local isRunning = true

-- Hàm lấy số người chơi hiện tại trong server
local function GetPlayerCount()
    local count = 0
    if game:GetService("Players") then
        count = #game:GetService("Players"):GetPlayers()
    end
    return count
end

-- Hàm gửi webhook
local function SendDiscordMessage(content)
    local success = false
    local HttpService = game:GetService("HttpService")
    local data = {["content"] = content}
    local jsonData = HttpService:JSONEncode(data)
    
    local methods = {
        function() 
            if syn and syn.request then
                syn.request({Url = WebhookURL, Method = "POST", Headers = {["Content-Type"] = "application/json"}, Body = jsonData})
                return true
            end
            return false
        end,
        function()
            if http and http.request then
                http.request({Url = WebhookURL, Method = "POST", Headers = {["Content-Type"] = "application/json"}, Body = jsonData})
                return true
            end
            return false
        end,
        function()
            if request then
                request({Url = WebhookURL, Method = "POST", Headers = {["Content-Type"] = "application/json"}, Body = jsonData})
                return true
            end
            return false
        end,
        function()
            pcall(function()
                HttpService:PostAsync(WebhookURL, jsonData, Enum.HttpContentType.ApplicationJson)
            end)
            return true
        end
    }
    
    for _, method in ipairs(methods) do
        local ok, result = pcall(method)
        if ok and result then
            success = true
            break
        end
    end
    
    return success
end

-- Hàm kiểm tra CHALICE
local function CheckChalice()
    local player = game.Players.LocalPlayer
    if not player then return {} end
    
    local found = {}
    local locations = {}
    
    if player.Character then
        table.insert(locations, {parent = player.Character, name = "Character"})
    end
    
    if player.Backpack then
        table.insert(locations, {parent = player.Backpack, name = "Backpack"})
    end
    
    for i = 1, 8 do
        local slot = player:FindFirstChild("Hotbar" .. i) or player:FindFirstChild("Slot" .. i)
        if slot then
            table.insert(locations, {parent = slot, name = "Hotbar " .. i})
        end
    end
    
    for _, loc in ipairs(locations) do
        if loc.parent then
            for _, child in ipairs(loc.parent:GetChildren()) do
                if child:IsA("Tool") then
                    local name = child.Name
                    local lowerName = string.lower(name)
                    if string.find(lowerName, "sweet") or 
                       string.find(lowerName, "chalice") or
                       string.find(lowerName, "god") then
                        table.insert(found, {
                            location = loc.name,
                            name = name
                        })
                    end
                end
            end
        end
    end
    
    return found
end

-- Hàm kiểm tra và gửi webhook
local function CheckAndNotify()
    if not isRunning then return false end
    
    local foundItems = CheckChalice()
    local currentTime = tick()
    
    -- Chống spam: Nếu đã gửi webhook trong vòng 5 phút (300 giây) thì bỏ qua hoàn toàn
    if currentTime - lastSendTime < 300 then
        return false
    end
    
    if #foundItems > 0 then
        local shouldSend = false
        for _, item in ipairs(foundItems) do
            local key = item.name .. "_" .. item.location
            -- Nếu vật phẩm chưa từng gửi hoặc đã quá 10 phút (600 giây) kể từ lần gửi trước
            if not lastFound[key] or currentTime - lastFound[key] > 600 then
                shouldSend = true
                lastFound[key] = currentTime
            end
        end
        
        if shouldSend then
            local jobId = game.JobId
            local placeId = game.PlaceId
            local playerCount = GetPlayerCount()
            
            -- Tạo script teleport
            local teleportScript = string.format(
                'game:GetService("ReplicatedStorage").__ServerBrowser:InvokeServer("teleport", "%s")',
                jobId
            )
            
            -- Tạo message
            local message = "🎯 **PHÁT HIỆN CHALICE!** 🎯\n"
            message = message .. "━━━━━━━━━━━━━━━━━━━━\n"
            message = message .. "**Server ID:** `" .. jobId .. "`\n"
            message = message .. "**Place ID:** `" .. placeId .. "`\n"
            message = message .. "**👥 Số người chơi:** `" .. playerCount .. "`\n"
            message = message .. "**Thời gian:** " .. os.date("%H:%M:%S %d/%m/%Y") .. "\n"
            message = message .. "━━━━━━━━━━━━━━━━━━━━\n"
            message = message .. "**📦 Vật phẩm tìm thấy:**\n"
            
            for _, item in ipairs(foundItems) do
                message = message .. "• " .. item.location .. ": **" .. item.name .. "** ✅\n"
            end
            
            message = message .. "━━━━━━━━━━━━━━━━━━━━\n"
            message = message .. "**📝 Script Teleport:**\n"
            message = message .. "```lua\n" .. teleportScript .. "\n```"
            message = message .. "\n⚡ **Copy script trên và paste vào executor để teleport!**"
            
            -- In ra console (F9 để xem)
            print("✅ TÌM THẤY CHALICE! (Server: " .. jobId .. " | Người chơi: " .. playerCount .. ")")
            print("📍 " .. item.location .. ": " .. item.name)
            print("📝 Script: " .. teleportScript)
            
            -- Gửi webhook
            local sent = SendDiscordMessage(message)
            if sent then
                lastSendTime = currentTime
                print("✅ Đã gửi Discord thành công!")
            else
                print("⚠️ Không gửi được webhook! Copy thủ công:")
                print(message)
            end
            
            return true
        end
    end
    
    return false
end

