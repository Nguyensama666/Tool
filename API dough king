-- HÀM CHÍNH - TỰ ĐỘNG CHẠY
local function AutoRun()
    print("━━━━━━━━━━━━━━━━━━━━━━━━━━")
    print("🏆 CHALICE CHECKER AUTO + TELEPORT")
    print("━━━━━━━━━━━━━━━━━━━━━━━━━━")
    print("✅ Đã bật tự động kiểm tra!")
    print("⏱ Kiểm tra mỗi 10 giây")
    print("📤 Sẽ gửi webhook + script teleport khi tìm thấy")
    print("━━━━━━━━━━━━━━━━━━━━━━━━━━")
    
    local statusLabel = CreateMiniGUI()
    
    wait(2)
    CheckAndNotify()
    
    game:GetService("RunService").Heartbeat:Connect(function()
        if not isRunning then return end
        
        if not _G._lastAutoCheck or tick() - _G._lastAutoCheck >= 10 then
            _G._lastAutoCheck = tick()
            
            if statusLabel then
                statusLabel.Text = "🔄 Đang kiểm tra..."
                statusLabel.TextColor3 = Color3.fromRGB(255, 255, 0)
            end
            
            local found = CheckAndNotify()
            
            if statusLabel then
                if found then
                    statusLabel.Text = "🎯 TÌM THẤY! Đã gửi webhook!"
                    statusLabel.TextColor3 = Color3.fromRGB(0, 255, 0)
                else
                    statusLabel.Text = "⏳ Đang theo dõi... (10s)"
                    statusLabel.TextColor3 = Color3.fromRGB(0, 255, 255)
                end
            end
        end
    end)
end

-- Chạy script tự động
pcall(function()
    repeat wait() until game.Players.LocalPlayer
    AutoRun()
end)

