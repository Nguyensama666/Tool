    print("🛡 Chống spam: " .. cooldownTime .. "s cooldown")
    print("📊 Giới hạn: " .. maxSendsPerDay .. " lần/ngày")
    print("📌 Xem kết quả trong console (F9)")
    print("━━━━━━━━━━━━━━━━━━━━━━━━━━")
    
    wait(3)
    CheckAndNotify()
    
    game:GetService("RunService").Heartbeat:Connect(function()
        if not isRunning then return end
        
        if not _G._lastAutoCheck or tick() - _G._lastAutoCheck >= checkInterval then
            _G._lastAutoCheck = tick()
            pcall(CheckAndNotify)
        end
    end)
end

-- Chạy script
pcall(function()
    repeat wait() until game.Players.LocalPlayer
    AutoRun()
end)

-- Lệnh điều khiển
_G.StopChaliceChecker = function()
    isRunning = false
    print("⏹ Đã dừng Chalice Checker")
end

_G.CheckChaliceNow = function()
    print("🔍 Kiểm tra thủ công...")
    return CheckAndNotify()
end

_G.SetCooldown = function(seconds)
    if type(seconds) == "number" and seconds >= 60 then
        cooldownTime = seconds
        print("✅ Đã đổi cooldown thành " .. seconds .. " giây")
    else
        print("⚠️ Cooldown phải >= 60 giây")
    end
end

_G.SetInterval = function(seconds)
    if type(seconds) == "number" and seconds >= 5 then
        checkInterval = seconds
        print("✅ Đã đổi interval thành " .. seconds .. " giây")
    else
        print("⚠️ Interval phải >= 5 giây")
    end
end

