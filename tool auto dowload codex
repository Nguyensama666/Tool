import re, os, requests, subprocess, time

FOLDER_KEY = 'cb97mwskmgdw8'
OUT_DIR = os.path.expanduser('~/storage/downloads')
os.makedirs(OUT_DIR, exist_ok=True)

params = {
    'content_type': 'files', 'filter': 'all', 'order_by': 'name',
    'order_direction': 'asc', 'chunk': 1, 'version': '1.5',
    'folder_key': FOLDER_KEY, 'response_format': 'json',
}
r = requests.get('https://www.mediafire.com/api/1.5/folder/get_content.php', params=params).json()
files = r['response']['folder_content']['files']
print(f'Tìm thấy {len(files)} file')

def download_file(link, dest, retries=3):
    for attempt in range(1, retries + 1):
        try:
            with requests.get(link, stream=True, timeout=30) as resp:
                resp.raise_for_status()
                with open(dest, 'wb') as fp:
                    for chunk in resp.iter_content(1024*1024):
                        fp.write(chunk)
            return True
        except Exception as e:
            print(f'  Loi lan {attempt}: {e}')
            time.sleep(2)
    return False

for f in files:
    quickkey = f['quickkey']
    name = f['filename']
    try:
        page = requests.get(f'https://www.mediafire.com/file/{quickkey}', timeout=30).text
        m = re.search(r'href="(https://download[^"]+)"', page)
        if not m:
            print('Khong tim thay link tai cho', name)
            continue
        link = m.group(1)
        dest = os.path.join(OUT_DIR, name)
        print('Dang tai:', name)
        ok = download_file(link, dest)
        if not ok:
            print('Bo qua', name, 'sau nhieu lan loi')
            continue
        print('Xong:', name)
        if name.lower().endswith('.apk'):
            print('Dang cai:', name)
            result = subprocess.run(['su', '-c', f'pm install -r "{dest}"'], capture_output=True, text=True)
            print(result.stdout.strip() or result.stderr.strip())
    except Exception as e:
        print('Loi tong quat voi', name, ':', e)
        continue
