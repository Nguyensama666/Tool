#!/data/data/com.termux/files/usr/bin/python3
import os
import subprocess
import time
import json

DOWNLOAD_DIR = "/sdcard/Download"
ANDROID_DATA = "/sdcard/Android/data"
CONFIG_FILE = "/sdcard/Download/roblox_config.json"
selected_package = None

def load_config():
    global selected_package
    if os.path.exists(CONFIG_FILE):
        try:
            with open(CONFIG_FILE, 'r') as f:
                config = json.load(f)
                pkg = config.get('package', '')
                if pkg:
                    selected_package = pkg
                    return True
        except:
            pass
    return False

def save_config():
    try:
        with open(CONFIG_FILE, 'w') as f:
            json.dump({'package': selected_package}, f)
    except:
        pass

def run_su(cmd):
    try:
        result = subprocess.run(f"su -c '{cmd}'", shell=True, capture_output=True, text=True, timeout=20)
        return result.stdout.strip() if result.returncode == 0 else None
    except:
        return None

def list_android_data():
    print("\n🔍 Đang quét /sdcard/Android/data/...")
    
    if not os.path.exists(ANDROID_DATA):
        print("❌ Không tìm thấy thư mục Android/data")
        return []
    
    try:
        all_dirs = sorted(os.listdir(ANDROID_DATA))
    except PermissionError:
        print("❌ Không có quyền đọc. Đang thử với root...")
        out = run_su(f"ls {ANDROID_DATA}")
        if not out:
            print("❌ Vẫn không đọc được!")
            return []
        all_dirs = sorted(out.split('\n'))
    
    roblox_dirs = [d for d in all_dirs if 'roblox' in d.lower()]
    
    if not roblox_dirs:
        print("❌ Không tìm thấy package Roblox nào!")
        return []
    
    print(f"\n🎮 Tìm thấy {len(roblox_dirs)} package Roblox:\n")
    print("-" * 60)
    for i, d in enumerate(roblox_dirs, 1):
        print(f"  {i}. {d}")
    print("-" * 60)
    
    return roblox_dirs

def select_package():
    global selected_package
    
    packages = list_android_data()
    if not packages:
        print("⚠️ Vui lòng thử lại hoặc nhập tay!")
        return False
    
    try:
        num = int(input(f"\n➤ Chọn số (1-{len(packages)}, 0=thoát): "))
        if num == 0:
            return False
        if 1 <= num <= len(packages):
            selected_package = packages[num-1]
            save_config()
            print(f"✅ Đã chọn: {selected_package}")
            return True
        else:
            print("❌ Số không hợp lệ!")
            return False
    except ValueError:
        print("❌ Phải nhập số!")
        return False

def login_cookie():
    global selected_package
    
    if not selected_package:
        print("\n⚠️ Chưa chọn package! Vào mục 1 trước.")
        return
    
    print(f"\n📦 Package: {selected_package}")
    
    filename = input("➤ Tên file cookie trong Download: ").strip()
    if not filename:
        print("❌ Không được để trống!")
        return
    
    cookie_path = os.path.join(DOWNLOAD_DIR, filename)
    if not os.path.exists(cookie_path):
        print(f"❌ Không tìm thấy file: {filename}")
        return
    
    try:
        with open(cookie_path, 'r') as f:
            cookie = f.read().strip()
        if not cookie:
            print("❌ File rỗng!")
            return
        print(f"✅ Đã đọc cookie ({len(cookie)} ký tự)")
    except Exception as e:
        print(f"❌ Lỗi: {e}")
        return
    
    cookie_db = f"/data/data/{selected_package}/app_webview/Default/Cookies"
    
    check = run_su(f"[ -f '{cookie_db}' ] && echo OK")
    if not check:
        print(f"❌ Không tìm thấy database tại: {cookie_db}")
        print("💡 Package có thể không dùng WebView hoặc chưa từng chạy!")
        return
    
    timestamp = time.strftime("%Y%m%d_%H%M%S")
    backup_path = os.path.join(DOWNLOAD_DIR, f"Cookies_backup_{timestamp}.db")
    run_su(f"cp '{cookie_db}' '{backup_path}'")
    print(f"💾 Backup: Cookies_backup_{timestamp}.db")
    
    print("✍️ Đang ghi cookie...")
    
    run_su(f"am force-stop {selected_package}")
    time.sleep(2)
    
    # 🔥 QUAN TRỌNG: Thoát ký tự đặc biệt trong cookie
    safe_cookie = cookie.replace("'", "''")
    
    # 📝 SQL Script tối ưu dựa trên cấu trúc database thực tế
    sql_script = f"""
-- 1. Kiểm tra và cập nhật cookie hiện có
UPDATE cookies 
SET 
    value = '{safe_cookie}',
    has_expires = 0,
    expires_utc = 0,
    is_persistent = 1,
    last_access_utc = strftime('%s','now')*1000000
WHERE host_key LIKE '%.roblox.com' 
  AND name = '.ROBLOSECURITY'
  AND path = '/';

-- 2. Nếu chưa có, thêm mới với đầy đủ các cột
INSERT OR IGNORE INTO cookies (
    creation_utc,
    host_key,
    name,
    value,
    path,
    expires_utc,
    is_secure,
    is_httponly,
    last_access_utc,
    has_expires,
    is_persistent,
    priority,
    encrypted_value,
    samesite,
    source_scheme,
    source_port,
    is_same_party
) VALUES (
    strftime('%s','now')*1000000,    -- creation_utc
    '.roblox.com',                   -- host_key
    '.ROBLOSECURITY',                -- name
    '{safe_cookie}',                 -- value
    '/',                             -- path
    0,                               -- expires_utc (không hết hạn)
    0,                               -- is_secure (không yêu cầu HTTPS)
    1,                               -- is_httponly (không cho JS đọc)
    strftime('%s','now')*1000000,    -- last_access_utc
    0,                               -- has_expires (không có hết hạn)
    1,                               -- is_persistent (tồn tại lâu dài)
    1,                               -- priority (ưu tiên 1)
    '',                              -- encrypted_value (rỗng)
    1,                               -- samesite (Lax)
    0,                               -- source_scheme
    -1,                              -- source_port (không xác định)
    0                                -- is_same_party
);
"""
    
    sql_file = os.path.expanduser("~/update.sql")
    with open(sql_file, 'w') as f:
        f.write(sql_script)
    
    tmp_db = os.path.expanduser("~/cookies.db")
    run_su(f"cp '{cookie_db}' '{tmp_db}'")
    run_su(f"chmod 666 '{tmp_db}'")
    
    # Tìm sqlite3 trong hệ thống
    sqlite3_path = None
    for path in ["/system/bin/sqlite3", "/system/xbin/sqlite3", "/data/data/com.termux/files/usr/bin/sqlite3"]:
        check = run_su(f"[ -f '{path}' ] && echo OK")
        if check:
            sqlite3_path = path
            break
    
    if not sqlite3_path:
        print("❌ Không tìm thấy sqlite3! Cài: pkg install sqlite3")
        return
    
    # Chạy SQL script
    cmd = f"{sqlite3_path} '{tmp_db}' < '{sql_file}'"
    run_su(cmd)
    
    # Xác minh cookie đã được ghi thành công
    verify = run_su(f"{sqlite3_path} '{tmp_db}' \"SELECT value FROM cookies WHERE name='.ROBLOSECURITY' AND host_key LIKE '%.roblox.com'\"")
    
    if verify and len(verify) > 10:
        # Copy back và set quyền
        run_su(f"cp '{tmp_db}' '{cookie_db}'")
        run_su(f"chmod 660 '{cookie_db}'")
        
        # Lấy owner/group đúng
        owner = run_su(f"stat -c %U '{cookie_db}'")
        group = run_su(f"stat -c %G '{cookie_db}'")
        if owner and group:
            run_su(f"chown {owner}:{group} '{cookie_db}'")
        
        # Dọn dẹp
        run_su(f"rm -f '{tmp_db}'")
        os.remove(sql_file)
        
        print("\n✅ ĐĂNG NHẬP THÀNH CÔNG!")
        print("📌 Khởi động lại Roblox để áp dụng")
        
        if input("\n🗑️ Xóa file cookie? (y/n): ").lower() == 'y':
            try:
                os.remove(cookie_path)
                print("✅ Đã xóa file cookie!")
            except:
                print("⚠️ Không thể xóa file cookie")
    else:
        # Khôi phục backup nếu thất bại
        run_su(f"cp '{backup_path}' '{cookie_db}'")
        run_su(f"chmod 660 '{cookie_db}'")
        run_su(f"rm -f '{tmp_db}'")
        os.remove(sql_file)
        print("\n❌ Đăng nhập thất bại!")
        print("♻️ Đã khôi phục backup!")

def main():
    load_config()
    
    while True:
        print("\n" + "="*40)
        print("   ROBLOX COOKIE LOGIN")
        print("="*40)
        print(f"📦 Package: {selected_package or 'CHƯA CHỌN'}")
        print("-"*40)
        print("1. 🔧 Chọn package (quét Android/data)")
        print("2. 🍪 Đăng nhập cookie")
        print("0. 🚪 Thoát")
        print("-"*40)
        
        c = input("➤ Chọn: ").strip()
        
        if c == '1':
            select_package()
        elif c == '2':
            login_cookie()
        elif c == '0':
            print("👋 Bye!")
            break
        else:
            print("❌ Sai!")

if __name__ == "__main__":
    main()
