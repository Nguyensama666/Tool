
#!/data/data/com.termux/files/usr/bin/bash

echo "=========================================="
echo "   ROBLOX COOKIE TOOL STYLE"
echo "=========================================="

# Đọc cookie từ file
if [ ! -f "/sdcard/Download/cookie.txt" ]; then
    echo "❌ Không tìm thấy cookie.txt"
    exit 1
fi

COOKIE=$(cat /sdcard/Download/cookie.txt | tr -d '\n\r')
echo "✅ Cookie: ${COOKIE:0:30}..."

# Kiểm tra cookie với API
echo "🔍 Kiểm tra cookie..."
RESPONSE=$(curl -s -o /tmp/user.json -w "%{http_code}" \
    -H "User-Agent: Mozilla/5.0" \
    -H "Cookie: .ROBLOSECURITY=${COOKIE}" \
    https://users.roblox.com/v1/users/authenticated)

if [ "$RESPONSE" != "200" ]; then
    echo "❌ Cookie không hợp lệ!"
    exit 1
fi

USERNAME=$(cat /tmp/user.json | grep -o '"name":"[^"]*"' | cut -d'"' -f4)
USER_ID=$(cat /tmp/user.json | grep -o '"id":"[^"]*"' | cut -d'"' -f4)
echo "✅ COOKIE HỢP LỆ!"
echo "   User: $USERNAME"
echo "   ID: $USER_ID"
rm -f /tmp/user.json

# Xóa sạch data Roblox
echo "🗑️ Xóa data Roblox..."
su -c "am force-stop com.roblox.client"
su -c "pm clear com.roblox.client"
su -c "rm -rf /data/data/com.roblox.client"
sleep 2

# Tạo thư mục
su -c "mkdir -p /data/data/com.roblox.client/app_webview/Default"

# Tạo database giống tool người khác
rm -f /sdcard/Download/cookies.db

sqlite3 /sdcard/Download/cookies.db << 'EOSQL'
CREATE TABLE cookies(
    creation_utc INTEGER NOT NULL,
    host_key TEXT NOT NULL,
    name TEXT NOT NULL,
    value TEXT NOT NULL,
    path TEXT NOT NULL,
    expires_utc INTEGER NOT NULL,
    is_secure INTEGER NOT NULL,
    is_httponly INTEGER NOT NULL,
    last_access_utc INTEGER NOT NULL,
    has_expires INTEGER NOT NULL DEFAULT 1,
    is_persistent INTEGER NOT NULL DEFAULT 1,
    priority INTEGER NOT NULL DEFAULT 1,
    encrypted_value BLOB DEFAULT "",
    samesite INTEGER NOT NULL DEFAULT -1,
    source_scheme INTEGER NOT NULL DEFAULT 0,
    source_port INTEGER NOT NULL DEFAULT -1,
    is_same_party INTEGER NOT NULL DEFAULT 0,
    UNIQUE (host_key, name, path)
);
CREATE INDEX cookies_unique_index ON cookies(host_key, name, path);
EOSQL

# Inject cookie
sqlite3 /sdcard/Download/cookies.db << EOF
INSERT OR REPLACE INTO cookies (
    creation_utc, host_key, name, value, path, expires_utc,
    is_secure, is_httponly, last_access_utc, has_expires,
    is_persistent, priority, encrypted_value, samesite,
    source_scheme, source_port, is_same_party
) VALUES (
    strftime('%s','now')*1000000,
    '.roblox.com',
    '.ROBLOSECURITY',
    '${COOKIE}',
    '/',
    0,
    1,
    1,
    strftime('%s','now')*1000000,
    1,
    1,
    1,
    '',
    -1,
    0,
    -1,
    0
);
EOF

# Kiểm tra
COUNT=$(sqlite3 /sdcard/Download/cookies.db "SELECT COUNT(*) FROM cookies WHERE name='.ROBLOSECURITY';")
echo "✅ Đã ghi $COUNT records"

# Copy vào data
USER_ID=$(su -c "stat -c %u /data/data/com.roblox.client")
GROUP_ID=$(su -c "stat -c %g /data/data/com.roblox.client")
su -c "cp /sdcard/Download/cookies.db /data/data/com.roblox.client/app_webview/Default/Cookies"
su -c "chown ${USER_ID}:${GROUP_ID} /data/data/com.roblox.client/app_webview/Default/Cookies"
su -c "chmod 660 /data/data/com.roblox.client/app_webview/Default/Cookies"

rm -f /sdcard/Download/cookies.db

echo "=========================================="
echo "✅ ĐĂNG NHẬP THÀNH CÔNG!"
echo "   User: $USERNAME"
echo "=========================================="

su -c "monkey -p com.roblox.client -c android.intent.category.LAUNCHER 1"
