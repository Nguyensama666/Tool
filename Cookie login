#!/data/data/com.termux/files/usr/bin/bash

# ==========================================
#    ROBLOX COOKIE INJECTOR (FIXED 2026)
# ==========================================

GREEN='\033[0;32m'
RED='\033[0;31m'
YELLOW='\033[1;33m'
BLUE='\033[0;34m'
NC='\033[0m'

echo -e "${BLUE}=========================================="
echo "    ROBLOX COOKIE INJECTOR"
echo -e "==========================================${NC}"

# 1. Trích xuất Cookie
extract_cookie() {
    local line="$1"
    if [[ "$line" =~ ^[^:]+:[^:]+:(.+)$ ]]; then
        echo "${BASH_REMATCH[1]}"
        return 0
    fi
    if [[ "$line" =~ ^_\|WARNING ]]; then
        echo "$line"
        return 0
    fi
    if [[ ${#line} -gt 100 ]]; then
        echo "$line"
        return 0
    fi
    return 1
}

# 2. Kiểm tra file cookie.txt
COOKIE_FILE="/sdcard/Download/cookie.txt"
if [ ! -f "$COOKIE_FILE" ]; then
    echo -e "${RED}❌ Không tìm thấy $COOKIE_FILE!${NC}"
    exit 1
fi

RAW_COOKIE=$(cat "$COOKIE_FILE" | tr -d '\n\r')
COOKIE=$(extract_cookie "$RAW_COOKIE")

if [ -z "$COOKIE" ] || [ ${#COOKIE} -lt 100 ]; then
    echo -e "${RED}❌ Cookie không hợp lệ (quá ngắn)!${NC}"
    exit 1
fi

echo -e "${GREEN}✅ Cookie hợp lệ: ${COOKIE:0:30}... (${#COOKIE} chars)${NC}"

# 3. Dừng ứng dụng & Tạo thư mục đích
echo -e "${YELLOW}📋 Đang dừng Roblox và khởi tạo thư mục...${NC}"
su -c "am force-stop com.roblox.client" 2>/dev/null
sleep 2

TARGET_DIR="/data/data/com.roblox.client/app_webview/Default"
su -c "mkdir -p $TARGET_DIR" 2>/dev/null

# 4. Tạo Database SQLite
TARGET_DB="/sdcard/Download/Cookies.db"
rm -f "$TARGET_DB"

# Tạo bảng meta & cookies
sqlite3 "$TARGET_DB" "CREATE TABLE meta (key LONGVARCHAR NOT NULL UNIQUE PRIMARY KEY, value LONGVARCHAR);"
sqlite3 "$TARGET_DB" "INSERT INTO meta (key, value) VALUES ('version', '18'), ('last_compatible_version', '18');"

sqlite3 "$TARGET_DB" "CREATE TABLE cookies (creation_utc INTEGER NOT NULL, host_key TEXT NOT NULL, top_frame_site_key TEXT NOT NULL DEFAULT '', name TEXT NOT NULL, value TEXT NOT NULL, path TEXT NOT NULL, expires_utc INTEGER NOT NULL, is_secure INTEGER NOT NULL, is_httponly INTEGER NOT NULL, last_access_utc INTEGER NOT NULL, has_expires INTEGER NOT NULL DEFAULT 1, is_persistent INTEGER NOT NULL DEFAULT 1, priority INTEGER NOT NULL DEFAULT 1, encrypted_value BLOB DEFAULT '', samesite INTEGER NOT NULL DEFAULT -1, source_scheme INTEGER NOT NULL DEFAULT 0, source_port INTEGER NOT NULL DEFAULT -1, is_same_party INTEGER NOT NULL DEFAULT 0, UNIQUE (host_key, name, path));"

chmod 666 "$TARGET_DB" 2>/dev/null

# Tính thời gian Chromium Microseconds chuẩn (11644473600000000us là mốc 1601->1970)
SECS=$(date +%s)
NOW_TIME=$(( (SECS + 11644473600) * 1000000 ))
EXPIRE_TIME=$(( NOW_TIME + (5 * 365 * 86400 * 1000000) )) # +5 năm đúng chuẩn

ESCAPED=$(echo "$COOKIE" | sed "s/'/''/g")

sqlite3 "$TARGET_DB" "INSERT INTO cookies (creation_utc, host_key, top_frame_site_key, name, value, path, expires_utc, is_secure, is_httponly, last_access_utc, has_expires, is_persistent, priority, encrypted_value, samesite, source_scheme, source_port, is_same_party) VALUES (${NOW_TIME}, '.roblox.com', '', '.ROBLOSECURITY', '${ESCAPED}', '/', ${EXPIRE_TIME}, 1, 1, ${NOW_TIME}, 1, 1, 1, '', -1, 1, -1, 0);" 2>/dev/null

# Chuyển journal mode sang DELETE để tránh lỗi ghi nhớ WAL
sqlite3 "$TARGET_DB" "PRAGMA journal_mode=DELETE;" 2>/dev/null

# 5. Ghi đè vào app
echo "📋 Đang copy Database vào Roblox..."

# Lấy UID/GID của ứng dụng
R_UID=$(su -c "stat -c '%u' $TARGET_DIR" 2>/dev/null)
R_GID=$(su -c "stat -c '%g' $TARGET_DIR" 2>/dev/null)

if [ -z "$R_UID" ] || [ "$R_UID" -eq 0 ]; then
    R_UID="10105"
    R_GID="10105"
fi

# Xóa sạch các file cache database cũ
su -c "rm -f $TARGET_DIR/Cookies*" 2>/dev/null

# Copy & Set quyền
su -c "cp /sdcard/Download/Cookies.db $TARGET_DIR/Cookies" 2>/dev/null
su -c "chown ${R_UID}:${R_GID} $TARGET_DIR/Cookies" 2>/dev/null
su -c "chmod 660 $TARGET_DIR/Cookies" 2>/dev/null

echo -e "${GREEN}=========================================="
echo "✅ ĐÃ INJECT COOKIE THÀNH CÔNG!"
echo -e "==========================================${NC}"

# 6. Mở Roblox
echo -e "${YELLOW}🚀 Đang mở Roblox...${NC}"
su -c "monkey -p com.roblox.client -c android.intent.category.LAUNCHER 1" 2>/dev/null
