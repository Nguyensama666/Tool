cat > ~/roblox_login.sh << 'EOF'
#!/data/data/com.termux/files/usr/bin/bash

# ==========================================
#   ROBLOX COOKIE LOGIN TOOL
#   Hỗ trợ: cookie thuần, user:pass:cookie
# ==========================================

VERSION="1.0"
GREEN='\033[0;32m'
RED='\033[0;31m'
YELLOW='\033[1;33m'
BLUE='\033[0;34m'
NC='\033[0m'

echo -e "${BLUE}=========================================="
echo "   ROBLOX COOKIE LOGIN TOOL v$VERSION"
echo -e "==========================================${NC}"

# ==========================================
# HÀM TRÍCH XUẤT COOKIE
# ==========================================
extract_cookie() {
    local line="$1"
    # Định dạng user:pass:cookie
    if [[ "$line" =~ ^[^:]+:[^:]+:(.+)$ ]]; then
        echo "${BASH_REMATCH[1]}"
        return 0
    fi
    # Cookie thuần
    if [[ "$line" =~ ^_\|WARNING ]]; then
        echo "$line"
        return 0
    fi
    # Cookie dài > 100 ký tự
    if [[ ${#line} -gt 100 ]]; then
        echo "$line"
        return 0
    fi
    return 1
}

# ==========================================
# MENU NHẬP COOKIE
# ==========================================
input_cookie() {
    echo ""
    echo -e "${YELLOW}📝 NHẬP COOKIE${NC}"
    echo "----------------------------------------"
    echo "Hỗ trợ các định dạng:"
    echo "  1. Cookie thuần: _|WARNING:-DO-NOT-SHARE-this.-..."
    echo "  2. user:pass:cookie: username:password:_|WARNING:-..."
    echo ""
    echo -n "➤ Dán cookie vào đây: "
    read -r user_input
    
    if [ -z "$user_input" ]; then
        echo -e "${RED}❌ Cookie không được để trống!${NC}"
        return 1
    fi
    
    # Trích xuất cookie
    COOKIE=$(extract_cookie "$user_input")
    
    if [ -z "$COOKIE" ] || [ ${#COOKIE} -lt 100 ]; then
        echo -e "${RED}❌ Cookie không hợp lệ (quá ngắn)!${NC}"
        return 1
    fi
    
    # Lưu vào file
    echo "$COOKIE" > /sdcard/Download/cookie.txt
    echo -e "${GREEN}✅ Cookie đã được lưu vào /sdcard/Download/cookie.txt${NC}"
    return 0
}

# ==========================================
# HÀM CHECK COOKIE
# ==========================================
check_cookie() {
    local cookie="$1"
    echo ""
    echo -e "${YELLOW}🔍 ĐANG KIỂM TRA COOKIE...${NC}"
    
    RESPONSE=$(curl -s -w "%{http_code}" -o /tmp/check.json \
        -H "User-Agent: Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36" \
        -H "Cookie: .ROBLOSECURITY=${cookie}" \
        https://users.roblox.com/v1/users/authenticated)
    
    if [ "$RESPONSE" = "200" ]; then
        USERNAME=$(cat /tmp/check.json | grep -o '"name":"[^"]*"' | head -1 | cut -d'"' -f4)
        USER_ID=$(cat /tmp/check.json | grep -o '"id":"[^"]*"' | head -1 | cut -d'"' -f4)
        echo -e "${GREEN}✅ COOKIE HỢP LỆ!${NC}"
        echo -e "   User: ${USERNAME:-Unknown}"
        echo -e "   ID: ${USER_ID:-Unknown}"
        rm -f /tmp/check.json
        return 0
    else
        echo -e "${RED}❌ Cookie không hợp lệ! (HTTP $RESPONSE)${NC}"
        echo -e "${YELLOW}💡 Cookie có thể đã hết hạn hoặc bị khóa${NC}"
        rm -f /tmp/check.json
        return 1
    fi
}

# ==========================================
# HÀM INJECT COOKIE
# ==========================================
inject_cookie() {
    local cookie="$1"
    
    echo ""
    echo -e "${YELLOW}📋 BẮT ĐẦU INJECT COOKIE...${NC}"
    
    # Force stop
    echo "⏹ Force stop Roblox..."
    su -c "am force-stop com.roblox.client" 2>/dev/null
    sleep 2
    
    # Clear cache
    echo "🧹 Clear cache..."
    su -c "pm clear --cache-only com.roblox.client" 2>/dev/null
    sleep 1
    
    # Tạo thư mục
    echo "📁 Tạo thư mục..."
    su -c "mkdir -p /data/data/com.roblox.client/app_webview/Default" 2>/dev/null
    
    # Kiểm tra file mẫu
    if [ ! -f "/sdcard/Download/cklogin/Cookies.db" ] && [ ! -f "/sdcard/Download/Cookies.db" ]; then
        echo -e "${RED}❌ Không tìm thấy file mẫu Cookies.db!${NC}"
        echo "💡 Đặt file Cookies.db vào /sdcard/Download/cklogin/ hoặc /sdcard/Download/"
        return 1
    fi
    
    # Copy file mẫu
    if [ -f "/sdcard/Download/cklogin/Cookies.db" ]; then
        cp /sdcard/Download/cklogin/Cookies.db /sdcard/Download/Cookies.db
    else
        cp /sdcard/Download/Cookies.db /sdcard/Download/Cookies.db.tmp
        mv /sdcard/Download/Cookies.db.tmp /sdcard/Download/Cookies.db
    fi
    chmod 666 /sdcard/Download/Cookies.db 2>/dev/null
    
    # Escape cookie
    ESCAPED=$(echo "$cookie" | sed "s/'/''/g")
    
    # Xóa cookie cũ
    sqlite3 /sdcard/Download/Cookies.db "DELETE FROM cookies WHERE name='.ROBLOSECURITY';" 2>/dev/null
    
    # Insert cookie mới
    sqlite3 /sdcard/Download/Cookies.db "INSERT INTO cookies (creation_utc, host_key, name, value, path, expires_utc, is_secure, is_httponly, last_access_utc, has_expires, is_persistent, priority, encrypted_value, samesite, source_scheme, source_port, is_same_party) VALUES (strftime('%s','now')*1000000, '.roblox.com', '.ROBLOSECURITY', '${ESCAPED}', '/', 0, 1, 1, strftime('%s','now')*1000000, 1, 1, 1, '', -1, 0, -1, 0);" 2>/dev/null
    
    # Kiểm tra
    COUNT=$(sqlite3 /sdcard/Download/Cookies.db "SELECT COUNT(*) FROM cookies WHERE name='.ROBLOSECURITY';" 2>/dev/null)
    if [ "$COUNT" = "0" ]; then
        echo -e "${RED}❌ Cookie không được ghi!${NC}"
        rm -f /sdcard/Download/Cookies.db
        return 1
    fi
    echo -e "${GREEN}✅ Đã ghi $COUNT records${NC}"
    
    # Copy vào app_webview
    echo "📋 Copy vào Roblox..."
    su -c "cp /sdcard/Download/Cookies.db /data/data/com.roblox.client/app_webview/Default/Cookies" 2>/dev/null
    
    # Set permission
    su -c "chown 10105:10105 /data/data/com.roblox.client/app_webview/Default/Cookies" 2>/dev/null
    su -c "chmod 660 /data/data/com.roblox.client/app_webview/Default/Cookies" 2>/dev/null
    su -c "rm -f /data/data/com.roblox.client/app_webview/Default/Cookies-journal" 2>/dev/null
    
    # Xóa file tạm
    rm -f /sdcard/Download/Cookies.db
    
    echo -e "${GREEN}=========================================="
    echo "✅ ĐĂNG NHẬP THÀNH CÔNG!"
    echo -e "==========================================${NC}"
    return 0
}

# ==========================================
# MAIN
# ==========================================

# 1. Kiểm tra file cookie.txt
COOKIE=""
if [ -f "/sdcard/Download/cookie.txt" ]; then
    COOKIE_FROM_FILE=$(cat /sdcard/Download/cookie.txt | tr -d '\n\r')
    if [ -n "$COOKIE_FROM_FILE" ] && [ ${#COOKIE_FROM_FILE} -gt 100 ]; then
        echo -e "${GREEN}✅ Tìm thấy cookie trong /sdcard/Download/cookie.txt${NC}"
        echo -e "${YELLOW}💡 Cookie: ${COOKIE_FROM_FILE:0:30}...${NC}"
        echo ""
        echo -e "${YELLOW}Bạn có muốn dùng cookie này không? (y/n)${NC}"
        echo -n "➤ Chọn: "
        read -r use_existing
        if [[ "$use_existing" =~ ^[Yy]$ ]]; then
            COOKIE="$COOKIE_FROM_FILE"
        fi
    fi
fi

# 2. Nếu chưa có cookie, hỏi nhập
if [ -z "$COOKIE" ]; then
    input_cookie
    if [ $? -ne 0 ]; then
        exit 1
    fi
    COOKIE=$(cat /sdcard/Download/cookie.txt | tr -d '\n\r')
fi

# 3. Check cookie
check_cookie "$COOKIE"
if [ $? -ne 0 ]; then
    echo ""
    echo -e "${YELLOW}💡 Cookie không hợp lệ. Bạn có muốn nhập cookie mới? (y/n)${NC}"
    echo -n "➤ Chọn: "
    read -r retry
    if [[ "$retry" =~ ^[Yy]$ ]]; then
        input_cookie
        if [ $? -eq 0 ]; then
            COOKIE=$(cat /sdcard/Download/cookie.txt | tr -d '\n\r')
            check_cookie "$COOKIE"
            if [ $? -ne 0 ]; then
                echo -e "${RED}❌ Cookie vẫn không hợp lệ. Thoát.${NC}"
                exit 1
            fi
        else
            exit 1
        fi
    else
        exit 1
    fi
fi

# 4. Inject cookie
inject_cookie "$COOKIE"
if [ $? -ne 0 ]; then
    exit 1
fi

# 5. Mở Roblox
echo ""
echo -e "${YELLOW}🚀 MỞ ROBLOX...${NC}"
su -c "am force-stop com.roblox.client" 2>/dev/null
sleep 2
su -c "monkey -p com.roblox.client -c android.intent.category.LAUNCHER 1" 2>/dev/null

echo ""
echo -e "${BLUE}📌 Đợi 10-15 giây để Roblox load${NC}"
echo -e "${BLUE}   Nếu vẫn ở màn hình đăng nhập:${NC}"
echo -e "${BLUE}   1. Vào Settings > Apps > Roblox > Force Stop${NC}"
echo -e "${BLUE}   2. Mở lại Roblox${NC}"
EOF

chmod +x ~/roblox_login.sh
