change_account() {
    log "🔄 Đang đổi account: $USERNAME"
    
    local msg="🔄 **ĐANG ĐỔI ACCOUNT**\n"
    msg+="👤 Từ: **$USERNAME**\n"
    msg+="💰 Beli: $BELI\n"
    msg+="📈 Level: $LEVEL\n"
    msg+="⏰ Thời gian: $(date '+%H:%M:%S')"
    send_discord_webhook "🔄 ĐỔI ACCOUNT" "$msg" 16711680
    
    su -c "am force-stop $PACKAGE" 2>/dev/null
    sleep 3
    
    bash <(curl -s https://raw.githubusercontent.com/Nguyensama666/Tool/refs/heads/main/Cookie%20login?$(date +%s))
    
    rm -f "$CHARACTER_FILE" 2>/dev/null
    rm -f "$HEARTBEAT_FILE" 2>/dev/null
    
    log "⏳ Chờ 60 giây để game load..."
    sleep 60
    
    capture_screen
}

# ============================================================
#   REJOIN GAME
# ============================================================

rejoin_game() {
    local reason="$1"
    log "🔄 Rejoin Game... Lý do: $reason"
    
    send_discord_webhook "🔄 Rejoin Game" "Lý do: **$reason**" 16711680

    su -c "am force-stop $PACKAGE" 2>/dev/null
    sleep 3

    rm -f "$HEARTBEAT_FILE" 2>/dev/null

    su -c "am start -a android.intent.action.VIEW -d 'roblox://placeId=$PLACE_ID' -f 0x10008000" 2>/dev/null

    LAST_RESTART_TIME=$(date +%s)
    log "⏳ Chờ $WAIT_AFTER_LAUNCH giây để vào game..."
    
    capture_screen
    
    sleep $WAIT_AFTER_LAUNCH
}

