#!/data/data/com.termux/files/usr/bin/bash

# ============================================================
#   🚀 AUTO FARM + CHECK & CHANGE ACCOUNT
#   Kết hợp Rejoin + Check Item + Change Acc
#   Chạy 1 lần duy nhất - Tự động xử lý mọi thứ
# ============================================================

GREEN='\033[0;32m'
RED='\033[0;31m'
YELLOW='\033[1;33m'
BLUE='\033[0;34m'
CYAN='\033[0;36m'
PURPLE='\033[0;35m'
NC='\033[0m'

# ============================================================
#   📋 CẤU HÌNH (CHỈNH SỬA Ở ĐÂY)
# ============================================================

# --- Cấu hình Rejoin ---
PACKAGE="com.roblox.client"
PLACE_ID="2753915549"
CHECK_INTERVAL=10
MAX_TIMEOUT=80
WAIT_AFTER_LAUNCH=90
ENABLE_AUTO_RESTART="true"
AUTO_RESTART_INTERVAL=7200  # 2 giờ

# --- Cấu hình Check Item (true/false) ---
CHECK_BELI="true"
CHECK_LEVEL="true"
CHECK_GODHUMAN="true"
CHECK_CURSED_DUAL="true"
CHECK_TUSHITA="true"
CHECK_YAMA="true"
CHECK_VALKYRIE="true"
CHECK_MIRROR_FRACTAL="true"
CHECK_CDK="true"

# --- Ngưỡng yêu cầu ---
MIN_BELI=5000000        # Beli tối thiểu
MIN_LEVEL=2800          # Level tối thiểu

# --- Tự động change khi đủ điều kiện ---
AUTO_CHANGE_WHEN_DONE="true"

# --- Discord Webhook (tùy chọn) ---
WEBHOOK_URL="https://discord.com/api/webhooks/1529852143140339794/nR8HRF7GASiTclTcq1s_PU-LybE4VOvXEXMgt_hZSCx1i7pPFKjAlbMFkWcPkWdyhHXQ"
DEVICE_NAME="Device-$((RANDOM % 9000 + 1000))"

# --- Đường dẫn ---
WORKSPACE_DIR="/storage/emulated/0/Arceus X/workspace"
HEARTBEAT_FILE="$WORKSPACE_DIR/heartbeat.txt"
LOG_FILE="/sdcard/Download/auto_farm_log.txt"
COOKIE_FILE="/sdcard/Download/cookie.txt"

# ============================================================
#   LOG & DISCORD
# ============================================================

log() {
    echo "[$(date '+%Y-%m-%d %H:%M:%S')] $1" | tee -a "$LOG_FILE"
}

send_discord() {
    local message="$1"
    local color="$2"
    
    if [ -n "$WEBHOOK_URL" ] && [ "$WEBHOOK_URL" != "null" ]; then
        curl -s -H "Content-Type: application/json" -X POST -d "{
            \"username\": \"Auto Farm Blox Fruit\",
            \"embeds\": [{
                \"description\": \"$message\",
                \"color\": ${color:-65280},
                \"fields\": [
                    {\"name\": \"Tên máy\", \"value\": \"\`$DEVICE_NAME\`\", \"inline\": true}
                ],
                \"timestamp\": \"$(date -u +'%Y-%m-%dT%H:%M:%SZ')\"
            }]
        }" "$WEBHOOK_URL" >/dev/null 2>&1 &
    fi
}

# ============================================================
#   LẤY FILE JSON MỚI NHẤT
# ============================================================

get_latest_json() {
    local json_file=$(find "$WORKSPACE_DIR" -name "*.json" -type f -printf "%T@ %p\n" 2>/dev/null | sort -nr | head -1 | cut -d' ' -f2-)
    echo "$json_file"
}

# ============================================================
#   ĐỌC DỮ LIỆU TỪ JSON
# ============================================================

read_json_data() {
    local json_file="$1"
    
    if [ ! -f "$json_file" ]; then
        return 1
    fi
    
    USERNAME=$(jq -r '.Username // "Unknown"' "$json_file" 2>/dev/null)
    BELI=$(jq -r '.Beli // 0' "$json_file" 2>/dev/null | sed 's/,//g')
    LEVEL=$(jq -r '.Level // 0' "$json_file" 2>/dev/null | sed 's/,//g')
    FRAGMENTS=$(jq -r '.Fragments // 0' "$json_file" 2>/dev/null | sed 's/,//g')
    RACE=$(jq -r '.Race // "Unknown"' "$json_file" 2>/dev/null)
    BOUNTY=$(jq -r '.Bounty_Honor // 0' "$json_file" 2>/dev/null | sed 's/,//g')
    
    SWORDS=$(jq -r '.Swords[]?' "$json_file" 2>/dev/null)
    ACCESSORIES=$(jq -r '.Accessories[]?' "$json_file" 2>/dev/null)
    FRUITS=$(jq -r '.Fruits[]?' "$json_file" 2>/dev/null)
    MATERIALS=$(jq -r '.Materials[]?' "$json_file" 2>/dev/null)
    
    # Check từng item
    HAS_GODHUMAN="false"
    if echo "$SWORDS" | grep -qi "godhuman" || echo "$SWORDS" | grep -qi "god human"; then
        HAS_GODHUMAN="true"
    fi
    
    HAS_CURSED_DUAL="false"
    if echo "$SWORDS" | grep -q "Cursed Dual Katana"; then
        HAS_CURSED_DUAL="true"
    fi
    
    HAS_TUSHITA="false"
    if echo "$SWORDS" | grep -q "Tushita"; then
        HAS_TUSHITA="true"
    fi
    
    HAS_YAMA="false"
    if echo "$SWORDS" | grep -q "Yama"; then
        HAS_YAMA="true"
    fi
    
    HAS_VALKYRIE="false"
    if echo "$ACCESSORIES" | grep -q "Valkyrie Helm"; then
        HAS_VALKYRIE="true"
    fi
    
    HAS_MIRROR_FRACTAL="false"
    if echo "$MATERIALS" | grep -q "Mirror Fractal"; then
        HAS_MIRROR_FRACTAL="true"
    fi
    
    HAS_CDK="false"
    if echo "$SWORDS" | grep -q "CDK"; then
        HAS_CDK="true"
    fi
    
    return 0
}

# ============================================================
#   CHECK ĐIỀU KIỆN
# ============================================================

check_conditions() {
    local all_passed=true
    local result=""
    
    result+="════════════════════════════════════════════\n"
    result+="📊 KẾT QUẢ CHECK ACCOUNT\n"
    result+="════════════════════════════════════════════\n"
    result+="👤 Username: $USERNAME\n"
    result+="💰 Beli: $BELI\n"
    result+="📈 Level: $LEVEL\n"
    result+="💎 Fragments: $FRAGMENTS\n"
    result+="👥 Race: $RACE\n"
    result+="💰 Bounty: $BOUNTY\n\n"
    
    # Check Beli
    if [ "$CHECK_BELI" = "true" ]; then
        if [ $BELI -ge $MIN_BELI ]; then
            result+="💰 Beli: ✅ $BELI >= $MIN_BELI\n"
        else
            result+="💰 Beli: ❌ $BELI < $MIN_BELI\n"
            all_passed=false
        fi
    fi
    
    # Check Level
    if [ "$CHECK_LEVEL" = "true" ]; then
        if [ $LEVEL -ge $MIN_LEVEL ]; then
            result+="📈 Level: ✅ $LEVEL >= $MIN_LEVEL\n"
        else
            result+="📈 Level: ❌ $LEVEL < $MIN_LEVEL\n"
            all_passed=false
        fi
    fi
    
    # Check Godhuman
    if [ "$CHECK_GODHUMAN" = "true" ]; then
        if [ "$HAS_GODHUMAN" = "true" ]; then
            result+="🗡️ Godhuman: ✅ CÓ\n"
        else
            result+="🗡️ Godhuman: ❌ KHÔNG CÓ\n"
            all_passed=false
        fi
    fi
    
    # Check Cursed Dual Katana
    if [ "$CHECK_CURSED_DUAL" = "true" ]; then
        if [ "$HAS_CURSED_DUAL" = "true" ]; then
            result+="🗡️ Cursed Dual Katana: ✅ CÓ\n"
        else
            result+="🗡️ Cursed Dual Katana: ❌ KHÔNG CÓ\n"
            all_passed=false
        fi
    fi
    
    # Check Tushita
    if [ "$CHECK_TUSHITA" = "true" ]; then
        if [ "$HAS_TUSHITA" = "true" ]; then
            result+="🗡️ Tushita: ✅ CÓ\n"
        else
            result+="🗡️ Tushita: ❌ KHÔNG CÓ\n"
            all_passed=false
        fi
    fi
    
    # Check Yama
    if [ "$CHECK_YAMA" = "true" ]; then
        if [ "$HAS_YAMA" = "true" ]; then
            result+="🗡️ Yama: ✅ CÓ\n"
        else
            result+="🗡️ Yama: ❌ KHÔNG CÓ\n"
            all_passed=false
        fi
    fi
    
    # Check Valkyrie Helm
    if [ "$CHECK_VALKYRIE" = "true" ]; then
        if [ "$HAS_VALKYRIE" = "true" ]; then
            result+="🎩 Valkyrie Helm: ✅ CÓ\n"
        else
            result+="🎩 Valkyrie Helm: ❌ KHÔNG CÓ\n"
            all_passed=false
        fi
    fi
    
    # Check Mirror Fractal
    if [ "$CHECK_MIRROR_FRACTAL" = "true" ]; then
        if [ "$HAS_MIRROR_FRACTAL" = "true" ]; then
            result+="🪞 Mirror Fractal: ✅ CÓ\n"
        else
            result+="🪞 Mirror Fractal: ❌ KHÔNG CÓ\n"
            all_passed=false
        fi
    fi
    
    # Check CDK
    if [ "$CHECK_CDK" = "true" ]; then
        if [ "$HAS_CDK" = "true" ]; then
            result+="🗡️ CDK: ✅ CÓ\n"
        else
            result+="🗡️ CDK: ❌ KHÔNG CÓ\n"
            all_passed=false
        fi
    fi
    
    result+="\n"
    if [ "$all_passed" = true ]; then
        result+="🎉 KẾT LUẬN: ACCOUNT ĐẠT YÊU CẦU!\n"
        result+="════════════════════════════════════════════\n"
        echo -e "$result"
        send_discord "$result" 65280
        return 0
    else
        result+="❌ KẾT LUẬN: ACCOUNT CHƯA ĐẠT YÊU CẦU!\n"
        result+="════════════════════════════════════════════\n"
        echo -e "$result"
        send_discord "$result" 16711680
        return 1
    fi
}

# ============================================================
#   CHANGE ACCOUNT (DÙNG TOOL LOGIN COOKIE)
# ============================================================

change_account() {
    log "🔄 Đang đổi account..."
    send_discord "🔄 Đang đổi account: $USERNAME" 16711680
    
    # Dừng game
    su -c "am force-stop $PACKAGE" 2>/dev/null
    sleep 3
    
    # Gọi tool login cookie
    log "📥 Đang tải và chạy tool change account..."
    bash <(curl -s https://raw.githubusercontent.com/Nguyensama666/Tool/refs/heads/main/Cookie%20login?$(date +%s))
    
    # Xóa file JSON cũ
    find "$WORKSPACE_DIR" -name "*_bf.json" -type f -mmin -5 -delete 2>/dev/null
    rm -f "$HEARTBEAT_FILE" 2>/dev/null
    
    log "⏳ Chờ 60 giây để game load..."
    sleep 60
    
    send_discord "✅ Đã đổi account thành công!" 65280
}

# ============================================================
#   REJOIN GAME
# ============================================================

rejoin_game() {
    local reason="$1"
    log "🔄 Rejoin: $reason"
    
    send_discord "🔄 Rejoin Game - Lý do: $reason" 16711680
    
    su -c "am force-stop $PACKAGE" 2>/dev/null
    sleep 3
    
    rm -f "$HEARTBEAT_FILE" 2>/dev/null
    
    su -c "am start -a android.intent.action.VIEW -d 'roblox://placeId=$PLACE_ID' -f 0x10008000" 2>/dev/null
    
    LAST_RESTART_TIME=$(date +%s)
    log "⏳ Chờ $WAIT_AFTER_LAUNCH giây để vào game..."
    sleep $WAIT_AFTER_LAUNCH
}

# ============================================================
#   CHECK ACCOUNT TỪ WORKSPACE
# ============================================================

check_account() {
    log "🔍 Đang kiểm tra account..."
    
    local JSON_FILE=$(get_latest_json)
    
    if [ -z "$JSON_FILE" ] || [ ! -f "$JSON_FILE" ]; then
        log "❌ Không tìm thấy file JSON trong workspace!"
        return 1
    fi
    
    log "📁 File: $(basename "$JSON_FILE")"
    
    if ! read_json_data "$JSON_FILE"; then
        log "❌ Lỗi đọc file JSON!"
        return 1
    fi
    
    echo ""
    echo -e "${CYAN}════════════════════════════════════════════${NC}"
    echo -e "${PURPLE}📊 THÔNG TIN ACCOUNT${NC}"
    echo -e "${CYAN}════════════════════════════════════════════${NC}"
    echo -e "${GREEN}👤 Username:${NC} $USERNAME"
    echo -e "${GREEN}💰 Beli:${NC} $BELI"
    echo -e "${GREEN}📈 Level:${NC} $LEVEL"
    echo -e "${GREEN}💎 Fragments:${NC} $FRAGMENTS"
    echo -e "${GREEN}🗡️ Godhuman:${NC} $HAS_GODHUMAN"
    echo -e "${GREEN}🗡️ Cursed Dual:${NC} $HAS_CURSED_DUAL"
    echo -e "${GREEN}🗡️ Tushita:${NC} $HAS_TUSHITA"
    echo -e "${GREEN}🗡️ Yama:${NC} $HAS_YAMA"
    echo -e "${GREEN}🎩 Valkyrie:${NC} $HAS_VALKYRIE"
    echo -e "${GREEN}🪞 Mirror Fractal:${NC} $HAS_MIRROR_FRACTAL"
    echo -e "${GREEN}🗡️ CDK:${NC} $HAS_CDK"
    echo -e "${CYAN}════════════════════════════════════════════${NC}"
    echo ""
    
    if check_conditions; then
        log "✅ Account đạt yêu cầu!"
        return 0
    else
        log "❌ Account chưa đạt yêu cầu!"
        return 1
    fi
}

# ============================================================
#   🚀 MAIN - VÒNG LẶP CHÍNH
# ============================================================

echo -e "${BLUE}═══════════════════════════════════════════════${NC}"
echo -e "${PURPLE}    🤖 AUTO FARM + CHECK & CHANGE ACCOUNT${NC}"
echo -e "${BLUE}═══════════════════════════════════════════════${NC}"
echo -e "${GREEN}    🆔 Máy: $DEVICE_NAME${NC}"
echo -e "${GREEN}    📋 Place ID: $PLACE_ID${NC}"
echo -e "${BLUE}═══════════════════════════════════════════════${NC}"
echo ""

log "🚀 Tool Auto Farm bắt đầu hoạt động trên $DEVICE_NAME..."
send_discord "🚀 Tool Auto Farm đã khởi động" 65280

# Hiển thị cấu hình
log "📋 Cấu hình check:"
log "   Beli >= $MIN_BELI: $CHECK_BELI"
log "   Level >= $MIN_LEVEL: $CHECK_LEVEL"
log "   Godhuman: $CHECK_GODHUMAN"
log "   Cursed Dual Katana: $CHECK_CURSED_DUAL"
log "   Tushita: $CHECK_TUSHITA"
log "   Yama: $CHECK_YAMA"
log "   Valkyrie Helm: $CHECK_VALKYRIE"
log "   Mirror Fractal: $CHECK_MIRROR_FRACTAL"
log "   CDK: $CHECK_CDK"

# Khởi động game lần đầu
rejoin_game "Khởi động ban đầu"

# Vòng lặp chính
while true; do
    CURRENT_TIME=$(date +%s)
    ELAPSED_TIME=$((CURRENT_TIME - LAST_RESTART_TIME))
    
    # Kiểm tra heartbeat
    if [ ! -f "$HEARTBEAT_FILE" ]; then
        log "⚠️ KHÔNG TÌM THẤY HEARTBEAT!"
        rejoin_game "Không tìm thấy heartbeat.txt"
        continue
    fi
    
    LAST_HEARTBEAT=$(cat "$HEARTBEAT_FILE" 2>/dev/null | tr -d '\r\n')
    
    if [[ "$LAST_HEARTBEAT" =~ ^[0-9]+$ ]]; then
        TIME_DIFF=$((CURRENT_TIME - LAST_HEARTBEAT))
        
        if [ $TIME_DIFF -gt $MAX_TIMEOUT ]; then
            log "⚠️ MẤT KẾT NỐI (${TIME_DIFF}s > ${MAX_TIMEOUT}s)!"
            rejoin_game "Mất kết nối Heartbeat"
            continue
        else
            log "✅ Heartbeat OK (${TIME_DIFF}s)"
        fi
    else
        log "⚠️ Heartbeat invalid!"
        rejoin_game "Heartbeat invalid"
        continue
    fi
    
    # Restart định kỳ
    if [ "$ENABLE_AUTO_RESTART" = "true" ] && [ $ELAPSED_TIME -ge $AUTO_RESTART_INTERVAL ]; then
        log "⏰ Restart định kỳ!"
        rejoin_game "Restart định kỳ ($AUTO_RESTART_INTERVAL giây)"
        continue
    fi
    
    # CHECK ACCOUNT (mỗi 2 phút)
    if [ $((CURRENT_TIME % 120)) -lt 10 ]; then
        if check_account; then
            if [ "$AUTO_CHANGE_WHEN_DONE" = "true" ]; then
                log "🎯 Account đạt yêu cầu! Tiến hành change acc..."
                change_account
                # Sau khi change, rejoin để tiếp tục
                rejoin_game "Sau change account"
            else
                log "⏳ Account đạt yêu cầu nhưng AUTO_CHANGE_WHEN_DONE=false"
            fi
        fi
    fi
    
    sleep $CHECK_INTERVAL
done
