#!/bin/bash
# ============================================================
# AUTO REJOIN ROBLOX BLOX FRUITS - FULL LOGIC (2026)
# ============================================================

# ============================================================
# ⚙️ PHẦN CẤU HÌNH (BẠN TỰ CHỈNH TẠI ĐÂY)
# ============================================================

PACKAGE="com.roblox.client"
PLACE_ID="2753915549"             # Place ID Blox Fruits

# 1. Tần suất kiểm tra trạng thái game (tính bằng giây)
CHECK_INTERVAL=10

# 2. Tự động Restart định kỳ giải phóng RAM (giây) - Mặc định: 10800s = 3 tiếng
ENABLE_AUTO_RESTART="true"
AUTO_RESTART_INTERVAL=10800

# 3. Thời gian chờ Roblox load vào lại game trước khi tiếp tục kiểm tra (giây)
WAIT_AFTER_LAUNCH=30

# ============================================================
# 🛠️ CÁC HÀM XỬ LÝ VÀ KIỂM TRA LOGIC
# ============================================================

DOWNLOAD="/sdcard/Download"
LOG_FILE="$DOWNLOAD/rejoin_log.txt"
LAST_RESTART_TIME=$(date +%s)

log() {
    echo "[$(date '+%Y-%m-%d %H:%M:%S')] $1" | tee -a "$LOG_FILE"
}

# Hàm kích hoạt mở lại Roblox vào thẳng Blox Fruits
rejoin_game() {
    log "🔄 Đang khởi động lại Roblox vào Blox Fruits (PlaceID: $PLACE_ID)..."
    
    # 1. Tắt hoàn toàn ứng dụng Roblox
    su -c "am force-stop $PACKAGE" 2>/dev/null
    sleep 3

    # 2. Mở lại game Blox Fruits qua URL Scheme
    su -c "am start -a android.intent.action.VIEW -d 'roblox://placeId=$PLACE_ID' -f 0x10008000" 2>/dev/null

    # 3. Cập nhật lại mốc thời gian restart
    LAST_RESTART_TIME=$(date +%s)

    log "⏳ Đã phát lệnh vào game. Chờ $WAIT_AFTER_LAUNCH giây để load..."
    sleep $WAIT_AFTER_LAUNCH
}

# 1️⃣ Kiểm tra Roblox có đang chạy ngầm không (Check Process)
is_roblox_running() {
    PID=$(su -c "pidof $PACKAGE" 2>/dev/null)
    if [ -n "$PID" ]; then
        return 0 # Đang chạy
    else
        return 1 # Đã bị tắt hoặc sập app
    fi
}

# 2️⃣ Kiểm tra Log Roblox xem có từ khóa Kick / Disconnect / Error Code không
is_roblox_disconnected_log() {
    LOG_DIR="/data/data/$PACKAGE/files/logs"
    LATEST_LOG=$(su -c "ls -t $LOG_DIR/*.log 2>/dev/null | head -n 1")

    if [ -n "$LATEST_LOG" ]; then
        # Đọc 30 dòng cuối của log mới nhất
        CHECK_KICK=$(su -c "tail -n 30 '$LATEST_LOG' | grep -iE 'disconnect|kicked|Error Code|Connection Lost|Security kick'")
        if [ -n "$CHECK_KICK" ]; then
            return 0 # Phát hiện bị ngắt kết nối trong Log
        fi
    fi
    return 1 # Bình thường
}

# 3️⃣ Kiểm tra lưu lượng mạng xem game có bị đứng (Idle) do bị Kick ra màn hình thông báo không
is_network_idle() {
    UID_ROBLOX=$(su -c "stat -c %u /data/data/$PACKAGE" 2>/dev/null)
    
    if [ -n "$UID_ROBLOX" ]; then
        BYTES_1=$(su -c "cat /proc/net/xt_qtaguid/stats 2>/dev/null | grep '$UID_ROBLOX' | awk '{sum+=\$6} END {print sum}'")
        sleep 3
        BYTES_2=$(su -c "cat /proc/net/xt_qtaguid/stats 2>/dev/null | grep '$UID_ROBLOX' | awk '{sum+=\$6} END {print sum}'")
        
        # Nếu BYTES rỗng thì bỏ qua
        if [ -z "$BYTES_1" ] || [ -z "$BYTES_2" ]; then
            return 1
        fi

        DIFF=$((BYTES_2 - BYTES_1))
        
        # Trong 3 giây mà truyền nhận dưới 300 bytes => Game bị đứng ở màn hình thông báo Kick
        if [ $DIFF -lt 300 ]; then
            return 0 # Mạng đứng
        fi
    fi
    return 1 # Mạng hoạt động bình thường
}

# ============================================================
# 🚀 VÒNG LẶP CHÍNH (MAIN LOOP)
# ============================================================

echo "═══════════════════════════════════════════════"
echo "    🤖 AUTO REJOIN BLOX FRUITS (FULL LOGIC)"
echo "═══════════════════════════════════════════════"
log "🚀 Tool Auto Rejoin bắt đầu hoạt động..."

# Tự động vào game lần đầu tiên khi chạy script
rejoin_game

while true; do
    CURRENT_TIME=$(date +%s)
    ELAPSED_TIME=$((CURRENT_TIME - LAST_RESTART_TIME))

    # 🔴 CHECK 1: Kiểm tra xem app Roblox có bị văng / sập không
    if ! is_roblox_running; then
        log "⚠️ MẤT TIẾN TRÌNH: Roblox đã bị đóng hoặc sập app!"
        rejoin_game
        continue
    fi

    # 🔴 CHECK 2: Kiểm tra từ khóa Kick / Disconnect trong Log hệ thống
    if is_roblox_disconnected_log; then
        log "⚠️ PHÁT HIỆN KICK/DISCONNECT: Tìm thấy thông báo ngắt kết nối trong Log Roblox!"
        rejoin_game
        continue
    fi

    # 🔴 CHECK 3: Kiểm tra lưu lượng mạng ngắt kết nối (Mạng đứng)
    if is_network_idle; then
        log "⚠️ MẠNG ĐỨNG: Lưu lượng mạng về ~0, phát hiện đang ở màn hình báo lỗi Kick!"
        rejoin_game
        continue
    fi

    # 🔴 CHECK 4: Kiểm tra hẹn giờ Restart định kỳ (Chống tràn RAM / Lag)
    if [ "$ENABLE_AUTO_RESTART" = "true" ] && [ $ELAPSED_TIME -ge $AUTO_RESTART_INTERVAL ]; then
        log "⏰ RESTART ĐỊNH KỲ: Đã đủ $AUTO_RESTART_INTERVAL giây treo game. Tiến hành khởi động lại!"
        rejoin_game
        continue
    fi

    # Đợi trước lần kiểm tra tiếp theo
    sleep $CHECK_INTERVAL
done
