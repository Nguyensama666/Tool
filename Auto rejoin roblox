#!/bin/bash
# ============================================================
# AUTO REJOIN VIA ARCEUS X WORKSPACE HEARTBEAT
# ============================================================

PACKAGE="com.roblox.client"
PLACE_ID="2753915549"

# Đường dẫn Workspace chính xác của Arceus X
HEARTBEAT_FILE="/storage/emulated/0/Arceus X/workspace/heartbeat.txt"

# Cấu hình thời gian
CHECK_INTERVAL=10         # Tần suất kiểm tra (giây)
MAX_TIMEOUT=30            # Quá 30s không gửi heartbeat sẽ Rejoin
WAIT_AFTER_LAUNCH=90      # Thời gian chờ game load khi khởi động

ENABLE_AUTO_RESTART="true"
AUTO_RESTART_INTERVAL=3600 # Restart định kỳ giải phóng RAM (1 tiếng)

DOWNLOAD="/sdcard/Download"
LOG_FILE="$DOWNLOAD/rejoin_log.txt"
LAST_RESTART_TIME=$(date +%s)

log() {
    echo "[$(date '+%Y-%m-%d %H:%M:%S')] $1" | tee -a "$LOG_FILE"
}

rejoin_game() {
    log "🔄 Tiến hành khởi động lại Roblox vào Blox Fruits (PlaceID: $PLACE_ID)..."
    
    # Force stop Roblox
    su -c "am force-stop $PACKAGE" 2>/dev/null
    sleep 3

    # Xóa file heartbeat cũ để tránh nhận nhầm thời gian cũ
    rm -f "$HEARTBEAT_FILE" 2>/dev/null

    # Mở lại Blox Fruits
    su -c "am start -a android.intent.action.VIEW -d 'roblox://placeId=$PLACE_ID' -f 0x10008000" 2>/dev/null

    LAST_RESTART_TIME=$(date +%s)
    log "⏳ Đã phát lệnh. Chờ $WAIT_AFTER_LAUNCH giây để vào lại game..."
    sleep $WAIT_AFTER_LAUNCH
}

# ============================================================
# 🚀 VÒNG LẶP CHÍNH
# ============================================================

echo "═══════════════════════════════════════════════"
echo "    🤖 AUTO REJOIN BLOX FRUITS (ARCEUS X)"
echo "═══════════════════════════════════════════════"
log "🚀 Tool Auto Rejoin bắt đầu hoạt động..."

rejoin_game

while true; do
    CURRENT_TIME=$(date +%s)
    ELAPSED_TIME=$((CURRENT_TIME - LAST_RESTART_TIME))

    # 1. Kiểm tra xem file heartbeat có tồn tại không
    if [ ! -f "$HEARTBEAT_FILE" ]; then
        log "⚠️ KHÔNG TÌM THẤY HEARTBEAT: Game/Script chưa tạo file heartbeat.txt!"
        rejoin_game
        continue
    fi

    # 2. Đọc mốc thời gian từ file heartbeat
    LAST_HEARTBEAT=$(cat "$HEARTBEAT_FILE" 2>/dev/null | tr -d '\r\n')

    # Kiểm tra dữ liệu đọc được có phải là số không
    if [[ "$LAST_HEARTBEAT" =~ ^[0-9]+$ ]]; then
        TIME_DIFF=$((CURRENT_TIME - LAST_HEARTBEAT))

        if [ $TIME_DIFF -gt $MAX_TIMEOUT ]; then
            log "⚠️ MẤT KẾT NỐI/DISCONNECT: Arceus X ngừng gửi tín hiệu ${TIME_DIFF}s (Quá giới hạn ${MAX_TIMEOUT}s)!"
            rejoin_game
            continue
        else
            log "✅ Game bình thường (Heartbeat gửi cách đây ${TIME_DIFF}s)."
        fi
    else
        log "⚠️ LỖI ĐỌC FILE: Dữ liệu heartbeat không hợp lệ."
        rejoin_game
        continue
    fi

    # 3. Tự động Restart định kỳ (Chống tràn RAM / Lag)
    if [ "$ENABLE_AUTO_RESTART" = "true" ] && [ $ELAPSED_TIME -ge $AUTO_RESTART_INTERVAL ]; then
        log "⏰ RESTART ĐỊNH KỲ: Đã đủ $AUTO_RESTART_INTERVAL giây treo game. Tiến hành khởi động lại!"
        rejoin_game
        continue
    fi

    sleep $CHECK_INTERVAL
done
