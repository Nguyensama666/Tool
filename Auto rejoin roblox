#!/bin/bash
# ============================================================
# AUTO REJOIN VIA ARCEUS X WORKSPACE HEARTBEAT (FIXED SCREENSHOT)
# ============================================================

PACKAGE="com.roblox.client"
PLACE_ID="2753915549"

WEBHOOK_URL="https://discord.com/api/webhooks/1529852143140339794/nR8HRF7GASiTclTcq1s_PU-LybE4VOvXEXMgt_hZSCx1i7pPFKjAlbMFkWcPkWdyhHXQ"
DEVICE_NAME="Device-$((RANDOM % 9000 + 1000))"

HEARTBEAT_FILE="/storage/emulated/0/Arceus X/workspace/heartbeat.txt"

CHECK_INTERVAL=10
MAX_TIMEOUT=80
WAIT_AFTER_LAUNCH=90

ENABLE_AUTO_RESTART="true"
AUTO_RESTART_INTERVAL=3600

LOG_FILE="/sdcard/Download/rejoin_log.txt"
LAST_RESTART_TIME=$(date +%s)
CAPTURE_PID="" # Biến lưu PID của luồng chụp ảnh

log() {
    echo "[$(date '+%Y-%m-%d %H:%M:%S')] $1" | tee -a "$LOG_FILE"
}

send_discord_webhook() {
    local title="$1"
    local message="$2"
    local color="$3"

    su -c "curl -s -H 'Content-Type: application/json' -X POST -d '{
        \"username\": \"Roblox Auto Rejoiner\",
        \"embeds\": [{
            \"title\": \"$title\",
            \"description\": \"$message\",
            \"color\": $color,
            \"fields\": [
                {\"name\": \"Tên máy\", \"value\": \"\`$DEVICE_NAME\`\", \"inline\": true},
                {\"name\": \"Place ID\", \"value\": \"\`$PLACE_ID\`\", \"inline\": true}
            ],
            \"timestamp\": \"$(date -u +'%Y-%m-%dT%H:%M:%SZ')\"
        }]
    }' '$WEBHOOK_URL'" >/dev/null 2>&1 &
}

# Hàm chụp ảnh màn hình đã tối ưu xử lý tiến trình
capture_screen_after_delay() {
    # Dọn dẹp tiến trình chụp ảnh cũ nếu còn sống
    if [ -n "$CAPTURE_PID" ] && kill -0 "$CAPTURE_PID" 2>/dev/null; then
        kill -9 "$CAPTURE_PID" 2>/dev/null
    fi

    (
        sleep 300
        log "📸 Tiến hành chụp màn hình sau 5 phút..."
        
        # Tạo tên file ảnh độc lập theo thời gian để tránh tranh chấp file
        local TIMESTAMP=$(date +%s)
        local SHOT_PATH="/data/local/tmp/screen_${TIMESTAMP}.png"

        # Chụp màn hình vào thư mục tạm hệ thống /data/local/tmp
        su -c "screencap -p $SHOT_PATH" 2>/dev/null

        if su -c "test -f $SHOT_PATH"; then
            # Gửi file ảnh qua Discord Webhook
            su -c "curl -s -X POST '$WEBHOOK_URL' \
                -F 'payload_json={\"content\": \"📸 **[ MÀN HÌNH SAU 5 PHÚT ]** - Máy: \`$DEVICE_NAME\`\"}' \
                -F 'file=@$SHOT_PATH'" >/dev/null 2>&1
            
            # Dọn dẹp file ảnh ngay sau khi gửi
            su -c "rm -f $SHOT_PATH" 2>/dev/null
            log "✅ Đã gửi screenshot lên Discord thành công."
        else
            log "❌ Không thể chụp ảnh màn hình (Lỗi screencap)."
        fi
    ) &
    
    # Lưu lại PID của tiến trình vừa tạo
    CAPTURE_PID=$!
}

rejoin_game() {
    local reason="$1"
    log "🔄 Tiến hành khởi động lại Roblox... Lý do: $reason"
    
    send_discord_webhook "🔄 Tiến hành Rejoin Game" "Lý do: **$reason**" 16711680

    su -c "am force-stop $PACKAGE" 2>/dev/null
    sleep 3

    rm -f "$HEARTBEAT_FILE" 2>/dev/null

    su -c "am start -a android.intent.action.VIEW -d 'roblox://placeId=$PLACE_ID' -f 0x10008000" 2>/dev/null

    LAST_RESTART_TIME=$(date +%s)
    log "⏳ Đã phát lệnh. Chờ $WAIT_AFTER_LAUNCH giây để vào lại game..."
    
    # Gọi hàm chụp ảnh
    capture_screen_after_delay
    
    sleep $WAIT_AFTER_LAUNCH
}

# ============================================================
# 🚀 VÒNG LẶP CHÍNH
# ============================================================

echo "═══════════════════════════════════════════════"
echo "    🤖 AUTO REJOIN BLOX FRUITS (ARCEUS X)"
echo "    🆔 Máy: $DEVICE_NAME"
echo "═══════════════════════════════════════════════"
log "🚀 Tool Auto Rejoin bắt đầu hoạt động trên $DEVICE_NAME..."

send_discord_webhook "🚀 Tool Auto Rejoin đã khởi động" "Bắt đầu giám sát game trên thiết bị." 65280

rejoin_game "Khởi động ban đầu"

while true; do
    CURRENT_TIME=$(date +%s)
    ELAPSED_TIME=$((CURRENT_TIME - LAST_RESTART_TIME))

    if [ ! -f "$HEARTBEAT_FILE" ]; then
        log "⚠️ KHÔNG TÌM THẤY HEARTBEAT: Game/Script chưa tạo file heartbeat.txt!"
        rejoin_game "Không tìm thấy file heartbeat.txt"
        continue
    fi

    LAST_HEARTBEAT=$(cat "$HEARTBEAT_FILE" 2>/dev/null | tr -d '\r\n')

    if [[ "$LAST_HEARTBEAT" =~ ^[0-9]+$ ]]; then
        TIME_DIFF=$((CURRENT_TIME - LAST_HEARTBEAT))

        if [ $TIME_DIFF -gt $MAX_TIMEOUT ]; then
            log "⚠️ MẤT KẾT NỐI: Arceus X ngừng gửi tín hiệu ${TIME_DIFF}s!"
            rejoin_game "Mất kết nối Heartbeat (${TIME_DIFF}s > ${MAX_TIMEOUT}s)"
            continue
        else
            log "✅ Game bình thường (Heartbeat gửi cách đây ${TIME_DIFF}s)."
        fi
    else
        log "⚠️ LỖI ĐỌC FILE: Dữ liệu heartbeat không hợp lệ."
        rejoin_game "Dữ liệu heartbeat bị lỗi/không hợp lệ"
        continue
    fi

    if [ "$ENABLE_AUTO_RESTART" = "true" ] && [ $ELAPSED_TIME -ge $AUTO_RESTART_INTERVAL ]; then
        log "⏰ RESTART ĐỊNH KỲ: Tiến hành khởi động lại!"
        rejoin_game "Restart định kỳ giải phóng RAM ($AUTO_RESTART_INTERVAL giây)"
        continue
    fi

    sleep $CHECK_INTERVAL
done
