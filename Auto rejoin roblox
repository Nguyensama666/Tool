#!/data/data/com.termux/files/usr/bin/bash

# ============================================================
#   🚀 AUTO REJOIN + CHECK & CHANGE ACCOUNT
#   Hỗ trợ file JSON có _bf trong tên
# ============================================================

GREEN='\033[0;32m'
RED='\033[0;31m'
YELLOW='\033[1;33m'
BLUE='\033[0;34m'
CYAN='\033[0;36m'
NC='\033[0m'

# ============================================================
#   📋 CẤU HÌNH
# ============================================================

PACKAGE="com.roblox.client"
PLACE_ID="2753915549"

WEBHOOK_URL="https://discord.com/api/webhooks/1529852143140339794/nR8HRF7GASiTclTcq1s_PU-LybE4VOvXEXMgt_hZSCx1i7pPFKjAlbMFkWcPkWdyhHXQ"
DEVICE_NAME="Device-$((RANDOM % 9000 + 1000))"

WORKSPACE_DIR="/storage/emulated/0/Arceus X/workspace"
HEARTBEAT_FILE="$WORKSPACE_DIR/heartbeat.txt"
CHARACTER_FILE="$WORKSPACE_DIR/character_name.txt"

CHECK_INTERVAL=10
MAX_TIMEOUT=80
WAIT_AFTER_LAUNCH=90

ENABLE_AUTO_RESTART="true"
AUTO_RESTART_INTERVAL=3600

LOG_FILE="/sdcard/Download/auto_farm_log.txt"
LAST_RESTART_TIME=$(date +%s)
CAPTURE_PID=""
LAST_WEBHOOK_TIME=0

# ============================================================
#   📋 CẤU HÌNH CHECK ITEM
# ============================================================

CHECK_BELI="true"
CHECK_LEVEL="true"
CHECK_GODHUMAN="true"
CHECK_CURSED_DUAL="true"
CHECK_TUSHITA="true"
CHECK_YAMA="true"
CHECK_VALKYRIE="true"
CHECK_MIRROR_FRACTAL="true"

MIN_BELI=500000
MIN_LEVEL=2800
AUTO_CHANGE_WHEN_DONE="true"

# ============================================================
#   LOG
# ============================================================

log() {
    echo "[$(date '+%Y-%m-%d %H:%M:%S')] $1" | tee -a "$LOG_FILE"
}

# ============================================================
#   DISCORD WEBHOOK
# ============================================================

send_discord_webhook() {
    local title="$1"
    local message="$2"
    local color="$3"

    su -c "curl -s -H 'Content-Type: application/json' -X POST -d '{
        \"username\": \"Auto Farm Blox Fruit\",
        \"embeds\": [{
            \"title\": \"$title\",
            \"description\": \"$message\",
            \"color\": $color,
            \"fields\": [
                {\"name\": \"Tên máy\", \"value\": \"\`$DEVICE_NAME\`\", \"inline\": true},
                {\"name\": \"Place ID\", \"value\": \"\`$PLACE_ID\`\", \"inline\": true}
            ],
            \"timestamp\": \"$(date -u +'%Y-%m-%dT%H:%M:%SZ')\"
        }]
    }' '$WEBHOOK_URL'" >/dev/null 2>&1 &
}

# ============================================================
#   CHỤP ẢNH SAU 5 PHÚT
# ============================================================

capture_screen() {
    # Dọn dẹp tiến trình chụp ảnh cũ
    if [ -n "$CAPTURE_PID" ] && kill -0 "$CAPTURE_PID" 2>/dev/null; then
        kill -9 "$CAPTURE_PID" 2>/dev/null
    fi

    (
        sleep 300
        log "📸 Chụp màn hình sau 5 phút..."
        
        local TIMESTAMP=$(date +%s)
        local SHOT_PATH="/data/local/tmp/screen_${TIMESTAMP}.png"

        su -c "screencap -p $SHOT_PATH" 2>/dev/null

        if su -c "test -f $SHOT_PATH"; then
            su -c "curl -s -X POST '$WEBHOOK_URL' \
                -F 'payload_json={\"content\": \"📸 **MÀN HÌNH SAU 5 PHÚT** - Máy: \`$DEVICE_NAME\`\"}' \
                -F 'file=@$SHOT_PATH'" >/dev/null 2>&1
            
            su -c "rm -f $SHOT_PATH" 2>/dev/null
            log "✅ Đã gửi screenshot lên Discord."
        else
            log "❌ Không thể chụp ảnh màn hình."
        fi
    ) &
    
    CAPTURE_PID=$!
}

# ============================================================
#   LẤY TÊN NHÂN VẬT ĐANG CÀY
# ============================================================

get_current_character() {
    if [ ! -f "$CHARACTER_FILE" ]; then
        echo ""
        return 1
    fi
    
    local file_time=$(stat -c %Y "$CHARACTER_FILE" 2>/dev/null)
    local current_time=$(date +%s)
    local time_diff=$((current_time - file_time))
    
    if [ $time_diff -gt 120 ]; then
        echo ""
        return 1
    fi
    
    local name=$(cat "$CHARACTER_FILE" 2>/dev/null | tr -d '\n\r')
    echo "$name"
    return 0
}

# ============================================================
#   TÌM FILE JSON CỦA NHÂN VẬT ĐÓ
# ============================================================

find_character_json() {
    local character_name="$1"
    
    if [ -z "$character_name" ]; then
        return 1
    fi
    
    # Cách 1: Tìm file có tên chứa tên nhân vật
    local found_file=$(find "$WORKSPACE_DIR" -name "*${character_name}*.json" -type f 2>/dev/null | head -1)
    
    if [ -n "$found_file" ] && [ -f "$found_file" ]; then
        echo "$found_file"
        return 0
    fi
    
    # Cách 2: Tìm file JSON có tên trong nội dung
    found_file=$(find "$WORKSPACE_DIR" -name "*.json" -type f -exec grep -l "$character_name" {} \; 2>/dev/null | head -1)
    
    if [ -n "$found_file" ] && [ -f "$found_file" ]; then
        echo "$found_file"
        return 0
    fi
    
    # Cách 3: Tìm file JSON mới nhất (fallback)
    found_file=$(find "$WORKSPACE_DIR" -name "*.json" -type f -printf "%T@ %p\n" 2>/dev/null | sort -nr | head -1 | cut -d' ' -f2-)
    
    if [ -n "$found_file" ] && [ -f "$found_file" ]; then
        local file_time=$(stat -c %Y "$found_file" 2>/dev/null)
        local current_time=$(date +%s)
        local time_diff=$((current_time - file_time))
        
        if [ $time_diff -lt 300 ]; then
            echo "$found_file"
            return 0
        fi
    fi
    
    return 1
}

# ============================================================
#   ĐỌC DỮ LIỆU TỪ JSON
# ============================================================

read_json_data() {
    local json_file="$1"
    
    if [ ! -f "$json_file" ]; then
        return 1
    fi
    
    # Thử lấy Username từ JSON trước
    USERNAME=$(jq -r '.Username // ""' "$json_file" 2>/dev/null)
    
    # Nếu không có Username trong JSON, lấy từ tên file
    if [ -z "$USERNAME" ] || [ "$USERNAME" = "null" ] || [ "$USERNAME" = "Unknown" ]; then
        local filename=$(basename "$json_file" .json)
        USERNAME=$(echo "$filename" | sed 's/_bf$//')
    fi
    
    BELI=$(jq -r '.Beli // 0' "$json_file" 2>/dev/null | sed 's/,//g')
    LEVEL=$(jq -r '.Level // 0' "$json_file" 2>/dev/null | sed 's/,//g')
    FRAGMENTS=$(jq -r '.Fragments // 0' "$json_file" 2>/dev/null | sed 's/,//g')
    RACE=$(jq -r '.Race // "Unknown"' "$json_file" 2>/dev/null)
    BOUNTY=$(jq -r '.Bounty_Honor // 0' "$json_file" 2>/dev/null | sed 's/,//g')
    
    SWORDS=$(jq -r '.Swords[]?' "$json_file" 2>/dev/null)
    ACCESSORIES=$(jq -r '.Accessories[]?' "$json_file" 2>/dev/null)
    MATERIALS=$(jq -r '.Materials[]?' "$json_file" 2>/dev/null)
    
    HAS_GODHUMAN="false"
    if echo "$SWORDS" | grep -qi "godhuman" || echo "$SWORDS" | grep -qi "god human"; then
        HAS_GODHUMAN="true"
    fi
    
    HAS_CURSED_DUAL="false"
    if echo "$SWORDS" | grep -q "Cursed Dual Katana"; then
        HAS_CURSED_DUAL="true"
    fi
    
    HAS_TUSHITA="false"
    if echo "$SWORDS" | grep -q "Tushita"; then
        HAS_TUSHITA="true"
    fi
    
    HAS_YAMA="false"
    if echo "$SWORDS" | grep -q "Yama"; then
        HAS_YAMA="true"
    fi
    
    HAS_VALKYRIE="false"
    if echo "$ACCESSORIES" | grep -q "Valkyrie Helm"; then
        HAS_VALKYRIE="true"
    fi
    
    HAS_MIRROR_FRACTAL="false"
    if echo "$MATERIALS" | grep -q "Mirror Fractal"; then
        HAS_MIRROR_FRACTAL="true"
    fi
    
    return 0
}

# ============================================================
#   CHECK ĐIỀU KIỆN
# ============================================================

