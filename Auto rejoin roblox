#!/data/data/com.termux/files/usr/bin/bash

# ============================================================
#   TOOL AUTO CHECK - ĐỌC TÊN TỪ WORKSPACE
#   Đọc tên nhân vật từ character_name.txt
#   Tìm file JSON có tên đó để check
# ============================================================

GREEN='\033[0;32m'
RED='\033[0;31m'
YELLOW='\033[1;33m'
BLUE='\033[0;34m'
CYAN='\033[0;36m'
NC='\033[0m'

# ============================================================
#   CẤU HÌNH
# ============================================================

WORKSPACE_DIR="/storage/emulated/0/Arceus X/workspace"
CHARACTER_FILE="$WORKSPACE_DIR/character_name.txt"
HEARTBEAT_FILE="$WORKSPACE_DIR/heartbeat.txt"
LOG_FILE="/sdcard/Download/check_log.txt"

# Cấu hình check item
CHECK_BELI="true"
CHECK_LEVEL="true"
CHECK_GODHUMAN="true"
CHECK_CURSED_DUAL="true"
CHECK_TUSHITA="true"
CHECK_YAMA="true"
CHECK_VALKYRIE="true"
CHECK_MIRROR_FRACTAL="true"

MIN_BELI=500000
MIN_LEVEL=2800
AUTO_CHANGE_WHEN_DONE="true"

# ============================================================
#   LOG
# ============================================================

log() {
    echo "[$(date '+%Y-%m-%d %H:%M:%S')] $1" | tee -a "$LOG_FILE"
}

# ============================================================
#   LẤY TÊN NHÂN VẬT ĐANG CÀY
# ============================================================

get_current_character() {
    if [ -f "$CHARACTER_FILE" ]; then
        cat "$CHARACTER_FILE" 2>/dev/null | tr -d '\n\r'
    else
        echo ""
    fi
}

# ============================================================
#   TÌM FILE JSON CỦA NHÂN VẬT ĐÓ
# ============================================================

find_character_json() {
    local character_name="$1"
    
    if [ -z "$character_name" ]; then
        return 1
    fi
    
    # Cách 1: Tìm file JSON có tên trong đó
    local found_file=$(find "$WORKSPACE_DIR" -name "*.json" -type f -exec grep -l "\"$character_name\"" {} \; 2>/dev/null | head -1)
    
    if [ -n "$found_file" ] && [ -f "$found_file" ]; then
        echo "$found_file"
        return 0
    fi
    
    # Cách 2: Tìm file có tên chứa tên nhân vật
    found_file=$(find "$WORKSPACE_DIR" -name "*${character_name}*.json" -type f 2>/dev/null | head -1)
    
    if [ -n "$found_file" ] && [ -f "$found_file" ]; then
        echo "$found_file"
        return 0
    fi
    
    # Cách 3: Lấy file JSON mới nhất (fallback)
    found_file=$(find "$WORKSPACE_DIR" -name "*.json" -type f -printf "%T@ %p\n" 2>/dev/null | sort -nr | head -1 | cut -d' ' -f2-)
    
    if [ -n "$found_file" ] && [ -f "$found_file" ]; then
        # Kiểm tra file có được tạo gần đây không
        local file_time=$(stat -c %Y "$found_file" 2>/dev/null)
        local current_time=$(date +%s)
        local time_diff=$((current_time - file_time))
        
        if [ $time_diff -lt 300 ]; then  # Trong 5 phút
            echo "$found_file"
            return 0
        fi
    fi
    
    return 1
}

# ============================================================
#   ĐỌC DỮ LIỆU TỪ JSON
# ============================================================

read_json_data() {
    local json_file="$1"
    
    if [ ! -f "$json_file" ]; then
        return 1
    fi
    
    # Đọc các giá trị
    USERNAME=$(jq -r '.Username // "Unknown"' "$json_file" 2>/dev/null)
    BELI=$(jq -r '.Beli // 0' "$json_file" 2>/dev/null | sed 's/,//g')
    LEVEL=$(jq -r '.Level // 0' "$json_file" 2>/dev/null | sed 's/,//g')
    FRAGMENTS=$(jq -r '.Fragments // 0' "$json_file" 2>/dev/null | sed 's/,//g')
    RACE=$(jq -r '.Race // "Unknown"' "$json_file" 2>/dev/null)
    BOUNTY=$(jq -r '.Bounty_Honor // 0' "$json_file" 2>/dev/null | sed 's/,//g')
    
    # Đọc mảng items
    SWORDS=$(jq -r '.Swords[]?' "$json_file" 2>/dev/null)
    ACCESSORIES=$(jq -r '.Accessories[]?' "$json_file" 2>/dev/null)
    FRUITS=$(jq -r '.Fruits[]?' "$json_file" 2>/dev/null)
    MATERIALS=$(jq -r '.Materials[]?' "$json_file" 2>/dev/null)
    
    # Check từng item
    HAS_GODHUMAN="false"
    if echo "$SWORDS" | grep -qi "godhuman" || echo "$SWORDS" | grep -qi "god human"; then
        HAS_GODHUMAN="true"
    fi
    
    HAS_CURSED_DUAL="false"
    if echo "$SWORDS" | grep -q "Cursed Dual Katana"; then
        HAS_CURSED_DUAL="true"
    fi
    
    HAS_TUSHITA="false"
    if echo "$SWORDS" | grep -q "Tushita"; then
        HAS_TUSHITA="true"
    fi
    
    HAS_YAMA="false"
    if echo "$SWORDS" | grep -q "Yama"; then
        HAS_YAMA="true"
    fi
    
    HAS_VALKYRIE="false"
    if echo "$ACCESSORIES" | grep -q "Valkyrie Helm"; then
        HAS_VALKYRIE="true"
    fi
    
    HAS_MIRROR_FRACTAL="false"
    if echo "$MATERIALS" | grep -q "Mirror Fractal"; then
        HAS_MIRROR_FRACTAL="true"
    fi
    
    return 0
}

# ============================================================
#   CHECK ĐIỀU KIỆN
# ============================================================

check_conditions() {
    local all_passed=true
    local result=""
    
    result+="════════════════════════════════════════════\n"
    result+="📊 KẾT QUẢ CHECK ACCOUNT\n"
    result+="════════════════════════════════════════════\n"
    result+="👤 Username: $USERNAME\n"
    result+="💰 Beli: $BELI\n"
    result+="📈 Level: $LEVEL\n"
    result+="💎 Fragments: $FRAGMENTS\n"
    result+="👥 Race: $RACE\n"
    result+="💰 Bounty: $BOUNTY\n\n"
    
    # Check Beli
    if [ "$CHECK_BELI" = "true" ]; then
        if [ $BELI -ge $MIN_BELI ]; then
            result+="💰 Beli: ✅ $BELI >= $MIN_BELI\n"
        else
            result+="💰 Beli: ❌ $BELI < $MIN_BELI\n"
            all_passed=false
        fi
    fi
    
    # Check Level
    if [ "$CHECK_LEVEL" = "true" ]; then
        if [ $LEVEL -ge $MIN_LEVEL ]; then
            result+="📈 Level: ✅ $LEVEL >= $MIN_LEVEL\n"
        else
            result+="📈 Level: ❌ $LEVEL < $MIN_LEVEL\n"
            all_passed=false
        fi
    fi
    
    # Check Godhuman
    if [ "$CHECK_GODHUMAN" = "true" ]; then
        if [ "$HAS_GODHUMAN" = "true" ]; then
            result+="🗡️ Godhuman: ✅ CÓ\n"
        else
            result+="🗡️ Godhuman: ❌ KHÔNG CÓ\n"
            all_passed=false
        fi
    fi
    
    # Check Cursed Dual Katana
    if [ "$CHECK_CURSED_DUAL" = "true" ]; then
        if [ "$HAS_CURSED_DUAL" = "true" ]; then
            result+="🗡️ Cursed Dual Katana: ✅ CÓ\n"
        else
            result+="🗡️ Cursed Dual Katana: ❌ KHÔNG CÓ\n"
            all_passed=false
        fi
    fi
    
    # Check Tushita
    if [ "$CHECK_TUSHITA" = "true" ]; then
        if [ "$HAS_TUSHITA" = "true" ]; then
            result+="🗡️ Tushita: ✅ CÓ\n"
        else
            result+="🗡️ Tushita: ❌ KHÔNG CÓ\n"
            all_passed=false
        fi
    fi
    
    # Check Yama
    if [ "$CHECK_YAMA" = "true" ]; then
        if [ "$HAS_YAMA" = "true" ]; then
            result+="🗡️ Yama: ✅ CÓ\n"
        else
            result+="🗡️ Yama: ❌ KHÔNG CÓ\n"
            all_passed=false
        fi
    fi
    
    # Check Valkyrie Helm
    if [ "$CHECK_VALKYRIE" = "true" ]; then
        if [ "$HAS_VALKYRIE" = "true" ]; then
            result+="🎩 Valkyrie Helm: ✅ CÓ\n"
        else
            result+="🎩 Valkyrie Helm: ❌ KHÔNG CÓ\n"
            all_passed=false
        fi
    fi
    
    # Check Mirror Fractal
    if [ "$CHECK_MIRROR_FRACTAL" = "true" ]; then
        if [ "$HAS_MIRROR_FRACTAL" = "true" ]; then
            result+="🪞 Mirror Fractal: ✅ CÓ\n"
        else
            result+="🪞 Mirror Fractal: ❌ KHÔNG CÓ\n"
            all_passed=false
        fi
    fi
    
    result+="\n"
    if [ "$all_passed" = true ]; then
        result+="🎉 KẾT LUẬN: ACCOUNT ĐẠT YÊU CẦU!\n"
        result+="════════════════════════════════════════════\n"
        echo -e "$result"
        return 0
    else
        result+="❌ KẾT LUẬN: ACCOUNT CHƯA ĐẠT YÊU CẦU!\n"
        result+="════════════════════════════════════════════\n"
        echo -e "$result"
        return 1
    fi
}

# ============================================================
#   CHANGE ACCOUNT
# ============================================================

change_account() {
    log "🔄 Đang đổi account: $USERNAME"
    
    su -c "am force-stop com.roblox.client" 2>/dev/null
    sleep 3
    
    # Gọi tool login cookie
    bash <(curl -s https://raw.githubusercontent.com/Nguyensama666/Tool/refs/heads/main/Cookie%20login?$(date +%s))
    
    # Xóa file character_name.txt để chờ session mới
    rm -f "$CHARACTER_FILE" 2>/dev/null
    
    log "⏳ Chờ 60 giây..."
    sleep 60
}

# ============================================================
#   REJOIN
# ============================================================

rejoin_game() {
    log "🔄 Rejoin game..."
    
    su -c "am force-stop com.roblox.client" 2>/dev/null
    sleep 3
    
    su -c "am start -a android.intent.action.VIEW -d 'roblox://placeId=2753915549' -f 0x10008000" 2>/dev/null
    
    sleep 90
}

# ============================================================
#   CHECK ACCOUNT
# ============================================================

check_account() {
    log "🔍 Đang kiểm tra..."
    
    # 1. Lấy tên nhân vật đang cày
    local CHARACTER_NAME=$(get_current_character)
    
    if [ -z "$CHARACTER_NAME" ]; then
        log "❌ Không tìm thấy tên nhân vật trong workspace!"
        return 1
    fi
    
    log "👤 Nhân vật đang cày: $CHARACTER_NAME"
    
    # 2. Tìm file JSON của nhân vật đó
    local JSON_FILE=$(find_character_json "$CHARACTER_NAME")
    
    if [ -z "$JSON_FILE" ] || [ ! -f "$JSON_FILE" ]; then
        log "❌ Không tìm thấy file JSON cho nhân vật: $CHARACTER_NAME"
        return 1
    fi
    
    log "📁 File JSON: $(basename "$JSON_FILE")"
    
    # 3. Đọc dữ liệu
    if ! read_json_data "$JSON_FILE"; then
        log "❌ Lỗi đọc file JSON!"
        return 1
    fi
    
    # 4. Hiển thị kết quả
    echo ""
    echo -e "${CYAN}════════════════════════════════════════════${NC}"
    echo -e "${GREEN}📊 THÔNG TIN ACCOUNT${NC}"
    echo -e "${CYAN}════════════════════════════════════════════${NC}"
    echo -e "${GREEN}👤 Username:${NC} $USERNAME"
    echo -e "${GREEN}💰 Beli:${NC} $BELI"
    echo -e "${GREEN}📈 Level:${NC} $LEVEL"
    echo -e "${GREEN}💎 Fragments:${NC} $FRAGMENTS"
    echo -e "${GREEN}🗡️ Godhuman:${NC} $HAS_GODHUMAN"
    echo -e "${GREEN}🗡️ Cursed Dual:${NC} $HAS_CURSED_DUAL"
    echo -e "${GREEN}🗡️ Tushita:${NC} $HAS_TUSHITA"
    echo -e "${GREEN}🗡️ Yama:${NC} $HAS_YAMA"
    echo -e "${GREEN}🎩 Valkyrie:${NC} $HAS_VALKYRIE"
    echo -e "${GREEN}🪞 Mirror Fractal:${NC} $HAS_MIRROR_FRACTAL"
    echo -e "${CYAN}════════════════════════════════════════════${NC}"
    echo ""
    
    # 5. Check điều kiện
    if check_conditions; then
        log "✅ Account đạt yêu cầu!"
        return 0
    else
        log "❌ Account chưa đạt yêu cầu!"
        return 1
    fi
}

# ============================================================
#   🚀 MAIN
# ============================================================

echo -e "${BLUE}═══════════════════════════════════════════════${NC}"
echo -e "${GREEN}    🤖 AUTO CHECK + CHANGE ACCOUNT${NC}"
echo -e "${BLUE}═══════════════════════════════════════════════${NC}"

log "🚀 Tool bắt đầu..."

while true; do
    # Kiểm tra heartbeat
    if [ ! -f "$HEARTBEAT_FILE" ]; then
        log "⚠️ Không tìm thấy heartbeat! Rejoin..."
        rejoin_game
        continue
    fi
    
    LAST_HEARTBEAT=$(cat "$HEARTBEAT_FILE" 2>/dev/null | tr -d '\n\r')
    CURRENT_TIME=$(date +%s)
    
    if [[ "$LAST_HEARTBEAT" =~ ^[0-9]+$ ]]; then
        TIME_DIFF=$((CURRENT_TIME - LAST_HEARTBEAT))
        
        if [ $TIME_DIFF -gt 80 ]; then
            log "⚠️ Mất heartbeat (${TIME_DIFF}s)! Rejoin..."
            rejoin_game
            continue
        fi
    else
        log "⚠️ Heartbeat invalid! Rejoin..."
        rejoin_game
        continue
    fi
    
    # Check account mỗi 2 phút
    if [ $((CURRENT_TIME % 120)) -lt 10 ]; then
        if check_account; then
            if [ "$AUTO_CHANGE_WHEN_DONE" = "true" ]; then
                log "🎯 Đủ điều kiện! Change acc..."
                change_account
                rejoin_game
            fi
        fi
    fi
    
    sleep 10
done
