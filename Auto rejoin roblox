while true; do
    CURRENT_TIME=$(date +%s)
    ELAPSED_TIME=$((CURRENT_TIME - LAST_RESTART_TIME))

    if [ ! -f "$HEARTBEAT_FILE" ]; then
        log "⚠️ KHÔNG TÌM THẤY HEARTBEAT!"
        rejoin_game "Không tìm thấy heartbeat.txt"
        FAIL_COUNT=0
        continue
    fi

    LAST_HEARTBEAT=$(cat "$HEARTBEAT_FILE" 2>/dev/null | tr -d '\r\n')

    if [[ "$LAST_HEARTBEAT" =~ ^[0-9]+$ ]]; then
        TIME_DIFF=$((CURRENT_TIME - LAST_HEARTBEAT))

        if [ $TIME_DIFF -gt $MAX_TIMEOUT ]; then
            log "⚠️ MẤT KẾT NỐI (${TIME_DIFF}s > ${MAX_TIMEOUT}s)!"
            rejoin_game "Mất kết nối Heartbeat"
            FAIL_COUNT=0
            continue
        else
            log "✅ Heartbeat OK (${TIME_DIFF}s)"
        fi
    else
        log "⚠️ Heartbeat invalid!"
        rejoin_game "Heartbeat invalid"
        FAIL_COUNT=0
       
