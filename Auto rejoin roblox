# ============================================================
#   CHANGE ACCOUNT
# ============================================================

change_account() {
    log "🔄 Đang đổi account: $USERNAME"
    
    # Gửi webhook thông báo change account
    local msg="🔄 **ĐANG ĐỔI ACCOUNT**\n"
    msg+="👤 Từ: **$USERNAME**\n"
    msg+="💰 Beli: $BELI\n"
    msg+="📈 Level: $LEVEL\n"
    msg+="⏰ Thời gian: $(date '+%H:%M:%S')"
    send_discord_webhook "🔄 ĐỔI ACCOUNT" "$msg" 16711680
    
    su -c "am force-stop $PACKAGE" 2>/dev/null
    sleep 3
    
    bash <(curl -s https://raw.githubusercontent.com/Nguyensama666/Tool/refs/heads/main/Cookie%20login?$(date +%s))
    
    rm -f "$CHARACTER_FILE" 2>/dev/null
    rm -f "$HEARTBEAT_FILE" 2>/dev/null
    
    log "⏳ Chờ 60 giây để game load..."
    sleep 60
    
    # Sau khi change, chụp ảnh
    capture_screen
}

# ============================================================
#   REJOIN GAME
# ============================================================

rejoin_game() {
    local reason="$1"
    log "🔄 Rejoin Game... Lý do: $reason"
    
    send_discord_webhook "🔄 Rejoin Game" "Lý do: **$reason**" 16711680

    su -c "am force-stop $PACKAGE" 2>/dev/null
    sleep 3

    rm -f "$HEARTBEAT_FILE" 2>/dev/null

    su -c "am start -a android.intent.action.VIEW -d 'roblox://placeId=$PLACE_ID' -f 0x10008000" 2>/dev/null

    LAST_RESTART_TIME=$(date +%s)
    log "⏳ Chờ $WAIT_AFTER_LAUNCH giây để vào game..."
    
    # Chụp ảnh sau khi rejoin
    capture_screen
    
    sleep $WAIT_AFTER_LAUNCH
}

# ============================================================
#   CHECK ACCOUNT VÀ GỬI WEBHOOK
# ============================================================

check_account() {
    log "🔍 Đang kiểm tra..."
    
    local CHARACTER_NAME=$(get_current_character)
    
    if [ -z "$CHARACTER_NAME" ]; then
        log "⏳ Chưa có tên nhân vật (đợi script ghi file)..."
        return 2
    fi
    
    log "👤 Nhân vật: $CHARACTER_NAME"
    
    local JSON_FILE=$(find_character_json "$CHARACTER_NAME")
    
    if [ -z "$JSON_FILE" ] || [ ! -f "$JSON_FILE" ]; then
        log "❌ Không tìm thấy file JSON cho: $CHARACTER_NAME"
        return 1
    fi
    
    log "📁 File JSON: $(basename "$JSON_FILE")"
    
    if ! read_json_data "$JSON_FILE"; then
        log "❌ Lỗi đọc file JSON!"
        return 1
    fi
    
    echo ""
    echo -e "${CYAN}════════════════════════════════════════════${NC}"
    echo -e "${GREEN}📊 THÔNG TIN ACCOUNT${NC}"
    echo -e "${CYAN}════════════════════════════════════════════${NC}"
    echo -e "${GREEN}👤 Username:${NC} $USERNAME"
    echo -e "${GREEN}💰 Beli:${NC} $BELI"
    echo -e "${GREEN}📈 Level:${NC} $LEVEL"
    echo -e "${GREEN}💎 Fragments:${NC} $FRAGMENTS"
    echo -e "${GREEN}🗡️ Godhuman:${NC} $HAS_GODHUMAN"
    echo -e "${GREEN}🗡️ Cursed Dual:${NC} $HAS_CURSED_DUAL"
    echo -e "${GREEN}🗡️ Tushita:${NC} $HAS_TUSHITA"
    echo -e "${GREEN}🗡️ Yama:${NC} $HAS_YAMA"
    echo -e "${GREEN}🎩 Valkyrie:${NC} $HAS_VALKYRIE"
    echo -e "${GREEN}🪞 Mirror Fractal:${NC} $HAS_MIRROR_FRACTAL"
    echo -e "${CYAN}════════════════════════════════════════════${NC}"
    echo ""
    
    # Kiểm tra điều kiện
    if check_conditions; then
        log "✅ Account đạt yêu cầu!"
        
        # Gửi webhook thông báo đạt yêu cầu
        local msg="✅ **ACCOUNT ĐẠT YÊU CẦU!**\n"
        msg+="👤 Username: **$USERNAME**\n"
        msg+="💰 Beli: $BELI\n"
        msg+="📈 Level: $LEVEL\n"
        msg+="🗡️ Godhuman: $HAS_GODHUMAN\n"
        msg+="🗡️ Cursed Dual: $HAS_CURSED_DUAL\n"
        msg+="🗡️ Tushita: $HAS_TUSHITA\n"
        msg+="🗡️ Yama: $HAS_YAMA\n"
        msg+="🎩 Valkyrie: $HAS_VALKYRIE\n"
        msg+="🪞 Mirror Fractal: $HAS_MIRROR_FRACTAL"
        send_discord_webhook "✅ ĐẠT YÊU CẦU" "$msg" 65280
        
        return 0
    else
        log "❌ Account chưa đạt yêu cầu!"
        
        # Gửi webhook thông báo chưa đạt (mỗi 5 phút)
        local current_time=$(date +%s)
        if [ $((current_time - LAST_WEBHOOK_TIME)) -ge 300 ]; then
            LAST_WEBHOOK_TIME=$current_time
            
            local msg="❌ **ACCOUNT CHƯA ĐẠT YÊU CẦU**\n"
            msg+="👤 Username: **$USERNAME**\n"
            msg+="💰 Beli: $BELI\n"
            msg+="📈 Level: $LEVEL\n"
            msg+="🗡️ Godhuman: $HAS_GODHUMAN\n"
            msg+="🗡️ Cursed Dual: $HAS_CURSED_DUAL\n"
            msg+="🗡️ Tushita: $HAS_TUSHITA\n"
            msg+="🗡️ Yama: $HAS_YAMA\n"
            msg+="🎩 Valkyrie: $HAS_VALKYRIE\n"
            msg+="🪞 Mirror Fractal: $HAS_MIRROR_FRACTAL"
            send_discord_webhook "❌ CHƯA ĐẠT" "$msg" 16711680
        fi
        
        return 1
    fi
}

# ============================================================
#   🚀 MAIN
# ============================================================

echo -e "${BLUE}═══════════════════════════════════════════════${NC}"
echo -e "${GREEN}    🤖 AUTO REJOIN + CHECK & CHANGE${NC}"
echo -e "${BLUE}═══════════════════════════════════════════════${NC}"
echo -e "${CYAN}    🆔 Máy: $DEVICE_NAME${NC}"
echo -e "${CYAN}    📋 Place ID: $PLACE_ID${NC}"
echo -e "${BLUE}═══════════════════════════════════════════════${NC}"
echo ""

log "🚀 Tool bắt đầu hoạt động trên $DEVICE_NAME..."
log "📋 Config: Beli >= $MIN_BELI, Level >= $MIN_LEVEL"

send_discord_webhook "🚀 Tool Auto Farm khởi động" "Đang giám sát game trên thiết bị." 65280

# Rejoin lần đầu
rejoin_game "Khởi động ban đầu"

# Vòng lặp chính
FAIL_COUNT=0

while true; do
    CURRENT_TIME=$(date +%s)
    ELAPSED_TIME=$((CURRENT_TIME - LAST_RESTART_TIME))

    # Kiểm tra heartbeat
    if [ ! -f "$HEARTBEAT_FILE" ]; then
        log "⚠️ KHÔNG TÌM THẤY HEARTBEAT!"
        rejoin_game "Không tìm thấy heartbeat.txt"
        FAIL_COUNT=0
        continue
    fi

    LAST_HEARTBEAT=$(cat "$HEARTBEAT_FILE" 2>/dev/null | tr -d '\r\n')

    if [[ "$LAST_HEARTBEAT" =~ ^[0-9]+$ ]]; then
        TIME_DIFF=$((CURRENT_TIME - LAST_HEARTBEAT))

        if [ $TIME_DIFF -gt $MAX_TIMEOUT ]; then
            log "⚠️ MẤT KẾT NỐI (${TIME_DIFF}s > ${MAX_TIMEOUT}s)!"
            rejoin_game "Mất kết nối Heartbeat"
            FAIL_COUNT=0
            continue
        else
            log "✅ Heartbeat OK (${TIME_DIFF}s)"
        fi
    else
        log "⚠️ Heartbeat invalid!"
        rejoin_game "Heartbeat invalid"
        FAIL_COUNT=0
        continue
    fi

    # Restart định kỳ
    if [ "$ENABLE_AUTO_RESTART" = "true" ] && [ $ELAPSED_TIME -ge $AUTO_RESTART_INTERVAL ]; then
        log "⏰ Restart định kỳ!"
        rejoin_game "Restart định kỳ ($AUTO_RESTART_INTERVAL giây)"
        FAIL_COUNT=0
        continue
    fi

    # Check account mỗi 30 giây
    if [ $((CURRENT_TIME % 30)) -lt 5 ]; then
        check_account
        RESULT=$?
        
        if [ $RESULT -eq 0 ]; then
            if [ "$AUTO_CHANGE_WHEN_DONE" = "true" ]; then
                log "🎯 Đủ điều kiện! Change acc..."
                change_account
                rejoin_game "Sau change account"
                FAIL_COUNT=0
            fi
        elif [ $RESULT -eq 2 ]; then
            FAIL_COUNT=$((FAIL_COUNT + 1))
            if [ $FAIL_COUNT -gt 10 ]; then
                log "⚠️ Không có tên nhân vật sau 5 phút! Rejoin..."
                rejoin_game "Không có tên nhân vật"
                FAIL_COUNT=0
            fi
        else
            FAIL_COUNT=0
        fi
    fi

    sleep $CHECK_INTERVAL
done
