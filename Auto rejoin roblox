#!/bin/bash
# ============================================================
# AUTO REJOIN VIA WORKSPACE HEARTBEAT (2026)
# ============================================================

PACKAGE="com.roblox.client"
PLACE_ID="2753915549"

# Cấu hình thời gian
CHECK_INTERVAL=10         # Tần suất kiểm tra (giây)
MAX_TIMEOUT=30            # Hạn mức chờ (giây) - Quá 30s không gửi heartbeat sẽ Rejoin
WAIT_AFTER_LAUNCH=30      # Thời gian chờ game load khi khởi động

ENABLE_AUTO_RESTART="true"
AUTO_RESTART_INTERVAL=3600 # Restart định kỳ giải phóng RAM (1 tiếng)

DOWNLOAD="/sdcard/Download"
LOG_FILE="$DOWNLOAD/rejoin_log.txt"
LAST_RESTART_TIME=$(date +%s)

log() {
    echo "[$(date '+%Y-%m-%d %H:%M:%S')] $1" | tee -a "$LOG_FILE"
}

# 🛠️ TỰ ĐỘNG TÌM ĐƯỜNG DẪN WORKSPACE CỦA EXECUTOR
find_heartbeat_file() {
    # Kiểm tra các thư mục workspace phổ biến của các Executor trên Android
    POSSIBLE_PATHS=(
        "/sdcard/Delta/workspace/heartbeat.txt"
        "/sdcard/Hydrogen/workspace/heartbeat.txt"
        "/sdcard/Fluxus/workspace/heartbeat.txt"
        "/sdcard/Codex/workspace/heartbeat.txt"
        "/sdcard/ArceusX/workspace/heartbeat.txt"
        "/sdcard/Cryptic/workspace/heartbeat.txt"
    )

    for path in "${POSSIBLE_PATHS[@]}"; do
        if [ -f "$path" ]; then
            echo "$path"
            return
        fi
    done

    # Nếu không tìm thấy ở vị trí mặc định, dùng find quét trong /sdcard
    FOUND=$(su -c "find /sdcard -type f -name 'heartbeat.txt' 2>/dev/null | head -n 1")
    if [ -n "$FOUND" ]; then
        echo "$FOUND"
    fi
}

rejoin_game() {
    log "🔄 Tiến hành khởi động lại Roblox vào Blox Fruits (PlaceID: $PLACE_ID)..."
    
    # Force stop Roblox
    su -c "am force-stop $PACKAGE" 2>/dev/null
    sleep 3

    # Xóa file heartbeat cũ để tránh nhận nhầm mốc thời gian cũ
    HEARTBEAT_FILE=$(find_heartbeat_file)
    if [ -n "$HEARTBEAT_FILE" ]; then
        rm -f "$HEARTBEAT_FILE"
    fi

    # Mở lại Blox Fruits
    su -c "am start -a android.intent.action.VIEW -d 'roblox://placeId=$PLACE_ID' -f 0x10008000" 2>/dev/null

    LAST_RESTART_TIME=$(date +%s)
    log "⏳ Đã phát lệnh. Chờ $WAIT_AFTER_LAUNCH giây để vào lại game..."
    sleep $WAIT_AFTER_LAUNCH
}

# ============================================================
# 🚀 VÒNG LẶP CHÍNH
# ============================================================

echo "═══════════════════════════════════════════════"
echo "    🤖 AUTO REJOIN BLOX FRUITS (WORKSPACE HEARTBEAT)"
echo "═══════════════════════════════════════════════"
log "🚀 Tool Auto Rejoin bắt đầu hoạt động..."

rejoin_game

while true; do
    CURRENT_TIME=$(date +%s)
    ELAPSED_TIME=$((CURRENT_TIME - LAST_RESTART_TIME))

    # 1. Định vị file heartbeat.txt trong Workspace
    HEARTBEAT_FILE=$(find_heartbeat_file)

    if [ -z "$HEARTBEAT_FILE" ] || [ ! -f "$HEARTBEAT_FILE" ]; then
        log "⚠️ KHÔNG TÌM THẤY HEARTBEAT: File chưa được tạo hoặc game chưa chạy Script!"
        rejoin_game
        continue
    fi

    # 2. Đọc mốc thời gian từ file heartbeat
    LAST_HEARTBEAT=$(cat "$HEARTBEAT_FILE" 2>/dev/null | tr -d '\r\n')

    # Kiểm tra xem dữ liệu trong file có phải là số hay không
    if [[ "$LAST_HEARTBEAT" =~ ^[0-9]+$ ]]; then
        TIME_DIFF=$((CURRENT_TIME - LAST_HEARTBEAT))

        if [ $TIME_DIFF -gt $MAX_TIMEOUT ]; then
            log "⚠️ MẤT KẾT NỐI/ĐỨNG GAME: Script không gửi tín hiệu trong $TIME_DIFF giây (Giới hạn: ${MAX_TIMEOUT}s)!"
            rejoin_game
            continue
        else
            log "✅ Game hoạt động bình thường (Heartbeat gửi cách đây ${TIME_DIFF}s)."
        fi
    else
        log "⚠️ LỖI ĐỌC FILE: Dữ liệu heartbeat không hợp lệ."
        rejoin_game
        continue
    fi

    # 3. Tự động Restart định kỳ (Chống tràn RAM)
    if [ "$ENABLE_AUTO_RESTART" = "true" ] && [ $ELAPSED_TIME -ge $AUTO_RESTART_INTERVAL ]; then
        log "⏰ RESTART ĐỊNH KỲ: Đã đủ $AUTO_RESTART_INTERVAL giây treo game. Tiến hành khởi động lại!"
        rejoin_game
        continue
    fi

    sleep $CHECK_INTERVAL
done
