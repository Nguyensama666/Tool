# ============================================================
#   DISCORD WEBHOOK
# ============================================================

send_discord_webhook() {
    local title="$1"
    local message="$2"
    local color="$3"

    su -c "curl -s -H 'Content-Type: application/json' -X POST -d '{
        \"username\": \"Auto Farm Blox Fruit\",
        \"embeds\": [{
            \"title\": \"$title\",
            \"description\": \"$message\",
            \"color\": $color,
            \"fields\": [
                {\"name\": \"Tên máy\", \"value\": \"\`$DEVICE_NAME\`\", \"inline\": true},
                {\"name\": \"Place ID\", \"value\": \"\`$PLACE_ID\`\", \"inline\": true}
            ],
            \"timestamp\": \"$(date -u +'%Y-%m-%dT%H:%M:%SZ')\"
        }]
    }' '$WEBHOOK_URL'" >/dev/null 2>&1 &
}

# ============================================================
#   CHỤP ẢNH SAU 5 PHÚT
# ============================================================

capture_screen() {
    if [ -n "$CAPTURE_PID" ] && kill -0 "$CAPTURE_PID" 2>/dev/null; then
        kill -9 "$CAPTURE_PID" 2>/dev/null
    fi

    (
        sleep 300
        log "📸 Chụp màn hình sau 5 phút..."
        
        local TIMESTAMP=$(date +%s)
        local SHOT_PATH="/data/local/tmp/screen_${TIMESTAMP}.png"

        su -c "screencap -p $SHOT_PATH" 2>/dev/null

        if su -c "test -f $SHOT_PATH"; then
            su -c "curl -s -X POST '$WEBHOOK_URL' \
                -F 'payload_json={\"content\": \"📸 **MÀN HÌNH SAU 5 PHÚT** - Máy: \`$DEVICE_NAME\`\"}' \
                -F 'file=@$SHOT_PATH'" >/dev/null 2>&1
            
            su -c "rm -f $SHOT_PATH" 2>/dev/null
            log "✅ Đã gửi screenshot lên Discord."
        else
            log "❌ Không thể chụp ảnh màn hình."
        fi
    ) &
    
    CAPTURE_PID=$!
}

# ============================================================
#   QUẢN LÝ SCRIPT - LẤY SCRIPT HIỆN TẠI
# ============================================================

get_current_script_index() {
    if [ -f "$SCRIPT_STATE_FILE" ]; then
        cat "$SCRIPT_STATE_FILE" 2>/dev/null | tr -d '\n\r'
    else
        echo "1"
    fi
}

save_script_index() {
    echo "$1" > "$SCRIPT_STATE_FILE"
}

# ============================================================
#   QUẢN LÝ SCRIPT - ĐỔI SCRIPT
# ============================================================

change_script() {
    local current_index=$(get_current_script_index)
    local next_index=$((current_index + 1))
    
    # Tạo mảng script
    SCRIPTS=()
    [ -n "$SCRIPT_1" ] && SCRIPTS+=("$SCRIPT_1")
    [ -n "$SCRIPT_2" ] && SCRIPTS+=("$SCRIPT_2")
    [ -n "$SCRIPT_3" ] && SCRIPTS+=("$SCRIPT_3")
    [ -n "$SCRIPT_4" ] && SCRIPTS+=("$SCRIPT_4")
    [ -n "$SCRIPT_5" ] && SCRIPTS+=("$SCRIPT_5")
    
    local total_scripts=${#SCRIPTS[@]}
    
    if [ $total_scripts -eq 0 ]; then
        log "⚠️ Không có script nào được cấu hình!"
        return 1
    fi
    
    # Nếu đã hết script, quay lại script 1
    if [ $next_index -gt $total_scripts ]; then
        next_index=1
    fi
    
    # Lấy tên script mới
    local new_script="${SCRIPTS[$((next_index - 1))]}"
    local current_script="${SCRIPTS[$((current_index - 1))]}"
    
    log "📝 Đổi script: $current_script -> $new_script"
    
    # Tạo thư mục Autoexec nếu chưa có
    mkdir -p "$ARCEUS_AUTOEXEC"
    
    # Xóa tất cả file cũ trong Autoexec
    rm -rf "$ARCEUS_AUTOEXEC"/*
    
    # Copy script mới vào Autoexec
    local source_file="/sdcard/Download/$new_script"
    
    if [ -f "$source_file" ]; then
        cp "$source_file" "$ARCEUS_AUTOEXEC/"
        log "✅ Đã copy script mới: $new_script"
        
        # Gửi webhook thông báo đổi script
        local msg="🔄 **ĐỔI SCRIPT**\n"
        msg+="📜 Từ: **$current_script**\n"
        msg+="📜 Sang: **$new_script**\n"
        msg+="👤 Account: **$USERNAME**\n"
        msg+="⏰ Thời gian: $(date '+%H:%M:%S')"
        send_discord_webhook "🔄 ĐỔI SCRIPT" "$msg" 16711680
        
        # Lưu index mới
        save_script_index "$next_index"
        return 0
    else
        log "❌ Không tìm thấy file script: $source_file"
        return 1
    fi
}

