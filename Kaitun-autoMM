-- ====================================================
-- SCRIPT 4: CONTROLLER TRUNG TÂM (CÓ BẢNG STATUS WEBHOOK ĐỨNG YÊN)
-- ====================================================
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local TeleportService = game:GetService("TeleportService")
local HttpService = game:GetService("HttpService")
local CoreGui = game:GetService("CoreGui")
local LocalPlayer = Players.LocalPlayer

local http_request = (syn and syn.request) or (http and http.request) or http_request or request

-- 1. TẢI CONFIG CHÍNH TỪ GITHUB
local Config = loadstring(game:HttpGet("https://raw.githubusercontent.com/Nguyensama666/Tool/refs/heads/main/Config-kaitunMM"))()

-- Variable lưu Message ID của Status Webhook để Edit
local StatusMessageId = nil

-- ----------------------------------------------------
-- GIAO DIỆN BẢNG STATUS TRÊN MÀN HÌNH GAME
-- ----------------------------------------------------
local function CreateStatusUI()
    local sg = CoreGui:FindFirstChild("KaitunStatusUI")
    if sg then sg:Destroy() end

    sg = Instance.new("ScreenGui")
    sg.Name = "KaitunStatusUI"
    sg.ResetOnSpawn = false
    sg.Parent = CoreGui

    local frame = Instance.new("Frame")
    frame.Size = UDim2.new(0, 260, 0, 70)
    frame.Position = UDim2.new(0.5, -130, 0, 15)
    frame.BackgroundColor3 = Color3.fromRGB(20, 20, 20)
    frame.BackgroundTransparency = 0.2
    frame.BorderSizePixel = 0
    frame.Active = true
    frame.Draggable = true
    frame.Parent = sg

    local corner = Instance.new("UICorner")
    corner.CornerRadius = UDim.new(0, 10)
    corner.Parent = frame

    local title = Instance.new("TextLabel")
    title.Size = UDim2.new(1, 0, 0, 25)
    title.Position = UDim2.new(0, 0, 0, 5)
    title.Text = "🔥 KAITUN AUTOMATION SYSTEM"
    title.TextColor3 = Color3.fromRGB(255, 200, 0)
    title.TextSize = 13
    title.Font = Enum.Font.SourceSansBold
    title.BackgroundTransparency = 1
    title.Parent = frame

    local statusText = Instance.new("TextLabel")
    statusText.Name = "StatusLabel"
    statusText.Size = UDim2.new(1, -20, 0, 35)
    statusText.Position = UDim2.new(0, 10, 0, 30)
    statusText.Text = "Đang khởi động hệ thống..."
    statusText.TextColor3 = Color3.fromRGB(255, 255, 255)
    statusText.TextSize = 12
    statusText.Font = Enum.Font.SourceSans
    statusText.TextWrapped = true
    statusText.BackgroundTransparency = 1
    statusText.Parent = frame

    return function(text, color)
        statusText.Text = text
        if color then statusText.TextColor3 = color end
    end
end

local UpdateUI = CreateStatusUI()

-- ----------------------------------------------------
-- HÀM BỔ TRỢ GET ITEM
-- ----------------------------------------------------
local function GetInventory()
    local success, result = pcall(function()
        return ReplicatedStorage.Remotes.CommF_:InvokeServer("getInventory")
    end)
    return success and result or {}
end

local function GetItemCount(itemName)
    for _, item in pairs(GetInventory()) do
        if item.Name == itemName then return item.Count or 1 end
    end
    return 0
end

-- ----------------------------------------------------
-- HÀM CẬP NHẬT WEBHOOK STATUS ĐỨNG YÊN (EDIT MESSAGE)
-- ----------------------------------------------------
local function SendOrUpdateStatusWebhook(actionStatus)
    if not Config.StatusWebhook or Config.StatusWebhook == "" then return end

    local currentCocoa = GetItemCount("Conjured Cocoa")
    local backpack = LocalPlayer:FindFirstChild("Backpack")
    local char = LocalPlayer.Character
    local hasChalice = (backpack and (backpack:FindFirstChild("Sweet Chalice") or backpack:FindFirstChild("God's Chalice"))) or 
                       (char and (char:FindFirstChild("Sweet Chalice") or char:FindFirstChild("God's Chalice")))
    
    local timeString = os.date("!%Y-%m-%d %H:%M:%S") .. " (UTC)"

    local payload = {
        username = "Acc Status Tracker",
        avatar_url = "https://i.imgur.com/8N4X0ZT.png",
        embeds = {{
            title = "🟢 TRẠNG THÁI HOẠT ĐỘNG ACC CHÍNH",
            description = "✨ **Hệ thống đang cập nhật Trạng thái Trực tiếp (Live Status)...**",
            color = 0x00FF00, -- Màu xanh lá
            fields = {
                { name = "👤 Tên Tài Khoản", value = "```" .. LocalPlayer.Name .. "```", inline = true },
                { name = "🎯 Boss Mục Tiêu", value = "```" .. tostring(Config.TargetBoss) .. "```", inline = true },
                { name = "📌 Hành Động Hiện Tại", value = "```" .. actionStatus .. "```", inline = false },
                { name = "📊 Trạng Thái Túi Đồ", value = "🍫 **Cacao:** `" .. tostring(currentCocoa) .. "/" .. tostring(Config.RequiredCocoa) .. "`\n🎨 **Haki:** `" .. (Config.NeedFarmHaki and "Chưa xong" or "Đã đủ") .. "`\n🏆 **Chén:** `" .. (hasChalice and "ĐÃ CÓ CHÉN!" or "Chưa có") .. "`", inline = false },
                { name = "🌐 JobId Server", value = "```" .. game.JobId .. "```", inline = false }
            },
            footer = {
                text = "🤖 Live Status • Cập nhật lúc " .. timeString,
                icon_url = "https://i.imgur.com/8N4X0ZT.png"
            }
        }}
    }

    pcall(function()
        if not StatusMessageId then
            -- Lần đầu tiên: Gửi POST để tạo tin nhắn mới + lấy Message ID (?wait=true)
            local res = http_request({
                Url = Config.StatusWebhook .. "?wait=true",
                Method = "POST",
                Headers = {["Content-Type"] = "application/json"},
                Body = HttpService:JSONEncode(payload)
            })
            if res and res.Body then
                local data = HttpService:JSONDecode(res.Body)
                if data and data.id then
                    StatusMessageId = data.id
                end
            end
        else
            -- Các lần tiếp theo: Gửi PATCH để CHỈNH SỬA tin nhắn cũ (không tạo tin nhắn mới)
            http_request({
                Url = Config.StatusWebhook .. "/messages/" .. StatusMessageId,
                Method = "PATCH",
                Headers = {["Content-Type"] = "application/json"},
                Body = HttpService:JSONEncode(payload)
            })
        end
    end)
end

-- Vòng lặp cập nhật Webhook Status đứng yên mỗi 15 giây
local CurrentActionText = "Đang khởi động..."
task.spawn(function()
    while task.wait(15) do
        SendOrUpdateStatusWebhook(CurrentActionText)
    end
end)

-- ----------------------------------------------------
-- HÀM BẮN WEBHOOK BÁO CHÉN (TIN NHẮN NỔ THÔNG BÁO)
-- ----------------------------------------------------
local function PushJobIdAndSendWebhook(chaliceType, cocoaCount)
    local placeId = game.PlaceId
    local jobId = game.JobId
    local bossType = Config.TargetBoss or "RipIndra"
    local timeString = os.date("!%Y-%m-%d %H:%M:%S") .. " (UTC)"

    pcall(function()
        http_request({
            Url = Config.UpstashURL .. "/set/TargetJobId/" .. jobId .. "?EX=300",
            Method = "GET",
            Headers = { ["Authorization"] = "Bearer " .. Config.UpstashToken }
        })
        http_request({
            Url = Config.UpstashURL .. "/set/TargetBoss/" .. bossType .. "?EX=300",
            Method = "GET",
            Headers = { ["Authorization"] = "Bearer " .. Config.UpstashToken }
        })
    end)

    local teleportCode = string.format("game:GetService(\"TeleportService\"):TeleportToPlaceInstance(%d, \"%s\", game.Players.LocalPlayer)", placeId, jobId)
    local isDough = (bossType == "DoughKing")

    if Config.DiscordWebhook and Config.DiscordWebhook ~= "" then
        local payload = {
            username = "System Scout",
            avatar_url = "https://i.imgur.com/8N4X0ZT.png",
            embeds = {{
                title = "🔥 ĐÃ PHÁT HIỆN " .. string.upper(chaliceType) .. "!",
                description = "✨ **Acc Chính đã sẵn sàng!** Acc Phụ đang tiến hành Auto-Join...",
                color = isDough and 0xFFA500 or 0xFF0000,
                fields = {
                    { name = "👤 Tài Khoản Chính", value = "```" .. LocalPlayer.Name .. "```", inline = true },
                    { name = "🎯 Boss Mục Tiêu", value = "```" .. bossType .. "```", inline = true },
                    { name = "📊 Trạng Thái Túi Đồ", value = isDough and ("🍫 **Cacao:** `" .. tostring(cocoaCount) .. "/" .. tostring(Config.RequiredCocoa) .. "`\n🏆 **Chén:** `" .. chaliceType .. "`") or ("🏆 **Chén:** `" .. chaliceType .. "`\n🎨 **Haki:** `Đã Hoàn Tất`"), inline = false },
                    { name = "📌 JobId Server", value = "```" .. jobId .. "```", inline = false },
                    { name = "🚀 Mã Teleport Cho Acc Phụ", value = "```lua\n" .. teleportCode .. "\n```", inline = false }
                },
                thumbnail = {
                    url = isDough and "https://i.imgur.com/3Z8q0m1.png" or "https://i.imgur.com/YX0m5aL.png"
                },
                footer = {
                    text = "🤖 Auto System Scout • " .. timeString,
                    icon_url = "https://i.imgur.com/8N4X0ZT.png"
                }
            }}
        }

        pcall(function()
            http_request({
                Url = Config.DiscordWebhook,
                Method = "POST",
                Headers = {["Content-Type"] = "application/json"},
                Body = HttpService:JSONEncode(payload)
            })
        end)
    end
end

-- ----------------------------------------------------
-- LOGIC ACC CHÍNH
-- ----------------------------------------------------
local function HandleMainAccount()
    CurrentActionText = "STATUS: ACC CHÍNH ĐANG HOẠT ĐỘNG"
    UpdateUI(CurrentActionText, Color3.fromRGB(0, 255, 255))
    SendOrUpdateStatusWebhook(CurrentActionText)

    -- 1. Check Haki
    if Config.NeedFarmHaki == true then
        CurrentActionText = "🔴 Đang Farm Haki Legend..."
        UpdateUI(CurrentActionText, Color3.fromRGB(255, 100, 100))
        SendOrUpdateStatusWebhook(CurrentActionText)
        loadstring(game:HttpGet(Config.Scripts.FarmHaki))()
        return
    end

    -- 2. Check Cacao
    local currentCocoa = 0
    if Config.TargetBoss == "DoughKing" then
        currentCocoa = GetItemCount("Conjured Cocoa")
        if currentCocoa < Config.RequiredCocoa then
            CurrentActionText = "🔴 Đang Farm Cacao (" .. currentCocoa .. "/" .. Config.RequiredCocoa .. ")..."
            UpdateUI(CurrentActionText, Color3.fromRGB(255, 150, 0))
            SendOrUpdateStatusWebhook(CurrentActionText)
            loadstring(game:HttpGet(Config.Scripts.FarmCocoa))()
            return
        end
    end

    -- 3. Check Chén
    CurrentActionText = "🟢 Đang Hop Server & Soi Chén Thánh..."
    UpdateUI(CurrentActionText, Color3.fromRGB(0, 255, 0))
    SendOrUpdateStatusWebhook(CurrentActionText)

    task.spawn(function()
        loadstring(game:HttpGet(Config.Scripts.FarmChalice))()
    end)

    task.spawn(function()
        local hasFoundChalice = false
        while task.wait(2) do
            local backpack = LocalPlayer:FindFirstChild("Backpack")
            local char = LocalPlayer.Character
            local sweetChalice = (backpack and backpack:FindFirstChild("Sweet Chalice")) or (char and char:FindFirstChild("Sweet Chalice"))
            local godsChalice = (backpack and backpack:FindFirstChild("God's Chalice")) or (char and char:FindFirstChild("God's Chalice"))

            if (sweetChalice or godsChalice) and not hasFoundChalice then
                hasFoundChalice = true
                local chaliceName = sweetChalice and "Sweet Chalice" or "God's Chalice"
                CurrentActionText = "🎉 ĐÃ PHÁT HIỆN " .. string.upper(chaliceName) .. "!"
                UpdateUI(CurrentActionText, Color3.fromRGB(255, 215, 0))
                SendOrUpdateStatusWebhook(CurrentActionText)
                
                PushJobIdAndSendWebhook(chaliceName, currentCocoa)
                break
            end
        end
    end)
end

-- ----------------------------------------------------
-- LOGIC ACC PHỤ
-- ----------------------------------------------------
local function HandleAltAccount()
    UpdateUI("STATUS: ACC PHỤ ĐANG TREO NGẦM", Color3.fromRGB(200, 200, 200))

    pcall(function()
        game:GetService("UserSettings").GameSettings.SavedQualityLevel = Enum.SavedQualitySetting.QualityLevel1
        settings().Rendering.QualityLevel = 1
    end)

    task.spawn(function()
        pcall(function()
            loadstring(game:HttpGet(Config.Scripts.AntiAFK))()
        end)
    end)

    task.spawn(function()
        while task.wait(3) do
            local res = pcall(function()
                return http_request({
                    Url = Config.UpstashURL .. "/get/TargetJobId",
                    Method = "GET",
                    Headers = { ["Authorization"] = "Bearer " .. Config.UpstashToken }
                })
            end) and http_request({
                Url = Config.UpstashURL .. "/get/TargetJobId",
                Method = "GET",
                Headers = { ["Authorization"] = "Bearer " .. Config.UpstashToken }
            })

            if res and res.Body then
                local dataDecoded = HttpService:JSONDecode(res.Body)
                local targetJobId = dataDecoded.result

                if targetJobId and targetJobId ~= true and targetJobId ~= "" then
                    if game.JobId ~= targetJobId then
                        UpdateUI("🚀 Đã có Chén! Đang Auto-Join...", Color3.fromRGB(0, 255, 255))
                        pcall(function()
                            TeleportService:TeleportToPlaceInstance(game.PlaceId, targetJobId, LocalPlayer)
                        end)
                        task.wait(5)
                    else
                        UpdateUI("✅ Đã vào đúng Server! Bật Script Đánh Boss!", Color3.fromRGB(0, 255, 0))
                        local getBossRes = http_request({
                            Url = Config.UpstashURL .. "/get/TargetBoss",
                            Method = "GET",
                            Headers = { ["Authorization"] = "Bearer " .. Config.UpstashToken }
                        })
                        local bossData = HttpService:JSONDecode(getBossRes.Body)
                        local targetBoss = bossData.result or Config.TargetBoss

                        if targetBoss == "DoughKing" then
                            loadstring(game:HttpGet(Config.Scripts.FightDough))()
                        else
                            loadstring(game:HttpGet(Config.Scripts.FightIndra))()
                        end
                        break
                    end
                else
                    UpdateUI("💤 Đang treo ngầm chờ Acc Chính...", Color3.fromRGB(180, 180, 180))
                end
            end
        end
    end)
end

-- ----------------------------------------------------
-- KHỞI CHẠY
-- ----------------------------------------------------
if LocalPlayer.Name == Config.MainAccountName then
    HandleMainAccount()
else
    HandleAltAccount()
end
