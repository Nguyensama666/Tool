local StatusMessageId = nil
local CurrentActionText = "Đang khởi động..."

-- ----------------------------------------------------
-- GIAO DIỆN BẢNG STATUS TRÊN MÀN HÌNH GAME
-- ----------------------------------------------------
local function CreateStatusUI()
    local sg = CoreGui:FindFirstChild("KaitunStatusUI")
    if sg then sg:Destroy() end

    sg = Instance.new("ScreenGui")
    sg.Name = "KaitunStatusUI"
    sg.ResetOnSpawn = false
    sg.Parent = CoreGui

    local frame = Instance.new("Frame")
    frame.Size = UDim2.new(0, 260, 0, 70)
    frame.Position = UDim2.new(0.5, -130, 0, 15)
    frame.BackgroundColor3 = Color3.fromRGB(20, 20, 20)
    frame.BackgroundTransparency = 0.2
    frame.BorderSizePixel = 0
    frame.Active = true
    frame.Draggable = true
    frame.Parent = sg

    local corner = Instance.new("UICorner")
    corner.CornerRadius = UDim.new(0, 10)
    corner.Parent = frame

    local title = Instance.new("TextLabel")
    title.Size = UDim2.new(1, 0, 0, 25)
    title.Position = UDim2.new(0, 0, 0, 5)
    title.Text = "🔥 KAITUN AUTOMATION SYSTEM"
    title.TextColor3 = Color3.fromRGB(255, 200, 0)
    title.TextSize = 13
    title.Font = Enum.Font.SourceSansBold
    title.BackgroundTransparency = 1
    title.Parent = frame

    local statusText = Instance.new("TextLabel")
    statusText.Name = "StatusLabel"
    statusText.Size = UDim2.new(1, -20, 0, 35)
    statusText.Position = UDim2.new(0, 10, 0, 30)
    statusText.Text = "⚡ Đang khởi động siêu tốc..."
    statusText.TextColor3 = Color3.fromRGB(255, 255, 255)
    statusText.TextSize = 12
    statusText.Font = Enum.Font.SourceSans
    statusText.TextWrapped = true
    statusText.BackgroundTransparency = 1
    statusText.Parent = frame

    return function(text, color)
        statusText.Text = text
        if color then statusText.TextColor3 = color end
    end
end

local UpdateUI = CreateStatusUI()

-- ----------------------------------------------------
-- HÀM LẤY DỮ LIỆU TÚI ĐỒ (KHÔNG GÂY TREO CODE)
-- ----------------------------------------------------
local function GetInventory()
    local result = {}
    pcall(function()
        local remotes = ReplicatedStorage:FindFirstChild("Remotes")
        local commF = remotes and remotes:FindFirstChild("CommF_")
        if commF then
            result = commF:InvokeServer("getInventory")
        end
    end)
    return type(result) == "table" and result or {}
end

local function GetItemCount(itemName)
    for _, item in pairs(GetInventory()) do
        if item.Name == itemName then return item.Count or 1 end
    end
    return 0
end

local function SetRedisTask(taskName)
    if not Config.UpstashURL or Config.UpstashURL == "" then return end
    task.spawn(function()
        pcall(function()
            http_request({
                Url = Config.UpstashURL .. "/set/CurrentTask/" .. taskName .. "?EX=300",
                Method = "GET",
                Headers = { ["Authorization"] = "Bearer " .. (Config.UpstashToken or "") }
            })
        end)
    end)
end

-- ----------------------------------------------------
-- HÀM CẬP NHẬT WEBHOOK STATUS ĐỨNG YÊN (CHẠY NGẦM)
-- ----------------------------------------------------
local function SendOrUpdateStatusWebhook(actionStatus)
    if not Config.StatusWebhook or Config.StatusWebhook == "" then return end

    task.spawn(function()
        local currentCocoa = GetItemCount("Conjured Cocoa")
        local backpack = LocalPlayer:FindFirstChild("Backpack")
        local char = LocalPlayer.Character
        local hasChalice = (backpack and (backpack:FindFirstChild("Sweet Chalice") or backpack:FindFirstChild("God's Chalice"))) or 
                           (char and (char:FindFirstChild("Sweet Chalice") or char:FindFirstChild("God's Chalice")))
        
        local berryText = ""
        if Config.NeedFarmHaki == true then
            local red   = GetItemCount("Red Cherry Berry")
            local white = GetItemCount("White Cloud Berry")
            local pink  = GetItemCount("Pink Pig Berry")
            berryText = string.format("\n└ 🍒 `%d/15` | ☁️ `%d/10` | 🐷 `%d/15`", red, white, pink)
        end

        local vnTime = os.date("*t", os.time() + 25200)
        local timeString = string.format("%02d/%02d/%04d %02d:%02d:%02d (VN)", vnTime.day, vnTime.month, vnTime.year, vnTime.hour, vnTime.min, vnTime.sec)

        local inventoryStatus = "🍫 **Cacao:** `" .. tostring(currentCocoa) .. "/" .. tostring(Config.RequiredCocoa or 10) .. "`\n" ..
                                "🎨 **Haki:** `" .. (Config.NeedFarmHaki and "Đang Farm" or "Đã Đủ/Tắt") .. "`" .. berryText .. "\n" ..
                                "🏆 **Chén:** `" .. (hasChalice and "ĐÃ CÓ CHÉN!" or "Chưa có") .. "`"

        local payload = {
            username = "Acc Status Tracker",
            avatar_url = "https://i.imgur.com/8N4X0ZT.png",
            embeds = {{
                title = "🟢 TRẠNG THÁI HOẠT ĐỘNG ACC CHÍNH",
                description = "✨ **Hệ thống đang cập nhật Trạng thái Trực tiếp (Live Status)...**",
                color = 0x00FF00,
                fields = {
                    { name = "👤 Tên Tài Khoản", value = "```" .. LocalPlayer.Name .. "```", inline = true },
                    { name = "🎯 Boss Mục Tiêu", value = "```" .. tostring(Config.TargetBoss or "N/A") .. "```", inline = true },
                    { name = "📌 Hành Động Hiện Tại", value = "```" .. actionStatus .. "```", inline = false },
                    { name = "📊 Trạng Thái Túi Đồ", value = inventoryStatus, inline = false },
                    { name = "🌐 JobId Server", value = "```" .. game.JobId .. "```", inline = false }
                },
                footer = {
                    text = "🤖 Live Status • Cập nhật lúc " .. timeString,
                    icon_url = "https://i.imgur.com/8N4X0ZT.png"
                }
            }}
        }

        pcall(function()
            if not StatusMessageId then
                local res = http_request({
                    Url = Config.StatusWebhook .. "?wait=true",
                    Method = "POST",
                    Headers = {["Content-Type"] = "application/json"},
                    Body = HttpService:JSONEncode(payload)
                })
                if res and res.Body then
                    local data = HttpService:JSONDecode(res.Body)
                    if data and data.id then StatusMessageId = tostring(data.id) end
                end
            else
                http_request({
                    Url = Config.StatusWebhook .. "/messages/" .. StatusMessageId,
                    Method = "PATCH",
                    Headers = {["Content-Type"] = "application/json"},
                    Body = HttpService:JSONEncode(payload)
                })
            end
        end)
    end)
end

-- Vòng lặp cập nhật Webhook Status mỗi 15 giây
task.spawn(function()
    while task.wait(15) do
        SendOrUpdateStatusWebhook(CurrentActionText)
    end
end)

-- ----------------------------------------------------
-- LOGIC ACC CHÍNH
-- ----------------------------------------------------
local function HandleMainAccount()
    CurrentActionText = "STATUS: ACC CHÍNH ĐANG HOẠT ĐỘNG"
    UpdateUI(CurrentActionText, Color3.fromRGB(0, 255, 255))

    -- 1. BẬT FARM HAKI TRƯỚC (NẾU NEEDFARMHAKI = TRUE)
    if Config.NeedFarmHaki == true then
        CurrentActionText = "🎨 Đang Farm Haki Legend..."
        UpdateUI(CurrentActionText, Color3.fromRGB(255, 170, 0))
        SetRedisTask("FarmHaki")

        -- KÍCH HOẠT SCRIPT FARM HAKI NGAY LẬP TỨC
        task.spawn(function()
            if Config.Scripts and Config.Scripts.FarmHaki and Config.Scripts.FarmHaki ~= "" then
                pcall(function() loadstring(game:HttpGet(Config.Scripts.FarmHaki))() end)
            end
        end)

        -- CHẠY NGẦM BẮN WEBHOOK VÀ CHECK BERRY (KHÔNG LÀM CHẬM GAME)
        task.spawn(function()
            SendOrUpdateStatusWebhook(CurrentActionText)
            if Config.Scripts and Config.Scripts.CheckBerry and Config.Scripts.CheckBerry ~= "" then
                pcall(function() loadstring(game:HttpGet(Config.Scripts.CheckBerry))() end)
            end
        end)
        return
    end

    -- 2. CHECK CACAO (NẾU NEEDFARMHAKI = FALSE)
    local currentCocoa = GetItemCount("Conjured Cocoa")
    if Config.TargetBoss == "DoughKing" and currentCocoa < (Config.RequiredCocoa or 10) then
        CurrentActionText = "🔴 Thiếu Cacao (" .. currentCocoa .. "/" .. (Config.RequiredCocoa or 10) .. ")..."
        UpdateUI(CurrentActionText, Color3.fromRGB(255, 150, 0))
        
        SetRedisTask("FarmCocoa")
        task.spawn(function()
            SendOrUpdateStatusWebhook(CurrentActionText)
            if Config.Scripts and Config.Scripts.FarmCocoa then
                pcall(function() loadstring(game:HttpGet(Config.Scripts.FarmCocoa))() end)
            end
        end)
        return
    end

    -- 3. SOI CHÉN
    CurrentActionText = "🟢 Đang Hop Server & Soi Chén..."
    UpdateUI(CurrentActionText, Color3.fromRGB(0, 255, 0))
    SetRedisTask("FarmChalice")

    task.spawn(function()
        SendOrUpdateStatusWebhook(CurrentActionText)
        if Config.Scripts and Config.Scripts.FarmChalice then
            pcall(function() loadstring(game:HttpGet(Config.Scripts.FarmChalice))() end)
        end
    end)
end

-- ----------------------------------------------------
-- KHỞI CHẠY HỆ THỐNG
-- ----------------------------------------------------
if LocalPlayer.Name == Config.MainAccountName then
    HandleMainAccount()
else
    UpdateUI("STATUS: ACC PHỤ ĐANG TREO NGẦM", Color3.fromRGB(200, 200, 200))
end
