-- ----------------------------------------------------
-- HÀM BỔ TRỢ GET ITEM & REDIS DATABASE
-- ----------------------------------------------------
local function GetInventory()
    local success, result = pcall(function()
        return ReplicatedStorage.Remotes.CommF_:InvokeServer("getInventory")
    end)
    return success and result or {}
end

local function GetItemCount(itemName)
    for _, item in pairs(GetInventory()) do
        if item.Name == itemName then return item.Count or 1 end
    end
    return 0
end

local function SetRedisTask(taskName)
    pcall(function()
        http_request({
            Url = Config.UpstashURL .. "/set/CurrentTask/" .. taskName .. "?EX=300",
            Method = "GET",
            Headers = { ["Authorization"] = "Bearer " .. Config.UpstashToken }
        })
    end)
end

local function GetRedisTask()
    local success, res = pcall(function()
        return http_request({
            Url = Config.UpstashURL .. "/get/CurrentTask",
            Method = "GET",
            Headers = { ["Authorization"] = "Bearer " .. Config.UpstashToken }
        })
    end)
    if success and res and res.Body then
        local data = HttpService:JSONDecode(res.Body)
        if data and data.result and data.result ~= true and data.result ~= "" then
            return tostring(data.result)
        end
    end
    return nil
end

