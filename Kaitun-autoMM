local function HandleAltAccount()
    UpdateUI("STATUS: ACC PHỤ ĐANG TREO NGẦM", Color3.fromRGB(200, 200, 200))

    pcall(function()
        game:GetService("UserSettings").GameSettings.SavedQualityLevel = Enum.SavedQualitySetting.QualityLevel1
        settings().Rendering.QualityLevel = 1
        for _, v in ipairs(workspace:GetDescendants()) do
            if v:IsA("BasePart") and not v:IsDescendantOf(LocalPlayer.Character) then
                v.Material = Enum.Material.SmoothPlastic
            end
        end
    end)

    task.spawn(function()
        pcall(function()
            loadstring(game:HttpGet(Config.Scripts.AntiAFK .. "?nocache=" .. tostring(os.time())))()
        end)
    end)

    task.spawn(function()
        while task.wait(3) do
            if isTeleporting then continue end

            local res = nil
            pcall(function()
                res = http_request({
                    Url = Config.UpstashURL .. "/get/TargetJobId",
                    Method = "GET",
                    Headers = { ["Authorization"] = "Bearer " .. Config.UpstashToken }
                })
            end)

            if type(res) == "table" and res.Body then
                local dataDecoded = nil
                pcall(function() dataDecoded = HttpService:JSONDecode(res.Body) end)
                local targetJobId = dataDecoded and dataDecoded.result

                if targetJobId and targetJobId ~= true and targetJobId ~= "" then
                    if game.JobId ~= targetJobId then
                        isTeleporting = true
                        UpdateUI("🚀 Đã có Chén! Đang Auto-Join...", Color3.fromRGB(0, 255, 255))
                        
                        task.delay(10, function()
                            if isTeleporting then isTeleporting = false end
                        end)

                        pcall(function()
                            TeleportService:TeleportToPlaceInstance(game.PlaceId, targetJobId, LocalPlayer)
                        end)
                    else
                        UpdateUI("✅ Đã vào Server! Bật Script Đánh Boss!", Color3.fromRGB(0, 255, 0))
                        
                        local getBossRes = nil
                        pcall(function()
                            getBossRes = http_request({
                                Url = Config.UpstashURL .. "/get/TargetBoss",
                                Method = "GET",
                                Headers = { ["Authorization"] = "Bearer " .. Config.UpstashToken }
                            })
                        end)
                        
                        local targetBoss = Config.TargetBoss
                        if type(getBossRes) == "table" and getBossRes.Body then
                            local bossData = nil
                            pcall(function() bossData = HttpService:JSONDecode(getBossRes.Body) end)
                            targetBoss = (bossData and bossData.result) or targetBoss
                        end

                        if targetBoss == "DoughKing" then
                            pcall(function() loadstring(game:HttpGet(Config.Scripts.FightDough .. "?nocache=" .. tostring(os.time())))() end)
                        else
                            pcall(function() loadstring(game:HttpGet(Config.Scripts.FightIndra .. "?nocache=" .. tostring(os.time())))() end)
                        end
                        break
                    end
                else
                    UpdateUI("💤 Đang treo ngầm chờ Acc Chính...", Color3.fromRGB(180, 180, 180))
                end
            end
        end
    end)
end

