-- ----------------------------------------------------
local function AutoFixByGemini(filePathInGithub, errorMessage, sourceCode)
    task.spawn(function()
        local renderUrl = "https://autofix-server-oi94.onrender.com/fix-script"
        
        -- Tìm hàm HTTP request an toàn không bị Executor blacklist
        local req = (syn and syn.request) or (http and http.request) or http_request or request or (fluxus and fluxus.request)

        if req and type(req) == "function" then
            pcall(function()
                req({
                    Url = renderUrl,
                    Method = "POST",
                    Headers = {["Content-Type"] = "application/json"},
                    Body = game:GetService("HttpService"):JSONEncode({
                        file_path = filePathInGithub,
                        error_log = tostring(errorMessage),
                        current_code = sourceCode
                    })
                })
            end)
        else
            warn("⚠️ Executor hiện tại đang cấm/chặn hàm Request (Blacklisted HTTP Request)!")
        end
    end)
end

