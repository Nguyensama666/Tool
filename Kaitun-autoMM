-- ----------------------------------------------------
-- LOGIC ACC CHÍNH (CÓ DATABASE NHỚ TASK + BẬT LIỀN TRONG 1S)
-- ----------------------------------------------------
local function HandleMainAccount()
    CurrentActionText = "STATUS: ACC CHÍNH ĐANG HOẠT ĐỘNG"
    UpdateUI(CurrentActionText, Color3.fromRGB(0, 255, 255))
    SendOrUpdateStatusWebhook(CurrentActionText)

    -- 1. Xử lý đổi Config: Nếu tắt NeedFarmHaki thì xóa task cũ trên Redis
    if Config.NeedFarmHaki == false then
        if GetRedisTask() == "FarmHaki" then
            SetRedisTask("")
        end
    end

    -- 2. Đọc Task từ Redis để bật liền lập tức khi vừa vào game / hop server (< 1 giây)
    local savedTask = GetRedisTask()
    if savedTask and savedTask ~= "" then
        print("⚡ [FAST RECOVER] Nhớ Task từ Redis -> Bật liền: " .. savedTask)

        if savedTask == "FarmHaki" and Config.NeedFarmHaki == true then
            CurrentActionText = "⚡ [Bật liền 1s] Đang kiểm tra Berry Haki..."
            UpdateUI(CurrentActionText, Color3.fromRGB(255, 170, 0))
            SendOrUpdateStatusWebhook(CurrentActionText)
            
            local scriptUrl = Config.Scripts.CheckBerry or Config.Scripts.FarmHaki
            if scriptUrl and scriptUrl ~= "" then loadstring(game:HttpGet(scriptUrl))() end
            return
        elseif savedTask == "FarmCocoa" then
            CurrentActionText = "⚡ [Bật liền 1s] Đang chạy Farm Cacao..."
            UpdateUI(CurrentActionText, Color3.fromRGB(255, 150, 0))
            SendOrUpdateStatusWebhook(CurrentActionText)
            
            loadstring(game:HttpGet(Config.Scripts.FarmCocoa))()
            return
        elseif savedTask == "FarmChalice" then
            CurrentActionText = "⚡ [Bật liền 1s] Đang Soi Chén Thánh..."
            UpdateUI(CurrentActionText, Color3.fromRGB(0, 255, 0))
            SendOrUpdateStatusWebhook(CurrentActionText)
            
            task.spawn(function()
                loadstring(game:HttpGet(Config.Scripts.FarmChalice))()
            end)
            return
        end
    end

    -- 3. NẾU CHƯA CÓ TRÊN REDIS HOẶC MỚI KHỞI ĐỘNG
    if Config.NeedFarmHaki == true then
        CurrentActionText = "🫐 Đang kiểm tra Berry Craft Haki..."
        UpdateUI(CurrentActionText, Color3.fromRGB(255, 170, 0))
        SendOrUpdateStatusWebhook(CurrentActionText)

        SetRedisTask("FarmHaki") -- Lưu vào Database cho lần hop server sau
        local scriptUrl = Config.Scripts.CheckBerry or Config.Scripts.FarmHaki
        if scriptUrl and scriptUrl ~= "" then
            loadstring(game:HttpGet(scriptUrl))()
        end
        return
    end

    -- 4. Check Cacao
    local currentCocoa = 0
    if Config.TargetBoss == "DoughKing" then
        currentCocoa = GetItemCount("Conjured Cocoa")
        if currentCocoa < Config.RequiredCocoa then
            CurrentActionText = "🔴 Thiếu Cacao (" .. currentCocoa .. "/" .. Config.RequiredCocoa .. ")\n-> Bật Script Farm Cacao..."
            UpdateUI(CurrentActionText, Color3.fromRGB(255, 150, 0))
            SendOrUpdateStatusWebhook(CurrentActionText)
            
            SetRedisTask("FarmCocoa")
            loadstring(game:HttpGet(Config.Scripts.FarmCocoa))()
            return
        end
    end

    -- 5. ĐỦ ĐIỀU KIỆN -> FARM CHÉN
    CurrentActionText = "🟢 Đang Hop Server & Soi Chén Thánh..."
    UpdateUI(CurrentActionText, Color3.fromRGB(0, 255, 0))
    SendOrUpdateStatusWebhook(CurrentActionText)

    SetRedisTask("FarmChalice")
    task.spawn(function()
        loadstring(game:HttpGet(Config.Scripts.FarmChalice))()
    end)

    task.spawn(function()
        local hasFoundChalice = false
        while task.wait(1) do
            local backpack = LocalPlayer:FindFirstChild("Backpack")
            local char = LocalPlayer.Character
            local sweetChalice = (backpack and backpack:FindFirstChild("Sweet Chalice")) or (char and char:FindFirstChild("Sweet Chalice"))
            local godsChalice = (backpack and backpack:FindFirstChild("God's Chalice")) or (char and char:FindFirstChild("God's Chalice"))

            if (sweetChalice or godsChalice) and not hasFoundChalice then
                hasFoundChalice = true
                local chaliceName = sweetChalice and "Sweet Chalice" or "God's Chalice"
                CurrentActionText = "🎉 ĐÃ PHÁT HIỆN " .. string.upper(chaliceName) .. "!"
                UpdateUI(CurrentActionText, Color3.fromRGB(255, 215, 0))
                SendOrUpdateStatusWebhook(CurrentActionText)
                
                PushJobIdAndSendWebhook(chaliceName, currentCocoa)
                break
            end
        end
    end)
end

