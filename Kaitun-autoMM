-- 3. HÀM CHECK TÚI ĐỒ (CÓ PCALL BẮT LỖI)
-- ----------------------------------------------------
local function SafeGetItemCount(itemName)
    local count = 0
    local bindable = Instance.new("BindableEvent")
    local finished = false

    task.spawn(function()
        local success, err = pcall(function()
            local backpack = LocalPlayer:FindFirstChild("Backpack")
            local char = LocalPlayer.Character
            
            if backpack then
                for _, item in ipairs(backpack:GetChildren()) do
                    if string.find(item.Name:lower(), itemName:lower()) then
                        count = count + (item:FindFirstChild("Count") and item.Count.Value or 1)
                    end
                end
            end
            
            if char then
                for _, item in ipairs(char:GetChildren()) do
                    if item:IsA("Tool") and string.find(item.Name:lower(), itemName:lower()) then
                        count = count + (item:FindFirstChild("Count") and item.Count.Value or 1)
                    end
                end
            end

            if count == 0 then
                local remotes = ReplicatedStorage:FindFirstChild("Remotes")
                local commF = remotes and remotes:FindFirstChild("CommF_")
                if commF then
                    local inv = commF:InvokeServer("getInventory")
                    if type(inv) == "table" then
                        for _, item in ipairs(inv) do
                            if type(item) == "table" then
                                local name = item.Name or item.NameItem or ""
                                if string.find(name:lower(), itemName:lower()) then
                                    count = item.Count or item.Amount or item.Value or 1
                                    break
                                end
                            end
                        end
                    end
                end
            end
        end)

        if not success then
            warn("⚠️ Lỗi Check Túi Đồ: " .. tostring(err))
            AutoFixByGemini("Scripts/Controller.lua", err, "Check Inventory Function Error")
        end

        finished = true
        bindable:Fire()
    end)

    task.delay(2.5, function()
        if not finished then bindable:Fire() end
    end)

    bindable.Event:Wait()
    bindable:Destroy()
    return count
end

