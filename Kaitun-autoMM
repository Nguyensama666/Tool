-- ----------------------------------------------------
-- LOGIC ACC CHÍNH
-- ----------------------------------------------------
local function HandleMainAccount()
    CurrentActionText = "STATUS: ACC CHÍNH ĐANG HOẠT ĐỘNG"
    UpdateUI(CurrentActionText, Color3.fromRGB(0, 255, 255))
    SendOrUpdateStatusWebhook(CurrentActionText)

    -- 1. Check Haki
    if Config.NeedFarmHaki == true then
        CurrentActionText = "🔴 Đang Farm Haki Legend..."
        UpdateUI(CurrentActionText, Color3.fromRGB(255, 100, 100))
        SendOrUpdateStatusWebhook(CurrentActionText)
        loadstring(game:HttpGet(Config.Scripts.FarmHaki))()
        return
    end

    -- 2. Check Cacao
    local currentCocoa = 0
    if Config.TargetBoss == "DoughKing" then
        currentCocoa = SafeGetItemCount("Conjured Cocoa")
        
        if currentCocoa < (Config.RequiredCocoa or 10) then
            CurrentActionText = "🔴 Đang Farm Cacao (" .. currentCocoa .. "/" .. (Config.RequiredCocoa or 10) .. ")..."
            UpdateUI(CurrentActionText, Color3.fromRGB(255, 150, 0))
            SendOrUpdateStatusWebhook(CurrentActionText)
            
            loadstring(game:HttpGet(Config.Scripts.FarmCocoa))()
            return
        end
    end

    -- 3. Check Chén
    CurrentActionText = "🟢 Đang Hop Server & Soi Chén Thánh..."
    UpdateUI(CurrentActionText, Color3.fromRGB(0, 255, 0))
    SendOrUpdateStatusWebhook(CurrentActionText)

    task.spawn(function()
        loadstring(game:HttpGet(Config.Scripts.FarmChalice))()
    end)

    task.spawn(function()
        local hasFoundChalice = false
        while task.wait(2) do
            local backpack = LocalPlayer:FindFirstChild("Backpack")
            local char = LocalPlayer.Character
            local sweetChalice = (backpack and backpack:FindFirstChild("Sweet Chalice")) or (char and char:FindFirstChild("Sweet Chalice"))
            local godsChalice = (backpack and backpack:FindFirstChild("God's Chalice")) or (char and char:FindFirstChild("God's Chalice"))

            if (sweetChalice or godsChalice) and not hasFoundChalice then
                hasFoundChalice = true
                local chaliceName = sweetChalice and "Sweet Chalice" or "God's Chalice"
                CurrentActionText = "🎉 ĐÃ PHÁT HIỆN " .. string.upper(chaliceName) .. "!"
                UpdateUI(CurrentActionText, Color3.fromRGB(255, 215, 0))
                SendOrUpdateStatusWebhook(CurrentActionText)
                
                PushJobIdAndSendWebhook(chaliceName, currentCocoa)
                break
            end
        end
    end)
end

-- ----------------------------------------------------
-- LOGIC ACC PHỤ (CHỐNG SPAM CALL UPSTASH & TELEPORT)
-- ----------------------------------------------------
local function HandleAltAccount()
    UpdateUI("STATUS: ACC PHỤ ĐANG TREO NGẦM", Color3.fromRGB(200, 200, 200))

    pcall(function()
        game:GetService("UserSettings").GameSettings.SavedQualityLevel = Enum.SavedQualitySetting.QualityLevel1
        settings().Rendering.QualityLevel = 1
    end)

    task.spawn(function()
        pcall(function()
            loadstring(game:HttpGet(Config.Scripts.AntiAFK))()
        end)
    end)

    task.spawn(function()
        while task.wait(3) do
            if isTeleporting then continue end

            local success, res = pcall(function()
                return http_request({
                    Url = Config.UpstashURL .. "/get/TargetJobId",
                    Method = "GET",
                    Headers = { ["Authorization"] = "Bearer " .. Config.UpstashToken }
                })
            end)

            if success and res and res.Body then
                local dataDecoded = HttpService:JSONDecode(res.Body)
                local targetJobId = dataDecoded and dataDecoded.result

                if targetJobId and targetJobId ~= true and targetJobId ~= "" then
                    if game.JobId ~= targetJobId then
                        isTeleporting = true
                        UpdateUI("🚀 Đã có Chén! Đang Auto-Join...", Color3.fromRGB(0, 255, 255))
                        
                        local tpSuccess = pcall(function()
                            TeleportService:TeleportToPlaceInstance(game.PlaceId, targetJobId, LocalPlayer)
                        end)

                        if not tpSuccess then
                            UpdateUI("⚠️ Server đầy/Lỗi Teleport! Thử lại sau 6s...", Color3.fromRGB(255, 100, 0))
                            task.wait(6)
                            isTeleporting = false
                        end
                    else
                        UpdateUI("✅ Đã vào đúng Server! Bật Script Đánh Boss!", Color3.fromRGB(0, 255, 0))
                        
                        local getBossSuccess, getBossRes = pcall(function()
                            return http_request({
                                Url = Config.UpstashURL .. "/get/TargetBoss",
                                Method = "GET",
                                Headers = { ["Authorization"] = "Bearer " .. Config.UpstashToken }
                            })
                        end)
                        
                        local targetBoss = Config.TargetBoss
                        if getBossSuccess and getBossRes and getBossRes.Body then
                            local bossData = HttpService:JSONDecode(getBossRes.Body)
                            targetBoss = bossData.result or targetBoss
                        end

                        if targetBoss == "DoughKing" then
                            loadstring(game:HttpGet(Config.Scripts.FightDough))()
                        else
                            loadstring(game:HttpGet(Config.Scripts.FightIndra))()
                        end
                        break
                    end
                else
                    UpdateUI("💤 Đang treo ngầm chờ Acc Chính...", Color3.fromRGB(180, 180, 180))
                end
            end
        end
    end)
end

