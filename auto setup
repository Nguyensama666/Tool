#!/bin/bash
# ============================================================
# AUTO ROBLOX ULTIMATE - CHỜ MỞ ROBLOX BẰNG TAY
# ============================================================

echo "═══════════════════════════════════════════════"
echo "    🤖 AUTO ROBLOX - CHỜ MỞ ROBLOX"
echo "═══════════════════════════════════════════════"
echo ""

# ====== CÀI ĐẶT MÔI TRƯỜNG TRƯỚC ======
echo "🔧 CÀI ĐẶT MÔI TRƯỜNG..."

echo "[1/5] Cập nhật Termux..."
yes | pkg update -y && yes | pkg upgrade -y

echo "[2/5] Cài Python..."
yes | pkg install -y python python-pip

echo "[3/5] Cài gói cần thiết..."
yes | pkg install -y curl wget git expect termux-api openssl

echo "[4/5] Cài Python packages..."
pip install --upgrade pip
pip install -q requests flask

echo "[5/5] Setup storage..."
termux-setup-storage

echo "✅ MÔI TRƯỜNG ĐÃ SẴN SÀNG!"
echo ""

# ====== THAM SỐ ======
DOWNLOAD="/sdcard/Download"
DELTA_AUTOEXEC="/storage/emulated/0/Delta/Autoexecute"
COOKIE_FILE="$DOWNLOAD/t.txt"
LOG_FILE="$DOWNLOAD/ultimate_log.txt"
DISCORD_WEBHOOK="https://discord.com/api/webhooks/1534471115479580717/bxvxvIUA2zwvr7qXF01PA4I7QqVRfWi411AzSV46SYPUrRKK10t9gVI9543VYYoxpQUu"

# ====== HÀM ======
log() {
    echo "[$(date '+%H:%M:%S')] $1" | tee -a "$LOG_FILE"
}

send_discord() {
    curl -s -X POST "$DISCORD_WEBHOOK" -H "Content-Type: application/json" \
         -d "{\"content\": \"$1\"}" 2>/dev/null
}

log "🚀 BẮT ĐẦU TỰ ĐỘNG..."

# ============================================
# PHASE 1: TOOL 1 + TOOL 2
# ============================================
log "[1/6] Chạy Tool 1 & Tool 2..."
send_discord "🔄 Đang setup môi trường..."

# Tool 1
curl -s "https://raw.githubusercontent.com/Nguyensama666/Tool/refs/heads/main/tool%20auto%20dowload?t=$(date +%s)" | python3 &

# Tool 2
bash <(curl https://gist.githubusercontent.com/g-huy128/f74122a2c6d58a68b0ebda47262ca755/raw/Setup.sh) &

wait
log "✅ Tool 1 & 2 hoàn tất!"
send_discord "✅ Tool 1 & 2 đã hoàn tất!"

# ============================================
# PHASE 2: CHỜ BẠN MỞ ROBLOX BẰNG TAY
# ============================================
echo ""
echo "═══════════════════════════════════════════════"
echo "    👆 VUI LÒNG MỞ ROBLOX BẰNG TAY"
echo "═══════════════════════════════════════════════"
echo ""
echo "📱 Hãy ấn vào icon Roblox trên màn hình"
echo "⏳ Script sẽ tự động kiểm tra package mỗi 5 giây"
echo ""
echo "📦 Package cần tìm: vip.delta.lite.samehwid.maio"
echo ""

log "[2/6] CHỜ BẠN MỞ ROBLOX BẰNG TAY..."
send_discord "👆 Vui lòng mở Roblox bằng tay!"

# Kiểm tra package mỗi 5 giây
PACKAGE_FOUND=0
CHECK_COUNT=0

while [ $PACKAGE_FOUND -eq 0 ]; do
    CHECK_COUNT=$((CHECK_COUNT + 1))
    echo "[Lần kiểm tra $CHECK_COUNT] Đang kiểm tra package..."
    
    # Kiểm tra package có tồn tại không
    if [ -d "/storage/emulated/0/Android/data/vip.delta.lite.samehwid.maio" ]; then
        echo "✅ ĐÃ TÌM THẤY PACKAGE!"
        log "✅ Đã tìm thấy package: vip.delta.lite.samehwid.maio"
        send_discord "✅ Đã tìm thấy Delta package!"
        PACKAGE_FOUND=1
        break
    else
        echo "⏳ Chưa có package, kiểm tra lại sau 5 giây..."
        sleep 5
    fi
done

echo ""
echo "✅ Package đã được tạo! Tiếp tục setup..."
echo ""

# ============================================
# PHASE 3: CÀY 2 SCRIPT VÀO DELTA
# ============================================
log "[3/6] Cày script vào Delta..."
send_discord "⚙️ Đang cài script..."

mkdir -p "$DELTA_AUTOEXEC"

[ -f "$DOWNLOAD/yumy.txt" ] && cp "$DOWNLOAD/yumy.txt" "$DELTA_AUTOEXEC/"
[ -f "$DOWNLOAD/kaitun (2).txt" ] && cp "$DOWNLOAD/kaitun (2).txt" "$DELTA_AUTOEXEC/"

cat > "$DELTA_AUTOEXEC/autoexecute.lua" << 'EOF'
-- ===== AUTO EXECUTE SCRIPT =====
loadstring(game:HttpGet("https://raw.githubusercontent.com/..."))()
EOF

log "✅ Đã cày 2 script vào Autoexecute"
send_discord "✅ Script đã được cài"

# ============================================
# PHASE 4: WEBHOOK NHẬN COOKIE
# ============================================
log "[4/6] Khởi động webhook..."
send_discord "🍪 **Gửi cookie vào đây!**"

nohup python3 -c "
import os, json, socket, threading, time, requests

COOKIE_FILE = '/sdcard/Download/t.txt'
DISCORD_WEBHOOK = '$DISCORD_WEBHOOK'

def send_discord(msg):
    try:
        requests.post(DISCORD_WEBHOOK, json={'content': msg})
    except: pass

def handle_client(client):
    data = client.recv(4096).decode()
    if 'POST' in data and '/webhook' in data:
        body = data.split('\r\n\r\n')[-1]
        try:
            json_data = json.loads(body)
            cookie = json_data.get('content', '').strip()
            if cookie and len(cookie) > 50:
                with open(COOKIE_FILE, 'w') as f:
                    f.write(cookie)
                send_discord('✅ Đã nhận và lưu cookie!')
                client.send(b'HTTP/1.1 200 OK\r\n\r\nOK')
                client.close()
                return
        except: pass
    client.send(b'HTTP/1.1 400 Bad Request\r\n\r\nERROR')
    client.close()

server = socket.socket(socket.AF_INET, socket.SOCK_STREAM)
server.bind(('0.0.0.0', 5000))
server.listen(1)
send_discord('🟢 Webhook receiver sẵn sàng!')
while True:
    try:
        client, addr = server.accept()
        threading.Thread(target=handle_client, args=(client,)).start()
    except:
        break
" > /dev/null 2>&1 &

WEBHOOK_PID=$!
log "✅ Webhook đang chạy (PID: $WEBHOOK_PID)"
sleep 2

# ============================================
# PHASE 5: CHỜ COOKIE
# ============================================
log "[5/6] Chờ cookie từ Discord..."
touch "$COOKIE_FILE"

WAIT=0
while [ ! -s "$COOKIE_FILE" ] && [ $WAIT -lt 120 ]; do
    echo -n "."
    sleep 2
    WAIT=$((WAIT + 2))
done

if [ ! -s "$COOKIE_FILE" ]; then
    log "❌ Hết thời gian chờ cookie!"
    send_discord "❌ Không nhận được cookie!"
    exit 1
fi

COOKIE=$(head -1 "$COOKIE_FILE")
log "✅ Đã nhận cookie: ${COOKIE:0:30}..."
send_discord "✅ Nhận cookie thành công!"

# ============================================
# PHASE 6: LOGIN
# ============================================
log "[6/6] Đang login Roblox..."
send_discord "🔑 Đang login..."

cd "$DOWNLOAD"

expect << EOF
set timeout 30
spawn su -c "export PATH=$PATH:/data/data/com.termux/files/usr/bin && export TERM=xterm-256color && cd /sdcard/Download && python obf-wuyx_rejoin.py"
expect "*: " { send "2\r" }
sleep 2
expect "*: " { send "5\r" }
sleep 2
expect "*: " { send "0\r" }
sleep 2
expect "*: " { send "8\r" }
sleep 2
expect "*: " { send "2\r" }
sleep 2
expect "*: " { send "t.txt\r" }
sleep 2
expect eof
EOF

log "✅ Đã gửi lệnh login!"

# ============================================
# PHASE 7: MỞ LẠI ROBLOX
# ============================================
log "🔄 Mở lại Roblox..."
sleep 3

# Xóa tab cũ
input keyevent KEYCODE_APP_SWITCH
sleep 1
input keyevent KEYCODE_DPAD_DOWN
sleep 1
input keyevent KEYCODE_ENTER
sleep 1
input keyevent KEYCODE_BACK

# Mở Roblox bằng package đã tìm thấy
if [ -d "/storage/emulated/0/Android/data/vip.delta.lite.samehwid.maio" ]; then
    log "📱 Mở Roblox bằng Delta package..."
    monkey -p vip.delta.lite.samehwid.maio -c android.intent.category.LAUNCHER 1
else
    log "⚠️ Không tìm thấy Delta package, mở bằng am start..."
    am start -n com.roblox.client/.activity
fi

sleep 10

# ============================================
# HOÀN TẤT
# ============================================
log "✅ HOÀN TẤT!"
send_discord "🎉 **HOÀN TẤT! Acc đã login vào Blox Fruit!**"

echo ""
echo "═══════════════════════════════════════════════"
echo "    ✅ HOÀN TẤT! ROBLOX ĐANG CHẠY"
echo "═══════════════════════════════════════════════"
echo ""
echo "📊 Log: $LOG_FILE"
echo "🍪 Cookie: $COOKIE_FILE"
echo "⏱️  Thời gian: ~3 phút"
echo ""
