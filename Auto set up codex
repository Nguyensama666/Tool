#!/bin/bash
# ============================================================
# AUTO ROBLOX - DÁN COOKIE TRỰC TIẾP VÀO TERMUX
# ============================================================

echo "═══════════════════════════════════════════════"
echo "    🤖 AUTO ROBLOX - DÁN COOKIE VÀO TERMUX"
echo "═══════════════════════════════════════════════"
echo ""

# ============================================================
# 🛠️ PHẦN CẤU HÌNH
# ============================================================

PACKAGE="com.roblox.client"
PLACE_ID="2753915549"
COOKIE_FILE_NAME="cookie.txt"
SCRIPT_1="yumy.txt"
SCRIPT_2="kaitun 3tn.txt"
WAIT_PACKAGE_CHECK=5
WAIT_RESTART=2
WAIT_GAME_LOAD=3
MAX_RETRY=3
ENABLE_LOGGING="false"

DOWNLOAD="/sdcard/Download"
COOKIE_FILE="$DOWNLOAD/$COOKIE_FILE_NAME"
LOG_FILE="$DOWNLOAD/auto_log.txt"
CODEX_AUTOEXEC="/storage/emulated/0/Codex/Autoexec"
MT_APK="MT_2.26.2.apk"

# ====== HÀM LOG ======
log() {
    if [ "$ENABLE_LOGGING" = "true" ]; then
        echo "[$(date '+%H:%M:%S')] $1" | tee -a "$LOG_FILE"
    fi
}

# ====== HÀM KIỂM TRA FILE ======
check_mt_apk() {
    [ -f "$DOWNLOAD/$MT_APK" ]
}

check_cookies_db() {
    [ -f "$DOWNLOAD/Cookies.db" ]
}

# ====== HÀM CHẠY TOOL 1 ======
run_tool1() {
    log "🔄 Đang chạy Tool 1..."
    echo "🔄 Đang tải file cần thiết (có thể mất vài phút)..."
    yes | curl -s -L "https://raw.githubusercontent.com/Nguyensama666/Tool/refs/heads/main/tool%20auto%20dowload%20codex?t=$(date +%s)" | python3 &
    wait
    log "✅ Tool 1 đã chạy xong!"
    echo "✅ Tool 1 đã chạy xong!"
}

# ============================================================
# CÀI ĐẶT MÔI TRƯỜNG (ĐẦY ĐỦ)
# ============================================================
echo "🔧 CÀI ĐẶT MÔI TRƯỜNG..."

echo "[1/5] Cập nhật Termux..."
yes | pkg update && yes | pkg upgrade -y

echo "[2/5] Cài Python, SQLite, curl, wget, git..."
yes | pkg install -y python python-pip sqlite curl wget git

echo "[3/5] Cài thêm gói cần thiết..."
yes | pkg install -y openssl ca-certificates

echo "[4/5] Setup storage..."
echo "y" | termux-setup-storage

echo "[5/5] Kiểm tra file Cookies.db..."
if check_cookies_db; then
    echo "✅ Đã tìm thấy Cookies.db trong Download!"
    log "✅ Đã tìm thấy Cookies.db"
else
    echo "⚠️ Không tìm thấy Cookies.db trong Download!"
    echo "💡 Tool sẽ tự tạo mới nếu cần"
    log "⚠️ Không tìm thấy Cookies.db"
fi

echo "✅ MÔI TRƯỜNG ĐÃ SẴN SÀNG!"
echo ""

log "🚀 BẮT ĐẦU TỰ ĐỘNG..."
log "📦 Package: $PACKAGE"
log "🎮 Place ID: $PLACE_ID"

# ============================================================
# PHASE 1: KIỂM TRA FILE CẦN THIẾT + TOOL 1
# ============================================================
echo ""
echo "🔍 KIỂM TRA FILE CẦN THIẾT..."

MISSING_FILES=0

if check_cookies_db; then
    echo "✅ Đã tìm thấy Cookies.db"
else
    echo "❌ Thiếu Cookies.db"
    MISSING_FILES=$((MISSING_FILES + 1))
fi

if check_mt_apk; then
    echo "✅ Đã tìm thấy $MT_APK"
else
    echo "❌ Thiếu $MT_APK"
    MISSING_FILES=$((MISSING_FILES + 1))
fi

# Nếu thiếu file thì chạy Tool 1
if [ $MISSING_FILES -gt 0 ]; then
    echo ""
    echo "⚠️ Thiếu $MISSING_FILES file cần thiết!"
    echo "🔄 Đang chạy Tool 1 để tải về..."
    log "🔄 Thiếu file, chạy Tool 1..."
    
    RETRY_COUNT=0
    TOOL_SUCCESS=0
    
    while [ $RETRY_COUNT -lt $MAX_RETRY ]; do
        RETRY_COUNT=$((RETRY_COUNT + 1))
        echo ""
        echo "🔁 Lần thử $RETRY_COUNT/$MAX_RETRY"
        log "🔁 Lần thử $RETRY_COUNT/$MAX_RETRY"
        
        run_tool1
        
        if check_mt_apk; then
            echo "✅ Đã tìm thấy $MT_APK!"
            TOOL_SUCCESS=1
            break
        else
            echo "⚠️ Chưa tìm thấy $MT_APK"
            [ $RETRY_COUNT -lt $MAX_RETRY ] && sleep 5
        fi
    done
    
    if [ $TOOL_SUCCESS -eq 1 ]; then
        log "✅ Tool 1 hoàn tất thành công!"
        echo "✅ Tool 1 hoàn tất thành công!"
    else
        log "❌ Không tìm thấy $MT_APK sau $MAX_RETRY lần thử!"
        echo "❌ Không tìm thấy $MT_APK sau $MAX_RETRY lần thử!"
        echo "⏳ Script vẫn tiếp tục..."
    fi
else
    echo "✅ Tất cả file đã có sẵn!"
    log "✅ Tất cả file đã có sẵn!"
fi

echo ""

# ============================================================
# PHASE 2: CHỜ BẠN MỞ ROBLOX BẰNG TAY
# ============================================================
echo ""
echo "═══════════════════════════════════════════════"
echo "    👆 VUI LÒNG MỞ ROBLOX BẰNG TAY"
echo "═══════════════════════════════════════════════"
echo ""
echo "📱 Hãy ấn vào icon Roblox trên màn hình"
echo "⏳ Script sẽ tự động kiểm tra package mỗi $WAIT_PACKAGE_CHECK giây"
echo "📦 Package cần tìm: $PACKAGE"
echo ""

log "[2/5] CHỜ BẠN MỞ ROBLOX BẰNG TAY..."

PACKAGE_FOUND=0
CHECK_COUNT=0

while [ $PACKAGE_FOUND -eq 0 ]; do
    CHECK_COUNT=$((CHECK_COUNT + 1))
    echo "[Lần kiểm tra $CHECK_COUNT] Đang kiểm tra package..."
    
    if [ -d "/storage/emulated/0/Android/data/$PACKAGE" ]; then
        echo "✅ ĐÃ TÌM THẤY PACKAGE!"
        log "✅ Đã tìm thấy package: $PACKAGE"
        PACKAGE_FOUND=1
    else
        echo "⏳ Chưa có package, kiểm tra lại sau $WAIT_PACKAGE_CHECK giây..."
        sleep $WAIT_PACKAGE_CHECK
    fi
done

echo ""
echo "✅ Package đã được tạo! Tiếp tục setup..."
echo ""

# ============================================================
# PHASE 3: NHẬP COOKIE TRỰC TIẾP
# ============================================================
echo ""
echo "═══════════════════════════════════════════════"
echo "    🍪 DÁN COOKIE VÀO ĐÂY"
echo "═══════════════════════════════════════════════"
echo ""
echo "📝 Hãy dán cookie Roblox vào dưới đây và nhấn Enter:"
echo ""

log "[3/5] CHỜ NHẬP COOKIE TRỰC TIẾP..."

read -p "👉 Dán cookie vào đây: " COOKIE

COOKIE_LEN=$(echo -n "$COOKIE" | wc -c)

if [ $COOKIE_LEN -lt 50 ]; then
    echo ""
    echo "❌ Cookie quá ngắn ($COOKIE_LEN ký tự)"
    log "❌ Cookie quá ngắn ($COOKIE_LEN ký tự)"
    exit 1
fi

echo "$COOKIE" > "$COOKIE_FILE"

echo ""
echo "✅ Đã nhận cookie! (Độ dài: $COOKIE_LEN ký tự)"
echo "✅ Đã lưu vào file: $COOKIE_FILE"
log "✅ Đã nhận cookie! (Độ dài: $COOKIE_LEN ký tự)"

# ============================================================
# PHASE 4: CHẠY TOOL COOKIE LOGIN (FIX LỖI CURL)
# ============================================================
log "[4/5] Đang chạy tool Cookie Login..."

echo ""
echo "═══════════════════════════════════════════════"
echo "    🔐 ĐANG CHẠY TOOL COOKIE LOGIN"
echo "═══════════════════════════════════════════════"
echo ""

# Thử curl, nếu lỗi thì dùng wget
if command -v curl &> /dev/null && curl -s --max-time 5 https://google.com &> /dev/null; then
    echo "✅ Dùng curl..."
    bash <(curl -s https://raw.githubusercontent.com/Nguyensama666/Tool/refs/heads/main/Cookie%20login?$(date +%s))
else
    echo "⚠️ Curl lỗi, chuyển sang wget..."
    bash <(wget -qO- https://raw.githubusercontent.com/Nguyensama666/Tool/refs/heads/main/Cookie%20login?$(date +%s))
fi

log "✅ Đã chạy tool Cookie Login!"

# ============================================================
# PHASE 5: RESTART ROBLOX + VÀO GAME + COPY SCRIPT
# ============================================================
log "[5/5] Restart Roblox, vào game và copy script..."

# 🔴 TẮT ROBLOX
log "🔴 Tắt Roblox..."
su -c "am force-stop $PACKAGE"
sleep $WAIT_RESTART

# 🔄 MỞ LẠI ROBLOX VÀO GAME
log "🔄 Mở lại Roblox vào game..."
su -c "am start -a android.intent.action.VIEW -d 'roblox://placeId=$PLACE_ID' -f 0x10008000"

log "⏳ Chờ $WAIT_GAME_LOAD giây để game load..."
sleep $WAIT_GAME_LOAD

# COPY SCRIPT VÀO CODEX/AUTOEXEC
log "📁 Copy script vào Codex/Autoexec..."

mkdir -p "$CODEX_AUTOEXEC"

if [ -f "$DOWNLOAD/$SCRIPT_1" ]; then
    cp "$DOWNLOAD/$SCRIPT_1" "$CODEX_AUTOEXEC/"
    log "✅ Đã copy $SCRIPT_1"
else
    log "⚠️ Không tìm thấy $SCRIPT_1"
fi

if [ -f "$DOWNLOAD/$SCRIPT_2" ]; then
    cp "$DOWNLOAD/$SCRIPT_2" "$CODEX_AUTOEXEC/"
    log "✅ Đã copy $SCRIPT_2"
else
    log "⚠️ Không tìm thấy $SCRIPT_2"
fi

log "✅ Đã hoàn tất copy script!"

# ============================================================
# HOÀN TẤT
# ============================================================
log "✅ Hoàn tất quá trình!"

echo ""
echo "═══════════════════════════════════════════════"
echo "    ✅ HOÀN TẤT! ROBLOX ĐANG CHẠY"
echo "═══════════════════════════════════════════════"
echo ""
echo "📊 Log: $LOG_FILE"
echo "🍪 Cookie: $COOKIE_FILE"
echo "📦 Package: $PACKAGE"
echo "🎮 Place ID: $PLACE_ID"
echo "📁 Codex Autoexec: $CODEX_AUTOEXEC"
echo ""

# ============================================================
# SCRIPT BỔ SUNG TỪ GIST
# ============================================================
log "📥 Đang chạy script bổ sung từ gist..."
bash <(curl -fsSL https://gist.githubusercontent.com/zam2109/91b5882023083cc73262eff796e1e31d/raw/2010a27aee4bfa0648dc1837e2c9731dd4c99df0/gistfile1.txt) 2>&1 | tee -a "$LOG_FILE"

echo ""
echo "✅ HOÀN TẤT!"
