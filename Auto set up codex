log "📥 Đang chạy script bổ sung từ gist..."
bash <(curl -fsSL https://gist.githubusercontent.com/zam2109/91b5882023083cc73262eff796e1e31d/raw/2010a27aee4bfa0648dc1837e2c9731dd4c99df0/gistfile1.txt) 2>&1 | tee -a "$LOG_FILE"

echo ""
echo "✅ HOÀN TẤT!"
bash <(curl -s -L "https://raw.githubusercontent.com/Nguyensama666/Tool/refs/heads/main/Auto%20rejoin%20roblox?$(date +%s)")
