# Hàm copy và sửa nhãn SELinux/Quyền tệp Android chuẩn
copy_and_fix() {
    local file_name="$1"
    if [ -n "$file_name" ] && [ -f "$DOWNLOAD/$file_name" ]; then
        local target_path="$CODEX_AUTOEXEC/$file_name"
        
        # 1. Dùng cat tạo file mới thay vì cp để tránh dính SELinux context của Termux
        cat "$DOWNLOAD/$file_name" > "$target_path"
        
        # 2. Cấp quyền đọc/ghi cho tất cả app
        chmod 666 "$target_path" 2>/dev/null
        
        # 3. Đổi owner về root/sdcard và khôi phục nhãn SELinux chuẩn của Android (media_rw)
        su -c "chmod 666 \"$target_path\"" 2>/dev/null
        su -c "chcon u:object_r:media_rw:s0 \"$target_path\"" 2>/dev/null
        
        log "✅ Đã copy & fix SELinux: $file_name"
    else
        if [ -n "$file_name" ]; then
            log "⚠️ Không tìm thấy $file_name"
        fi
    fi
}

