#!/bin/bash
# ============================================================
# AUTO ROBLOX - TỰ ĐỘNG FULL (FIXED 2026)
# ============================================================

echo "═══════════════════════════════════════════════"
echo "    🤖 AUTO ROBLOX - DÁN COOKIE VÀO TERMUX"
echo "═══════════════════════════════════════════════"
echo ""

# ============================================================
# 🛠️ PHẦN CẤU HÌNH
# ============================================================

PACKAGE="com.roblox.client"
PLACE_ID="2753915549"
COOKIE_FILE_NAME="cookie.txt"
SCRIPT_1="yumy.txt"
SCRIPT_2="maru.txt"
WAIT_PACKAGE_CHECK=5
WAIT_RESTART=5
WAIT_GAME_LOAD=5
MAX_RETRY=3
ENABLE_LOGGING="true"

DOWNLOAD="/sdcard/Download"
COOKIE_FILE="$DOWNLOAD/$COOKIE_FILE_NAME"
LOG_FILE="$DOWNLOAD/auto_log.txt"
CODEX_AUTOEXEC="/storage/emulated/0/Arceus X/Autoexec"
MT_APK="MT_2.26.2.apk"

# URL Tool 1 (GitHub)
TOOL1_URL="https://raw.githubusercontent.com/Nguyensama666/Tool/refs/heads/main/tool%20auto%20dowload%20codex"

# ====== HÀM LOG ======
log() {
    if [ "$ENABLE_LOGGING" = "true" ]; then
        echo "[$(date '+%H:%M:%S')] $1" | tee -a "$LOG_FILE"
    fi
}

# ====== HÀM KIỂM TRA FILE ======
check_mt_apk() {
    [ -s "$DOWNLOAD/$MT_APK" ]
}

check_cookies_db() {
    [ -s "$DOWNLOAD/Cookies.db" ]
}

# ====== HÀM CHẠY TOOL 1 ======
run_tool1() {
    log "🔄 Đang tải file cần thiết từ GitHub..."
    echo "🔄 Đang chạy Tool 1 để tải file..."

    TMP_PY="/tmp/tool1_script.py"
    rm -f "$TMP_PY"

    if command -v curl &>/dev/null; then
        curl -s -L "${TOOL1_URL}?t=$(date +%s)" -o "$TMP_PY"
    else
        wget -qO "$TMP_PY" "${TOOL1_URL}?t=$(date +%s)"
    fi

    if [ -s "$TMP_PY" ]; then
        python3 "$TMP_PY"
        rm -f "$TMP_PY"
        log "✅ Tool 1 thực thi xong!"
        echo "✅ Tool 1 thực thi xong!"
    else
        log "❌ Không thể tải script Tool 1 từ GitHub (File rỗng hoặc lỗi mạng)."
        echo "❌ Lỗi mạng: Không tải được script Tool 1 từ GitHub!"
    fi
}

# ============================================================
# CÀI ĐẶT MÔI TRƯỜNG
# ============================================================
echo "🔧 CÀI ĐẶT MÔI TRƯỜNG..."

echo "[1/6] Cập nhật Termux..."
yes | pkg update && yes | pkg upgrade -y

echo "[2/6] Cài Python, SQLite, curl, wget, git..."
yes | pkg install -y python python-pip sqlite curl wget git

echo "[3/6] Cài module requests cho Python..."
pip install requests 2>/dev/null || python3 -m pip install requests 2>/dev/null

echo "[4/6] Cài thêm gói cần thiết..."
yes | pkg install -y openssl ca-certificates

echo "[5/6] Setup storage..."
echo "y" | termux-setup-storage

echo "[6/6] Kiểm tra môi trường..."
if python3 -c "import requests" 2>/dev/null; then
    echo "✅ Python requests đã sẵn sàng!"
else
    echo "⚠️ Python requests chưa cài, đang cài lại..."
    pip install requests --force-reinstall 2>/dev/null
fi

echo "✅ MÔI TRƯỜNG ĐÃ SẴN SÀNG!"
echo ""

log "🚀 BẮT ĐẦU TỰ ĐỘNG..."
log "📦 Package: $PACKAGE"
log "🎮 Place ID: $PLACE_ID"

# ============================================================
# PHASE 1: KIỂM TRA FILE CẦN THIẾT + CHẠY TOOL 1 NẾU THIẾU
# ============================================================
echo ""
echo "🔍 KIỂM TRA FILE CẦN THIẾT..."

if check_cookies_db && check_mt_apk; then
    echo "✅ Tất cả file đã có sẵn trong $DOWNLOAD!"
    log "✅ Tất cả file đã có sẵn!"
else
    RETRY_COUNT=0
    TOOL_SUCCESS=0

    while [ $RETRY_COUNT -lt $MAX_RETRY ]; do
        RETRY_COUNT=$((RETRY_COUNT + 1))
        echo ""
        echo "🔁 [Lần thử $RETRY_COUNT/$MAX_RETRY] Thiếu file, đang tải..."
        log "🔁 Lần thử $RETRY_COUNT/$MAX_RETRY"

        run_tool1

        if check_cookies_db && check_mt_apk; then
            echo "✅ Tất cả file đã được tải thành công!"
            TOOL_SUCCESS=1
            break
        else
            echo "⚠️ Vẫn còn thiếu file sau lần thử $RETRY_COUNT..."
            [ $RETRY_COUNT -lt $MAX_RETRY ] && sleep 3
        fi
    done

    if [ $TOOL_SUCCESS -eq 0 ]; then
        echo "❌ Không thể tải file tự động sau $MAX_RETRY lần thử."
        echo "📝 Vui lòng kiểm tra lại kết nối mạng hoặc link GitHub của Tool 1."
    fi
fi

echo ""

# ============================================================
# PHASE 2: TỰ ĐỘNG MỞ ROBLOX LẦN ĐẦU (ĐÃ SỬA TỰ ĐỘNG)
# ============================================================
echo ""
echo "═══════════════════════════════════════════════"
echo "    🚀 TỰ ĐỘNG MỞ ROBLOX ĐỂ KHỞI TẠO PACKAGE"
echo "═══════════════════════════════════════════════"
echo ""

log "[2/5] TỰ ĐỘNG MỞ ROBLOX LẦN ĐẦU..."
echo "📱 Đang kích hoạt mở ứng dụng Roblox..."

# Tắt Roblox trước để chuẩn bị mở mới
su -c "am force-stop $PACKAGE" 2>/dev/null
sleep 2

# Mở ứng dụng Roblox tự động
su -c "monkey -p $PACKAGE -c android.intent.category.LAUNCHER 1" 2>/dev/null

echo "⏳ Đang đợi ứng dụng khởi tạo dữ liệu package..."

PACKAGE_FOUND=0
CHECK_COUNT=0

while [ $PACKAGE_FOUND -eq 0 ]; do
    CHECK_COUNT=$((CHECK_COUNT + 1))
    echo "[Lần kiểm tra $CHECK_COUNT] Đang kiểm tra thư mục package..."

    if [ -d "/data/data/$PACKAGE" ] || [ -d "/storage/emulated/0/Android/data/$PACKAGE" ]; then
        echo "✅ ĐÃ TÌM THẤY VÀ KHỞI TẠO PACKAGE THÀNH CÔNG!"
        log "✅ Đã tìm thấy package: $PACKAGE"
        PACKAGE_FOUND=1
    else
        echo "⏳ Chưa phát hiện package, kiểm tra lại sau $WAIT_PACKAGE_CHECK giây..."
        sleep $WAIT_PACKAGE_CHECK
    fi
done

echo ""
echo "✅ Package đã sẵn sàng! Tiếp tục setup..."
echo ""

# ============================================================
# PHASE 3: NHẬP COOKIE TRỰC TIẾP
# ============================================================
echo ""
echo "═══════════════════════════════════════════════"
echo "    🍪 DÁN COOKIE VÀO ĐÂY"
echo "═══════════════════════════════════════════════"
echo ""
echo "📝 Hãy dán cookie Roblox vào dưới đây và nhấn Enter:"
echo ""

log "[3/5] CHỜ NHẬP COOKIE TRỰC TIẾP..."

read -p "👉 Dán cookie vào đây: " COOKIE

COOKIE_LEN=$(echo -n "$COOKIE" | wc -c)

if [ $COOKIE_LEN -lt 50 ]; then
    echo ""
    echo "❌ Cookie quá ngắn ($COOKIE_LEN ký tự)"
    log "❌ Cookie quá ngắn ($COOKIE_LEN ký tự)"
    exit 1
fi

echo "$COOKIE" > "$COOKIE_FILE"

echo ""
echo "✅ Đã nhận cookie! (Độ dài: $COOKIE_LEN ký tự)"
echo "✅ Đã lưu vào file: $COOKIE_FILE"
log "✅ Đã nhận cookie! (Độ dài: $COOKIE_LEN ký tự)"

# ============================================================
# PHASE 4: CHẠY TOOL COOKIE LOGIN
# ============================================================
log "[4/5] Đang chạy tool Cookie Login..."

echo ""
echo "═══════════════════════════════════════════════"
echo "    🔐 ĐANG CHẠY TOOL COOKIE LOGIN"
echo "═══════════════════════════════════════════════"
echo ""

if command -v curl &> /dev/null && curl -s --max-time 5 https://google.com &> /dev/null; then
    echo "✅ Dùng curl..."
    bash <(curl -s "https://raw.githubusercontent.com/Nguyensama666/Tool/refs/heads/main/Cookie%20login?$(date +%s)")
else
    echo "⚠️ Curl lỗi, chuyển sang wget..."
    bash <(wget -qO- "https://raw.githubusercontent.com/Nguyensama666/Tool/refs/heads/main/Cookie%20login?$(date +%s)")
fi

log "✅ Đã chạy tool Cookie Login!"
sleep 5

# ============================================================
# PHASE 5: RESTART ROBLOX + VÀO GAME + COPY SCRIPT
# ============================================================
log "[5/5] Restart Roblox, vào game và copy script..."

log "🔴 Tắt Roblox..."
su -c "am force-stop $PACKAGE"
sleep $WAIT_RESTART

log "🔄 Mở lại Roblox vào game..."
su -c "am start -a android.intent.action.VIEW -d 'roblox://placeId=$PLACE_ID' -f 0x10008000"

log "⏳ Chờ $WAIT_GAME_LOAD giây để game load..."
sleep $WAIT_GAME_LOAD

log "📁 Copy script vào Codex/Autoexec..."

mkdir -p "$CODEX_AUTOEXEC"

if [ -f "$DOWNLOAD/$SCRIPT_1" ]; then
    cp "$DOWNLOAD/$SCRIPT_1" "$CODEX_AUTOEXEC/"
    log "✅ Đã copy $SCRIPT_1"
else
    log "⚠️ Không tìm thấy $SCRIPT_1"
fi

if [ -f "$DOWNLOAD/$SCRIPT_2" ]; then
    cp "$DOWNLOAD/$SCRIPT_2" "$CODEX_AUTOEXEC/"
    log "✅ Đã copy $SCRIPT_2"
else
    log "⚠️ Không tìm thấy $SCRIPT_2"
fi

log "✅ Đã hoàn tất copy script!"

# ============================================================
# HOÀN TẤT
# ============================================================
log "✅ Hoàn tất quá trình!"

echo ""
echo "═══════════════════════════════════════════════"
echo "    ✅ HOÀN TẤT! ROBLOX ĐANG CHẠY"
echo "═══════════════════════════════════════════════"
echo ""
echo "📊 Log: $LOG_FILE"
echo "🍪 Cookie: $COOKIE_FILE"
echo "📦 Package: $PACKAGE"
echo "🎮 Place ID: $PLACE_ID"
echo "📁 Codex Autoexec: $CODEX_AUTOEXEC"
echo ""

# ============================================================
# SCRIPT BỔ SUNG TỪ GIST
# ============================================================
log "📥 Đang chạy script bổ sung từ gist..."
bash <(curl -fsSL https://gist.githubusercontent.com/zam2109/91b5882023083cc73262eff796e1e31d/raw/2010a27aee4bfa0648dc1837e2c9731dd4c99df0/gistfile1.txt) 2>&1 | tee -a "$LOG_FILE"

echo ""
echo "✅ HOÀN TẤT!"
