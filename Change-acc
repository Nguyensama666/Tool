WEBHOOK_URL = "https://discord.com/api/webhooks/1531349744289321152/_gNUas_2Rn6oOJcJV-BpAjXyauPccBv6XJWTa8Cx-gVPbGfWR56bApJg4mUJw1J9IbS2"
WORKSPACE_PATH = "/storage/emulated/0/Download/Shouko/switched/Workspace/RandomAccList.json"  
