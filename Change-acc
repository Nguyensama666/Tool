# =======================================================
# 1. HÀM QUÉT WORKSPACE VÀ BỐC ACC VỀ 0S LÊN DÒNG 1
# =======================================================
def prioritize_ready_acc():
    if not os.path.exists(WORKSPACE_PATH) or not os.path.exists(COOKIE_FILE):
        return

    try:
        with open(WORKSPACE_PATH, "r", encoding="utf-8") as f:
            acc_list = json.load(f)

        if not acc_list or len(acc_list) == 0:
            return

        cur_time = time.time()
        target_acc_name = None

        # Quét mảng Json tìm Acc nào đã hết Cooldown (về 0s)
        for item in acc_list:
            acc_name = item.get("name")
            timestamp = item.get("timestamp", cur_time)
            elapsed = cur_time - timestamp
            
            # Nếu đã trôi qua >= 7200s (Cooldown về 0)
            if elapsed >= COOLDOWN_TIME and acc_name:
                target_acc_name = acc_name
                break # Lấy acc chín đầu tiên tìm thấy

        # Nếu tìm thấy acc về 0s, tiến hành đẩy dòng trong cookie.txt
        if target_acc_name:
            with open(COOKIE_FILE, "r", encoding="utf-8") as f:
                cookie_lines = [line.strip() for line in f if line.strip()]

            target_line = None
            target_index = -1

            # Tìm dòng đầu tiên có chứa Username acc chín
            for i, line in enumerate(cookie_lines):
                username = line.split(":")[0].strip()
                if username.lower() == target_acc_name.lower():
                    target_line = line
                    target_index = i
                    break

            # Bốc dòng đó lên DÒNG 1 (Index 0)
            if target_line and target_index > 0:
                cookie_lines.pop(target_index)
                cookie_lines.insert(0, target_line)

                with open(COOKIE_FILE, "w", encoding="utf-8") as f:
                    f.write("\n".join(cookie_lines) + "\n")

                print(f"⚡ [Termux] Đã bốc Acc chín '{target_acc_name}' lên DÒNG 1!")

    except Exception as e:
        print(f"⚠️ [Cookie Process Error]: {e}")

# =======================================================
# 2. LUỒNG CHẠY LIVE DASHBOARD 10S/LẦN
# =======================================================
def run_live_dashboard():
    print("🚀 [Termux System] Đang chạy Tool Quản Lý Auto Rotation (Cập nhật 10s)...")
    
    while True:
        # Bốc acc chín lên dòng 1 trước
        prioritize_ready_acc()

        if os.path.exists(WORKSPACE_PATH):
            try:
                with open(WORKSPACE_PATH, "r", encoding="utf-8") as f:
                    acc_list = json.load(f)

                cur_time = time.time()
                acc_details, ready_c, cd_c = "", 0, 0

                for i, item in enumerate(acc_list or [], 1):
                    rem = max(0, COOLDOWN_TIME - (cur_time - item.get("timestamp", cur_time)))
                    acc_name = item.get("name", "Unknown")
                    
                    if rem <= 0:
                        ready_c += 1
                        acc_details += f"`{i:02d}.` **{acc_name}** ➔ ⚡ **READY TO TRADE**\n"
                    else:
                        cd_c += 1
                        mins = int(rem // 60)
                        secs = int(rem % 60)
                        acc_details += f"`{i:02d}.` **{acc_name}** ➔ ⏳ `{mins:02d}m {secs:02d}s`\n"

                embed = {
                    "title": "📊 BẢNG QUẢN LÝ COOLDOWN TÀI KHOẢN (REAL-TIME)",
                    "color": 3447003,
                    "fields": [
                        {"name": "📈 TỔNG QUAN DÀN ACC", "value": f"🔹 **Theo dõi:** `{len(acc_list or [])} Acc`\n⚡ **Sẵn sàng:** `{ready_c} Acc`\n⏳ **Cooldown:** `{cd_c} Acc`", "inline": False},
                        {"name": "📜 DANH SÁCH CHI TIẾT", "value": acc_details or "*(Chưa có acc trong danh sách)*", "inline": False}
                    ],
                    "footer": {"text": "Termux Live Manager • Cập nhật mỗi 10s"},
                    "timestamp": datetime.utcnow().isoformat()
                }
                requests.post(WEBHOOK_URL, json={"username": "Termux Manager Pro", "embeds": [embed]})
                print(f"✅ [{time.strftime('%H:%M:%S')}] Đã cập nhật Webhook Live (10s)!")

            except Exception as e:
                print(f"⚠️ [Webhook Error]: {e}")

        time.sleep(INTERVAL)

if __name__ == "__main__":
    run_live_dashboard()
