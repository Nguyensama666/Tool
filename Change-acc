WORKSPACE_PATH = "/storage/emulated/0/Delta/Workspace/RandomAccList.json"  
COOKIE_FILE = "/storage/emulated/0/Download/Shouko/switched/cookie.txt"
COOLDOWN_TIME = 7200
INTERVAL = 10  # Cập nhật mỗi 10 giây

def prioritize_ready_acc():
    if not (os.path.exists(WORKSPACE_PATH) and os.path.exists(COOKIE_FILE)): 
        return
    try:
        with open(WORKSPACE_PATH, "r", encoding="utf-8") as f: 
            acc_list = json.load(f)
        if not acc_list: 
            return
            
        cur_time = time.time()
        target_acc_name = next((i.get("name") for i in acc_list if (cur_time - i.get("timestamp", cur_time)) >= COOLDOWN_TIME and i.get("name")), None)
        
        if target_acc_name:
            with open(COOKIE_FILE, "r", encoding="utf-8") as f: 
                lines = [l.strip() for l in f if l.strip()]
            for i, line in enumerate(lines):
                if line.split(":")[0].strip().lower() == target_acc_name.lower():
                    if i > 0:
                        lines.insert(0, lines.pop(i))
                        with open(COOKIE_FILE, "w", encoding="utf-8") as f: 
                            f.write("\n".join(lines) + "\n")
                        print(f"⚡ [Termux] Đã đẩy '{target_acc_name}' lên Dòng 1!")
                    break
    except Exception as e:
        print(f"⚠️ Lỗi xử lý Cookie: {e}")

